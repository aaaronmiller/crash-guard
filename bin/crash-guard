#!/usr/bin/env python3
# ---
# date: 2026-06-13 00:00:00 PT
# ver: 2.1.0
# author: Ice-ninja
# model: Claude Opus 4.8
# tags: [wsl2, session-recovery, terminal, agentic-cli, crash-recovery, python]
# ---
# crash-guard: restore agentic CLI/TUI sessions after a WSL2 crash.
#
# Architecture (filesystem-as-state, no daemon):
#   * No daemon, no socket, no mutable manifest. State is a directory of
#     one-file-per-live-session "sentinels" (filesystem = state store).
#   * A session is "live" while its sentinel file exists. The shell launcher
#     (cg_run) creates it before running the tool and removes it after the
#     tool exits. A crash kills the shell before the remove runs.
#   * Crash detection uses a boot epoch: each sentinel records the kernel
#     boot_id at launch. After a restart the current boot_id differs, so any
#     sentinel whose boot_id != current boot_id is a crashed session. PID
#     liveness is only ever compared within the same boot (no PID-recycle bug).
#   * Restore is CWD-first (Tier 1: continue-in-directory) and only uses a
#     session id (Tier 2) when several instances of the same tool ran in the
#     same directory. Session ids are resolved at restore time from the tool's
#     own on-disk store, not raced at launch time.
#   * Restore verifies (and optionally repairs) the target session artifact
#     before resuming, because a crash can leave it truncated or null-padded.
#   * Restore spawns each session through the detected terminal backend:
#     tmux windows, WezTerm/kitty/Windows Terminal tabs, or Ghostty windows.
#
# Pure standard library. No third-party packages.

import argparse
import datetime as dt
import fnmatch
import json
import os
import shlex
import shutil
import subprocess
import sys
import termios
import time
import tty
from pathlib import Path

HOME = Path.home()
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", str(HOME / ".config")))
XDG_DATA = Path(os.environ.get("XDG_DATA_HOME", str(HOME / ".local/share")))
CFG_DIR = XDG_CONFIG / "crash-guard"
CFG_FILE = CFG_DIR / "programs.json"
DATA_DIR = XDG_DATA / "crash-guard"
LIVE_DIR = DATA_DIR / "live"
ARCH_DIR = DATA_DIR / "archive"
HISTORY_FILE = DATA_DIR / "history.jsonl"
EXCISE_PHRASE = "Jettison the ghosts"

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

# Named color styles
_COLOR_NAMES = {
    # semantic
    "ok": "32",         # green
    "warn": "33",       # yellow
    "fail": "31",       # red
    "info": "36",       # cyan
    "highlight": "35",  # magenta
    "muted": "2;37",    # dim white
    # direct
    "green": "32",
    "yellow": "33",
    "red": "31",
    "cyan": "36",
    "magenta": "35",
    "white": "37",
    "bold": "1",
    "dim": "2",
    "underline": "4",
}


def color(code, text):
    if not USE_COLOR:
        return text
    resolved = _COLOR_NAMES.get(code, code)
    return "\033[%sm%s\033[0m" % (resolved, text)


def colorize(status, text):
    """Convenience: apply a semantic color in one call."""
    return color(status, text)


def title():
    art = [
        "  _____ _____ _____ _____     _____ _____ _____ _____ ",
        " |  _  |  _  |  _  |  _  |   |  _  |  _  |  _  |  _  |",
        " | |_| | |_| | |_| | |_| |   | |_| | |_| | |_| | |_| |",
        " |_____|_____|_____|_____|   |_____|_____|_____|_____|",
        "|_____|_____|_____|_____|   |_____|_____|_____|_____|",
    ]
    print(color("1;36", "\n".join(art)))
    print(color("2;37", "terminal recovery ledger\n"))

# SECURITY: the sentinel is plaintext on disk and its env is replayed via
# `export` in the restore payload (visible in `ps`). So we capture ONLY the
# non-secret proxy-routing delta the launcher injected, never ambient secrets.
# Real global keys are restored automatically because the restore shell
# re-sources ~/.zshrc (`zsh -lic`).
#
# Routing patterns: always safe to capture (localhost/base URLs, proxy vars).
ROUTING_ENV_PATTERNS = [
    "*_BASE_URL", "*_API_BASE", "*_BASE",
    "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY",
    "http_proxy", "https_proxy", "no_proxy",
    "RTK_*", "HEADROOM_DEVICE",
]
# Auth-named patterns: captured ONLY when the value is a non-secret placeholder
# (the dummy `pass`/`dummy`/short token your proxy aliases set inline).
# HEADROOM_* was moved here because HEADROOM_API_KEY could contain real keys.
AUTH_ENV_PATTERNS = ["*_API_KEY", "*_AUTH_TOKEN", "*_TOKEN", "*_KEY", "HEADROOM_*"]
NONSECRET_VALUES = {"", "pass", "dummy", "none", "no", "x", "test", "local", "0", "1"}
# Back-compat alias; load_config still reads "env_patterns" if a user set one.
DEFAULT_ENV_PATTERNS = ROUTING_ENV_PATTERNS

# Restore preamble: ensure the proxy stack is up before reconnecting, if the
# user's shell defines _proxy_stack_auto_start. Harmless when it does not.
DEFAULT_RESTORE_PRE = (
    "command -v _proxy_stack_auto_start >/dev/null 2>&1 && _proxy_stack_auto_start;"
)

# Resume commands below intentionally include the `rtk` prefix and the user's
# real flags, so a restored session reconnects through the same proxy +
# compression chain. The proxy ENV (ANTHROPIC_BASE_URL, OPENAI_BASE_URL, ...)
# is captured per-session at launch and replayed from the sentinel on restore.
DEFAULT_CONFIG = {
    "terminal": {
        "backend": "auto",
        "order": ["tmux", "wezterm", "kitty", "windows-terminal"],
    },
    "wezterm": {"cli": "", "domain": ""},
    "ghostty": {"cli": ""},
    "kitty": {"cli": ""},
    "tmux": {"cli": ""},
    "windows_terminal": {"cli": "", "wsl": ""},
    "env_patterns": DEFAULT_ENV_PATTERNS,
    "restore": {"pre": DEFAULT_RESTORE_PRE, "spawn_delay": 0.5},
    "programs": {
        "claude": {
            "continue": ["rtk", "claude", "--continue", "--dangerously-skip-permissions"],
            "resume_by_id": ["rtk", "claude", "-r", "{id}", "--dangerously-skip-permissions"],
            "store": {"type": "claude", "root": "~/.claude/projects"},
            "interactive": True,
        },
        "opencode": {
            "continue": ["rtk", "opencode", "-c"],
            "resume_by_id": ["rtk", "opencode", "-s", "{id}"],
            "interactive": True,
        },
        "hermes": {
            "continue": ["rtk", "hermes", "--continue", "--dangerously-skip-permissions"],
            "resume_by_id": ["rtk", "hermes", "--resume", "{id}", "--dangerously-skip-permissions"],
            "interactive": True,
        },
        "pi": {
            "continue": ["rtk", "pi", "--provider", "openai", "-c"],
            "resume_by_id": ["rtk", "pi", "--provider", "openai", "--session", "{id}"],
            "interactive": True,
        },
        "codex": {
            "continue": ["rtk", "codex", "resume", "--last"],
            "resume_by_id": ["rtk", "codex", "resume", "{id}"],
            "store": {"type": "codex", "root": "~/.codex/sessions"},
            "interactive": True,
        },
        "kilo": {
            "continue": ["rtk", "kilo", "-c"],
            "interactive": True,
        },
        # ante repl is memory-based: a fresh launch auto-injects prior context.
        # No session-resume flag exists, so restore just relaunches in the dir.
        "ante": {
            "continue": ["ante", "repl"],
            "interactive": True,
        },
    },
}


def boot_id():
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except Exception:
        return "unknown-boot"


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def ensure_dirs():
    for d in (CFG_DIR, DATA_DIR, LIVE_DIR, ARCH_DIR):
        d.mkdir(parents=True, exist_ok=True)


def _deep_merge(base, override):
    """Recursively merge override into base, preserving base values for missing keys."""
    result = base.copy()
    for key, value in override.items():
        if key in result and isinstance(result[key], dict) and isinstance(value, dict):
            result[key] = _deep_merge(result[key], value)
        else:
            result[key] = value
    return result


def load_config():
    if CFG_FILE.exists():
        try:
            cfg = json.loads(CFG_FILE.read_text())
        except Exception as e:
            sys.stderr.write("crash-guard: config parse error: %s\n" % e)
            cfg = {}
    else:
        cfg = {}
    # Deep merge with defaults to ensure all nested keys exist
    cfg = _deep_merge(DEFAULT_CONFIG, cfg)
    # Ensure programs dict has all default programs (user can add more)
    for key, prog in DEFAULT_CONFIG["programs"].items():
        cfg["programs"].setdefault(key, prog)
    # Validate spawn_delay early so callers don't need to re-check
    raw_delay = (cfg.get("restore") or {}).get("spawn_delay", 0.5)
    try:
        v = float(raw_delay)
        if v < 0:
            v = 0.5
        elif v > 30:
            v = 30.0
        cfg.setdefault("restore", {})["spawn_delay"] = v
    except (ValueError, TypeError):
        cfg.setdefault("restore", {})["spawn_delay"] = 0.5
    return cfg


def write_default_config():
    ensure_dirs()
    if not CFG_FILE.exists():
        CFG_FILE.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return True
    return False


def fnmatch_any(name, patterns):
    return any(fnmatch.fnmatchcase(name, p) for p in patterns)


def _value_is_nonsecret(v):
    if v in NONSECRET_VALUES:
        return True
    # URLs are routing, not secrets (localhost / base endpoints).
    if v.startswith(("http://", "https://")):
        return True
    # Anything longer than a short placeholder is treated as a secret.
    return len(v) <= 8


def _system_snapshot():
    """Return a compact dict of system resources relevant to crash diagnosis.

    Used in restore_start / restore_done logging to help diagnose OOM or
    resource-exhaustion crashes.
    """
    snap = {}
    # memory
    try:
        mem = Path("/proc/meminfo").read_text().splitlines()
        for line in mem:
            if line.startswith("MemTotal:"):
                snap["mem_total_kb"] = int(line.split()[1])
            elif line.startswith("MemAvailable:"):
                snap["mem_avail_kb"] = int(line.split()[1])
    except Exception:
        pass
    # count of tracked AI processes from crash-guard live sentinels
    try:
        snap["live_sentinels"] = len(list(LIVE_DIR.glob("*.json")))
    except Exception:
        pass
    # count of all user processes (excluding kernel)
    try:
        snap["user_procs"] = sum(
            1 for p in Path("/proc").iterdir()
            if p.name.isdigit()
        )
    except Exception:
        pass
    return snap


def _git_context(path):
    """Return a compact dict with git branch and dirty flag for *path*, or
    empty dict if not a git repo or git is unavailable.

    Uses a single ``git status --porcelain -b`` call (branch + dirty status
    in one invocation, 2s timeout)."""
    try:
        res = subprocess.run(
            ["git", "-C", str(path), "status", "--porcelain", "-b"],
            capture_output=True, text=True, timeout=2,
        )
        if res.returncode != 0 or "fatal" in (res.stderr + res.stdout):
            return {}
        lines = res.stdout.strip().split("\n")
        branch_line = lines[0] if lines else ""
        branch = branch_line.replace("## ", "").split("...")[0].split(" ")[0] if branch_line else ""
        if not branch:
            return {}
        # Dirty if any line after the first exists and is non-empty
        dirty = bool("".join(lines[1:]).strip()) if len(lines) > 1 else False
        return {"branch": branch, "dirty": dirty}
    except Exception:
        return {}


def env_snapshot(patterns):
    """Capture proxy-routing env only. Never persist real credentials.

    `patterns` (from config "env_patterns") select routing vars. Auth-named
    vars are additionally allowed only when their VALUE is a non-secret
    placeholder, so the dummy `pass` survives but real keys are dropped.
    """
    out = {}
    for k, v in os.environ.items():
        if fnmatch_any(k, patterns):
            out[k] = v
        elif fnmatch_any(k, AUTH_ENV_PATTERNS) and _value_is_nonsecret(v):
            out[k] = v
    return out


def atomic_write(path, text):
    tmp = path.with_suffix(path.suffix + ".tmp-%d" % os.getpid())
    tmp.write_text(text)
    os.replace(str(tmp), str(path))


def _history_flush(f):
    """Flush and fsync a history file handle to disk. Best-effort."""
    try:
        f.flush()
        os.fsync(f.fileno())
    except Exception as e:
        sys.stderr.write("crash-guard history: fsync failed: %s\n" % e)


def append_history(event, rec=None, flush=False, **extra):
    """Append one durable history event. Best-effort, never blocks launchers.

    Sets ``flush=True`` for restore-related events so the record survives an
    OOM kill or session crash mid-restore.
    """
    try:
        ensure_dirs()
        payload = {
            "event": event,
            "at": now_iso(),
        }
        if rec is not None:
            # Strip internal-only fields; never write _path (may contain 
            # live/archive distinction that's meaningless on a different boot)
            clean = {k: v for k, v in rec.items() if not k.startswith("_")}
            payload["record"] = clean
        payload.update(extra)
        with HISTORY_FILE.open("a", encoding="utf-8") as f:
            f.write(json.dumps(payload, separators=(",", ":")) + "\n")
            if flush:
                _history_flush(f)
    except Exception as e:
        sys.stderr.write("crash-guard history: %s\n" % e)


def parse_time(value):
    if not value:
        return None
    try:
        return dt.datetime.strptime(value, "%Y-%m-%dT%H:%M:%S%z")
    except Exception:
        return None


def iso_from_ts(ts):
    """Convert a Unix timestamp to ISO 8601 with timezone offset."""
    tz = dt.datetime.now().astimezone().tzinfo
    return dt.datetime.fromtimestamp(ts, tz=tz).strftime("%Y-%m-%dT%H:%M:%S%z")


def pid_alive(pid):
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except Exception:
        return False


# --------------------------------------------------------------------------
# start / stop: called by the shell launcher. Never fail the wrapped command.
# --------------------------------------------------------------------------

def cmd_start(args):
    try:
        ensure_dirs()
        cfg = load_config()
        rec = {
            "inv_id": args.inv_id,
            "key": args.key,
            "cwd": args.cwd or os.getcwd(),
            "argv": args.argv,
            "env": env_snapshot(cfg.get("env_patterns", DEFAULT_ENV_PATTERNS)),
            "boot_id": boot_id(),
            "shell_pid": args.shell_pid,
            "launched_at": now_iso(),
            "host": os.uname().nodename,
        }
        if args.name:
            rec["name"] = args.name
        sentinel_path = LIVE_DIR / (args.inv_id + ".json")
        if sentinel_path.exists():
            sys.stderr.write("crash-guard start: warning — sentinel %s already exists (overwriting)\n" % args.inv_id)
        atomic_write(sentinel_path, json.dumps(rec) + "\n")
        append_history("start", rec)
    except Exception as e:
        sys.stderr.write("crash-guard start: %s\n" % e)
    return 0


def cmd_stop(args):
    try:
        p = LIVE_DIR / (args.inv_id + ".json")
        if p.exists():
            try:
                rec = json.loads(p.read_text())
            except Exception:
                rec = {"inv_id": args.inv_id}
            # Compute session duration from launched_at to now
            launched = rec.get("launched_at")
            dur = None
            if launched:
                lt = parse_time(launched)
                if lt:
                    dur = max(0, (dt.datetime.now(lt.tzinfo) - lt).total_seconds())
            extra = {"reason": "closed"}
            if dur is not None:
                extra["duration_secs"] = round(dur, 1)
            append_history("stop", rec, **extra)
            p.unlink()
    except Exception as e:
        sys.stderr.write("crash-guard stop: %s\n" % e)
    return 0


# --------------------------------------------------------------------------
# classify: read sentinels, decide running / stale / crashed.
# --------------------------------------------------------------------------

def read_sentinels():
    out = []
    if not LIVE_DIR.exists():
        return out
    for p in sorted(LIVE_DIR.glob("*.json")):
        try:
            rec = json.loads(p.read_text())
            rec["_path"] = str(p)
            out.append(rec)
        except Exception:
            sys.stderr.write("crash-guard: skipping unreadable sentinel %s\n" % p)
    return out


def read_archived_sentinels():
    out = []
    if not ARCH_DIR.exists():
        return out
    for p in sorted(ARCH_DIR.glob("*.json")):
        try:
            rec = json.loads(p.read_text())
            rec["_path"] = str(p)
            # Parse archive timestamp from filename: <stem>.<YYYYMMDD-HHMMSS>.json
            archive_at = None
            for candidate in reversed(p.name.replace(".json", "").split(".")):
                candidate = candidate.strip()
                try:
                    parsed = dt.datetime.strptime(candidate, "%Y%m%d-%H%M%S")
                    archive_at = parsed.replace(tzinfo=dt.datetime.now().astimezone().tzinfo).strftime("%Y-%m-%dT%H:%M:%S%z")
                    break
                except (ValueError, IndexError):
                    continue
            rec["_archive_at"] = archive_at or iso_from_ts(p.stat().st_mtime)
            rec["_archive_sort"] = archive_at or p.stat().st_mtime
            # Compute duration from launched_at to archive time for ephemeral detection
            launched = rec.get("launched_at")
            if launched:
                lt = parse_time(launched)
                at = parse_time(rec["_archive_at"])
                if lt and at:
                    dur = max(0, (at - lt).total_seconds())
                    rec["_duration_secs"] = dur
                    if dur < 5:
                        rec["_ephemeral"] = True
            out.append(rec)
        except Exception as e:
            sys.stderr.write("crash-guard: skipping unreadable archive %s: %s\n" % (p, e))
    return out


def read_history_events():
    out = []
    if not HISTORY_FILE.exists():
        return out
    with HISTORY_FILE.open("r", encoding="utf-8", errors="replace") as f:
        for lineno, line in enumerate(f, 1):
            line = line.strip()
            if not line:
                continue
            try:
                out.append(json.loads(line))
            except Exception:
                sys.stderr.write("crash-guard: skipping bad history line %d\n" % lineno)
    return out


def classify(records, cur_boot):
    running, stale, crashed = [], [], []
    for r in records:
        if r.get("boot_id") != cur_boot:
            crashed.append(r)
        elif pid_alive(int(r.get("shell_pid") or 0)):
            running.append(r)
        else:
            stale.append(r)
    return running, stale, crashed


def history_sessions():
    sessions = {}
    for ev in read_history_events():
        rec = ev.get("record") or {}
        inv_id = rec.get("inv_id")
        if not inv_id:
            continue
        cur = sessions.setdefault(inv_id, {"record": rec, "events": []})
        cur["record"].update({k: v for k, v in rec.items() if k != "_path"})
        cur["events"].append(ev)
        if ev.get("event") == "start":
            cur["started_at"] = rec.get("launched_at") or ev.get("at")
            cur["status"] = "running"
            cur["reason"] = "started"
        elif ev.get("event") == "stop":
            cur["ended_at"] = ev.get("at")
            cur["status"] = "closed"
            cur["reason"] = ev.get("reason") or "closed"
        elif ev.get("event") == "archive":
            cur["ended_at"] = ev.get("at")
            cur["status"] = ev.get("reason") or "archived"
            cur["reason"] = ev.get("reason") or "archived"
            if ev.get("archive_path"):
                cur["archive_path"] = ev.get("archive_path")
        elif ev.get("event") == "restore":
            cur["last_restored_at"] = ev.get("at")

    for rec in read_archived_sentinels():
        inv_id = rec.get("inv_id") or Path(rec.get("_path", "")).stem.split(".", 1)[0]
        cur = sessions.setdefault(inv_id, {"record": rec, "events": []})
        cur["record"].update({k: v for k, v in rec.items() if k != "_path"})
        cur.setdefault("ended_at", rec.get("_archive_at"))
        cur.setdefault("status", "archived")
        cur.setdefault("reason", "archived")
        cur["archive_path"] = rec.get("_path")

    live = read_sentinels()
    running, stale, crashed = classify(live, boot_id())
    live_status = {}
    for r in running:
        live_status[r.get("inv_id")] = ("running", "running")
    for r in stale:
        live_status[r.get("inv_id")] = ("stale", "stale")
    for r in crashed:
        live_status[r.get("inv_id")] = ("crashed", "crashed")
    for rec in live:
        inv_id = rec.get("inv_id")
        cur = sessions.setdefault(inv_id, {"record": rec, "events": []})
        cur["record"].update({k: v for k, v in rec.items() if k != "_path"})
        status, reason = live_status.get(inv_id, ("running", "running"))
        cur["status"] = status
        cur["reason"] = reason
        cur["live_path"] = rec.get("_path")
        if status in ("stale", "crashed"):
            cur.setdefault("ended_at", now_iso())

    # Compute session duration for all sessions with known start/end.
    # Sessions that ran < 5 seconds are "ephemeral" (single-command that
    # immediately exited, or a command not found on PATH).
    for inv_id, cur in sessions.items():
        started = cur.get("started_at") or (cur.get("record") or {}).get("launched_at")
        ended = cur.get("ended_at")
        if started and ended:
            # Try to get duration from the stop/archive event first
            dur = None
            for ev in cur.get("events", []):
                if ev.get("event") in ("stop", "archive") and ev.get("duration_secs") is not None:
                    dur = ev["duration_secs"]
                    break
            if dur is None:
                # Compute from timestamps
                st = parse_time(started)
                en = parse_time(ended)
                if st and en:
                    dur = max(0, (en - st).total_seconds())
            if dur is not None:
                cur["_duration_secs"] = dur
                if dur < 5:
                    cur["_ephemeral"] = True

    return sessions


def session_sort_time(sess):
    return parse_time(sess.get("ended_at")) or parse_time(sess.get("started_at")) or dt.datetime.fromtimestamp(0, dt.timezone.utc)


def restore_groups(include_closed=True, boot_id=None, include_archived=False):
    sessions = []
    for inv_id, sess in history_sessions().items():
        status = sess.get("status")
        if status == "running":
            continue
        if status == "closed" and not include_closed:
            continue
        # Skip archived-only sessions unless explicitly requested
        # (archive_path set but no live_path means it's been archived and
        #  the original live sentinel is gone)
        if sess.get("archive_path") and not sess.get("live_path") and not include_archived:
            continue
        # Skip ephemeral sessions that ran < 5 seconds (e.g. command not found,
        # test invocations, accidental launches). These are never useful to restore.
        if sess.get("_ephemeral"):
            continue
        rec = dict(sess.get("record") or {})
        if boot_id and rec.get("boot_id") != boot_id:
            continue
        rec.setdefault("inv_id", inv_id)
        if sess.get("live_path"):
            rec["_path"] = sess["live_path"]
        elif sess.get("archive_path"):
            rec["_path"] = sess["archive_path"]
        rec["_history_status"] = status or "unknown"
        rec["_history_reason"] = sess.get("reason") or status or "unknown"
        rec["_history_time"] = sess.get("ended_at") or sess.get("started_at") or None
        rec["_duration_secs"] = sess.get("_duration_secs")
        sessions.append((inv_id, sess, rec))

    groups = []
    for inv_id, sess, rec in sessions:
        status = rec.get("_history_status")
        when = session_sort_time(sess)
        if status == "closed":
            gkey = ("closed", inv_id)
        else:
            bucket = when.strftime("%Y%m%d%H%M") if when else "unknown"
            gkey = (rec.get("boot_id"), status, bucket)
        found = None
        for g in groups:
            if g["key"] == gkey:
                found = g
                break
        if found is None:
            found = {
                "key": gkey,
                "time": when,
                "status": status,
                "reason": rec.get("_history_reason"),
                "records": [],
            }
            groups.append(found)
        found["records"].append(rec)
        if when > found["time"]:
            found["time"] = when

    for g in groups:
        g["records"].sort(key=lambda r: r.get("cwd", ""))
    groups.sort(key=lambda g: g["time"], reverse=True)
    return groups


def boot_periods():
    periods = {}
    for inv_id, sess in history_sessions().items():
        rec = sess.get("record") or {}
        bid = rec.get("boot_id") or "unknown-boot"
        cur = periods.setdefault(bid, {
            "boot_id": bid,
            "start": None,
            "end": None,
            "records": 0,
            "running": 0,
            "closed": 0,
            "recoverable": 0,
        })
        cur["records"] += 1
        status = sess.get("status") or "unknown"
        if status == "running":
            cur["running"] += 1
        elif status == "closed":
            cur["closed"] += 1
        else:
            cur["recoverable"] += 1
        for val in (sess.get("started_at"), sess.get("ended_at")):
            parsed = parse_time(val)
            if not parsed:
                continue
            if cur["start"] is None or parsed < cur["start"]:
                cur["start"] = parsed
            if cur["end"] is None or parsed > cur["end"]:
                cur["end"] = parsed
    out = list(periods.values())
    out.sort(key=lambda p: p["end"] or p["start"] or dt.datetime.fromtimestamp(0, dt.timezone.utc), reverse=True)
    return out


def fmt_period_time(value):
    return value.strftime("%Y-%m-%d %H:%M:%S %z") if value else "unknown"


def print_boot_periods(periods):
    title()
    print(color("bold", "OS boot periods (%d):\n" % len(periods)))
    for i, p in enumerate(periods, 1):
        recoverable_color = "ok" if p["recoverable"] > 0 else "muted"
        running_color = "ok" if p["running"] > 0 else "muted"
        print("  %s %s -> %s  %s  %s  %s  %s boot=%s" % (
            colorize("ok", "%2d." % i),
            colorize("info", fmt_period_time(p.get("start"))),
            colorize("info", fmt_period_time(p.get("end"))),
            colorize("bold", "%d records" % p["records"]),
            colorize(recoverable_color, "%d recoverable" % p["recoverable"]),
            colorize(running_color, "%d running" % p["running"]),
            colorize("muted", "%d closed" % p["closed"]),
            colorize("muted", short(p["boot_id"], 8)),
        ))
    print("")


def arrow_select(options, title, default=0):
    if not options:
        return None
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raw = input("%s [%d]: " % (title, default + 1)).strip()
        return default if raw == "" else max(0, min(len(options) - 1, int(raw) - 1))

    idx = default
    old = termios.tcgetattr(sys.stdin)
    try:
        tty.setraw(sys.stdin.fileno())
        while True:
            sys.stdout.write("\033[?25l\033[2K\r%s\n" % title)
            for i, opt in enumerate(options):
                marker = ">" if i == idx else " "
                sys.stdout.write("\033[2K\r %s %2d. %s\n" % (marker, i + 1, opt))
            sys.stdout.write("\033[%dA" % (len(options) + 1))
            sys.stdout.flush()
            ch = sys.stdin.read(1)
            if ch in ("\r", "\n"):
                sys.stdout.write("\033[%dB\033[?25h" % (len(options) + 1))
                sys.stdout.flush()
                return idx
            if ch == "\x03":
                raise KeyboardInterrupt
            if ch.isdigit():
                # Jump cursor to the typed digit, waiting for Enter to confirm
                val = int(ch)
                if 1 <= val <= len(options):
                    idx = val - 1
                    # Redraw immediately to show cursor at new position
                    continue
            if ch == "\x1b":
                seq = sys.stdin.read(2)
                if seq == "[A":
                    idx = (idx - 1) % len(options)
                elif seq == "[B":
                    idx = (idx + 1) % len(options)
            sys.stdout.write("\033[%dA" % 0)
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()


def _resolve_display_key(r, cfg):
    """Return a display label for a sentinel record, showing the resolved
    program name and, when the raw key differs, noting the original key.

    When the recorded argv includes a wrapper (e.g. ``rtk``) before the
    actual tool, the wrapper is shown in the label as well.
    """
    key, note = resolve_record_program(r, cfg)
    raw_key = r.get("key", "?")
    # If both the resolved key and raw key point at the same configured
    # program (or there was no inference at all), show just the key.
    if key == raw_key and not note:
        return key
    # Show "program (was raw_key)" when inference found a different tool.
    if note:
        # Build a wrapper-chain label from the recorded argv when possible.
        argv = r.get("argv") or []
        wrappers = []
        for a in argv:
            w = Path(a).name
            if w == key:
                break
            if w and w != key:
                wrappers.append(w)
        if wrappers:
            return " → ".join(wrappers) + " → " + key
        return key
    return raw_key


def print_restore_groups(groups):
    cfg = load_config()
    title()
    print(color("bold", "recovery groups (%d):\n" % len(groups)))
    # Cache git context per cwd to avoid repeated subprocess calls
    git_cache = {}
    for i, g in enumerate(groups, 1):
        when = g["time"].strftime("%Y-%m-%d %H:%M:%S %z") if g.get("time") else "unknown time"
        status = g.get("status") or "unknown"
        status_colors = {"stale": "warn", "crashed": "fail", "archived": "highlight", "closed": "muted"}
        sc = status_colors.get(status, "info")
        print("  %s %s %s  (%d session(s))" % (
            colorize("ok", "%2d." % i),
            colorize(sc, "%-9s" % status),
            colorize("info", when),
            len(g["records"])))
        for j, r in enumerate(g["records"], 1):
            display = _resolve_display_key(r, cfg)
            wrap = ""
            argv = r.get("argv") or []
            if argv:
                wrap = "→ " + next((Path(a).name for a in argv if Path(a).name != display.split(" → ")[0] and Path(a).name != display.split(" → ")[-1]), "")
            # Duration label
            dur_label = ""
            dur = r.get("_duration_secs")
            if dur is not None:
                if dur < 60:
                    dur_label = "  (%.0fs)" % dur
                elif dur < 3600:
                    dur_label = "  (%dm%ds)" % (dur // 60, dur % 60)
                else:
                    dur_label = "  (%dh%dm)" % (dur // 3600, (dur % 3600) // 60)
            # Session name (optional, set via cg_run --name)
            name_label = ""
            sname = r.get("name") or ""
            if sname:
                name_label = "  [%s]" % colorize("highlight", sname)
            # Git context (cached per cwd)
            cwd = r.get("cwd", "")
            git_label = ""
            if cwd and cwd not in git_cache:
                git_cache[cwd] = _git_context(cwd)
            gc = git_cache.get(cwd, {})
            if gc:
                git_label = "  %s" % gc.get("branch", "")
                if gc.get("dirty"):
                    git_label += colorize("warn", "✗")
                else:
                    git_label += colorize("ok", "✓")
            print("      %s  %-15s %s%s%s%s%s" % (
                colorize("muted", "%d.%d" % (i, j)),
                colorize("bold", display),
                cwd,
                colorize("muted", "  " + wrap) if wrap else "",
                colorize("muted", dur_label) if dur_label else "",
                name_label if name_label else "",
                colorize("muted", git_label) if git_label else "",
            ))
    if groups:
        print("  %s git branch shown per session: \u2713 clean  \u2717 dirty" % colorize("muted", "\u2014"))
    print("")


# --------------------------------------------------------------------------
# session-store enumeration (Tier 2, multi-instance-per-directory only)
# --------------------------------------------------------------------------

def claude_encode_cwd(cwd):
    # Claude Code: every non-alphanumeric character of the absolute path
    # becomes '-'. (~/.claude/projects/<encoded>/<uuid>.jsonl)
    return "".join(c if c.isalnum() else "-" for c in cwd)


def store_sessions(prog, cwd, limit):
    """Return up to `limit` (session_id, jsonl_path) newest-first for cwd."""
    store = prog.get("store")
    if not store:
        return []
    root = Path(os.path.expanduser(store.get("root", "")))
    stype = store.get("type")
    found = []
    if stype == "claude":
        d = root / claude_encode_cwd(cwd)
        if d.is_dir():
            files = sorted(d.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
            found = [(p.stem, p) for p in files]
    elif stype == "codex":
        # Best effort: scan rollout files, keep those whose header cwd matches.
        cands = sorted(
            root.glob("**/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True
        )
        for p in cands:
            if len(found) >= limit * 3 + 5:
                break
            sid = _codex_id_for_path(p, cwd)
            if sid:
                found.append((sid, p))
    return found[:limit]


def _codex_id_for_path(path, want_cwd):
    try:
        with path.open("r", errors="replace") as f:
            head = f.readline()
        meta = json.loads(head)
    except Exception:
        return None
    hcwd = meta.get("cwd") or (meta.get("payload") or {}).get("cwd") or (meta.get("git") or {}).get("cwd")
    if hcwd and os.path.normpath(hcwd) != os.path.normpath(want_cwd):
        return None
    sid = meta.get("id") or meta.get("session_id") or (meta.get("payload") or {}).get("id")
    if sid:
        return sid
    name = path.stem
    return name.replace("rollout-", "") or name


# --------------------------------------------------------------------------
# artifact verification / optional repair
# --------------------------------------------------------------------------

def verify_artifact(path, repair=False):
    """Return one of: missing, empty, ok, repaired, corrupt."""
    p = Path(path)
    if not p.exists():
        return "missing"
    data = p.read_bytes()
    if not data.strip():
        return "empty"
    changed = False
    if data.endswith(b"\x00") or b"\x00" in data[-4096:]:
        stripped = data.rstrip(b"\x00")
        if stripped != data:
            data = stripped
            changed = True
    lines = data.split(b"\n")
    while lines and lines[-1].strip() == b"":
        lines.pop()
    last_ok = False
    if lines:
        try:
            json.loads(lines[-1].decode("utf-8", "replace"))
            last_ok = True
        except Exception:
            last_ok = False
    if not last_ok and lines:
        lines = lines[:-1]
        changed = True
    if not lines:
        return "corrupt"
    if changed and repair:
        ts = time.strftime("%Y%m%d-%H%M%S")
        backup = ARCH_DIR / ("%s.%s.bak" % (p.name, ts))
        try:
            backup.write_bytes(p.read_bytes())
            p.write_bytes(b"\n".join(lines) + b"\n")
            return "repaired"
        except Exception as e:
            sys.stderr.write("crash-guard: repair failed for %s: %s\n" % (p, e))
            return "corrupt"
    if changed:
        return "corrupt"
    return "ok"


# --------------------------------------------------------------------------
# restore planning
# --------------------------------------------------------------------------

def argv_program_key(argv, programs):
    """Infer the configured program from a recorded command argv."""
    names = [Path(a).name for a in (argv or []) if a]
    for name in names[:3]:
        prog = programs.get(name)
        if prog and not prog.get("use_sentinel_argv"):
            return name
    return None


def argv_extra_args(recorded_argv, program_argv, tool_name):
    """Extract tool-specific user args from recorded argv beyond what the program config supplies.

    The program config command already includes the canonical flags for the tool
    (e.g. ``--provider openai`` for pi).  If the user passed extra flags at launch
    (e.g. ``-c`` for continue, ``--model gpt4``), those are appended so restore
    matches the original invocation as closely as possible.

    Returns a list of argument strings that were present in the recorded argv
    *after* the tool name but are *not* already supplied by the program config.
    """
    if not recorded_argv:
        return []

    # Locate the tool name in the recorded argv.
    rec_idx = None
    for i, a in enumerate(recorded_argv):
        if Path(a).name == tool_name:
            rec_idx = i
            break
    if rec_idx is None:                     # tool not found — no extra args
        return []

    rec_tail = recorded_argv[rec_idx + 1:]   # everything after the tool

    if not program_argv:
        return rec_tail                     # no baseline → everything is "extra"

    # Locate the tool name in the program command.
    prog_idx = None
    for i, a in enumerate(program_argv):
        if Path(a).name == tool_name:
            prog_idx = i
            break
    if prog_idx is None:                    # tool not in program command
        return rec_tail

    prog_tail = program_argv[prog_idx + 1:]

    # Remove each default arg from the recorded tail (first occurrence only).
    # What remains are the truly extra flags the user added at launch.
    extra = list(rec_tail)
    for a in prog_tail:
        try:
            extra.remove(a)
        except ValueError:
            pass
    return extra


def resolve_record_program(r, cfg):
    """Return (plan_key, note) for a sentinel record.

    Some launchers record a wrapper key such as `rtk` while storing the actual
    tool in argv. Prefer the concrete tool config when it can be inferred.
    If the original key has use_sentinel_argv=true, use the recorded argv directly.
    """
    programs = cfg["programs"]
    key = r.get("key")
    prog = programs.get(key)
    raw_argv = r.get("argv") or []

    # If the original key has use_sentinel_argv, prefer the recorded argv
    if prog and prog.get("use_sentinel_argv"):
        return key, "using recorded argv (use_sentinel_argv)"

    inferred = argv_program_key(raw_argv, programs)

    if inferred and (not prog or prog.get("use_sentinel_argv")):
        if key and key != inferred:
            return inferred, "recorded as '%s'; inferred from argv" % key
        return inferred, ""
    return key, ""


def sentinel_restore_argv(r, key, prog=None):
    argv = list(r.get("argv") or [])
    if not argv:
        # Empty argv - cannot restore, return sentinel key as fallback
        return [key] if key else []
    # If the program has use_sentinel_argv, don't prepend the key
    # Just return the argv as-is (it already contains the full command)
    if prog and prog.get("use_sentinel_argv"):
        return argv
    if key and Path(argv[0]).name != key:
        return [key] + argv
    return argv


def build_plan(crashed, cfg, repair=False):
    """Group crashed sentinels by (key, cwd) and resolve resume commands."""
    groups = {}
    for r in crashed:
        key, infer_note = resolve_record_program(r, cfg)
        r["_plan_note"] = infer_note
        groups.setdefault((key, r.get("cwd")), []).append(r)

    plan = []
    for (key, cwd), recs in groups.items():
        prog = cfg["programs"].get(key)
        n = len(recs)
        if not prog:
            for r in recs:
                note = "no config entry for '%s'" % key
                if r.get("_plan_note"):
                    note = "%s; %s" % (r["_plan_note"], note)
                replay_argv = list(r.get("argv") or [])
                if replay_argv:
                    plan.append({
                        "key": key, "cwd": cwd, "rec": r, "tier": "replay",
                        "argv": replay_argv, "note": note,
                        "env": r.get("env", {}),
                    })
                else:
                    plan.append({
                        "key": key, "cwd": cwd, "rec": r, "tier": "skip",
                        "argv": None, "note": note,
                        "env": r.get("env", {}),
                    })
            continue

        if prog.get("use_sentinel_argv"):
            for r in recs:
                note = r.get("_plan_note") or "using recorded argv"
                plan.append({
                    "key": key, "cwd": cwd, "rec": r, "tier": "recorded",
                    "argv": sentinel_restore_argv(r, key, prog), "note": note,
                    "env": r.get("env", {}),
                })
            continue

        sessions = []
        if n > 1 and prog.get("resume_by_id") and prog.get("store"):
            sessions = store_sessions(prog, cwd, n)

        for i, r in enumerate(recs):
            env = r.get("env", {})
            recorded_argv = r.get("argv") or []
            if i < len(sessions):
                sid, spath = sessions[i]
                status = verify_artifact(spath, repair=repair)
                if status in ("ok", "repaired"):
                    base_argv = [a.replace("{id}", sid).replace("{cwd}", cwd)
                                 for a in prog["resume_by_id"]]
                    extra = argv_extra_args(recorded_argv, base_argv, key)
                    plan.append({
                        "key": key, "cwd": cwd, "rec": r, "tier": "id",
                        "argv": base_argv + extra, "session": sid, "verify": status,
                        "note": "" if status == "ok" else "artifact repaired",
                        "env": env,
                    })
                    continue
                # fall through to continue with a degradation note
                note = "session %s %s; using continue" % (sid[:8], status)
                if r.get("_plan_note"):
                    note = "%s; %s" % (r["_plan_note"], note)
                base_argv = prog["continue"]
                extra = argv_extra_args(recorded_argv, base_argv, key)
                plan.append({
                    "key": key, "cwd": cwd, "rec": r, "tier": "continue",
                    "argv": base_argv + extra, "verify": status,
                    "note": note,
                    "env": env,
                })
            else:
                note = r.get("_plan_note") or ""
                if n > 1 and i > 0:
                    extra = "multiple in same dir, no distinct id; may collapse"
                    note = "%s; %s" % (note, extra) if note else extra
                base_argv = prog["continue"]
                uxtra = argv_extra_args(recorded_argv, base_argv, key)
                plan.append({
                    "key": key, "cwd": cwd, "rec": r, "tier": "continue",
                    "argv": base_argv + uxtra, "note": note, "env": env,
                })
    return plan


# --------------------------------------------------------------------------
# terminal spawning
# --------------------------------------------------------------------------

def _which_configured(cfg, section, key, candidates):
    explicit = (cfg.get(section) or {}).get(key)
    if explicit:
        return explicit
    for cand in candidates:
        found = shutil.which(cand)
        if found:
            return found
    return None


def _env_is(name):
    return (os.environ.get("TERM_PROGRAM") or "").lower() == name.lower()


# --------------------------------------------------------------------------
# cass integration helpers
# --------------------------------------------------------------------------

def _cass_available():
    """Return True if the cass binary is on PATH and reachable."""
    return shutil.which("cass") is not None


def _cass_workspace_sessions(workspace, limit=5):
    """Return a list of cass session dicts for the given workspace, or empty list."""
    if not _cass_available():
        return []
    try:
        res = subprocess.run(
            ["cass", "sessions", "--workspace", workspace,
             "--limit", str(limit), "--json"],
            capture_output=True, text=True, timeout=10,
        )
        if res.returncode != 0:
            return []
        data = json.loads(res.stdout)
        return data.get("sessions") or data if isinstance(data, list) else []
    except Exception:
        return []


def _cass_format_session(s):
    """One-line summary of a cass session dict."""
    agent = s.get("agent", "?")
    title = (s.get("title") or "no title")[:60]
    human = s.get("human_turns", 0)
    msgs = s.get("message_count", 0)
    return "  %-12s %-60s  (%d msgs, %d turns)" % (agent, title, msgs, human)


def _cass_workspace_summary(workspace):
    """Return a multi-line summary string of cass sessions for *workspace*,
    or empty string if cass is unavailable or no sessions are found."""
    sessions = _cass_workspace_sessions(workspace, limit=5)
    if not sessions:
        return ""
    lines = []
    lines.append("       cass:        %d session(s) in this workspace:" % len(sessions))
    for s in sessions:
        lines.append("                   %s" % _cass_format_session(s))
    return "\n".join(lines)


def terminal_title(item):
    base = os.path.basename(item["cwd"].rstrip("/")) or "/"
    return "%s @ %s" % (item["key"], base)


def shell_join(argv):
    return " ".join(shlex.quote(a) for a in argv)


# --------------------------------------------------------------------------
# detailed plan display / arg editing
# --------------------------------------------------------------------------

_SHORT_WIDTH = 48


def _short_path(path, maxlen=_SHORT_WIDTH):
    """Truncate *path* in the middle when it exceeds *maxlen* chars."""
    s = str(path)
    if len(s) <= maxlen:
        return s
    half = (maxlen - 3) // 2
    return s[:half] + "..." + s[-half:]


def _fmt_env_table(env):
    """Format an env dict into compact lines, wrapping when lines get long."""
    if not env:
        return ""
    lines = []
    items = sorted(env.items())
    buf = ""
    for k, v in items:
        piece = "%s=%s" % (k, v)
        sep = "  " if buf else ""
        trial = buf + sep + piece
        if len(trial) > 72 and buf:
            lines.append(buf)
            buf = piece
        else:
            buf = trial
    if buf:
        lines.append(buf)
    return lines


def _recorded_argv(rec):
    """Safely return a string representation of the original recorded argv."""
    argv = rec.get("argv") or []
    if argv:
        return " ".join(shlex.quote(a) for a in argv)
    return "(empty)"


def format_plan_item(item, cfg, idx, detail=True):
    """Return a richly formatted multi-line string for one plan item.

    Includes the resolved program, original recorded argv, the restore
    command, the full shell command that will be executed, and additional
    metadata (invocation id, boot id, pid, env, note).
    """
    key = item["key"]
    cwd = item["cwd"]
    tier = item["tier"]
    note = item.get("note", "")
    rec = item.get("rec") or {}
    short_id = (rec.get("inv_id") or "?")[:8]
    boot_short = (rec.get("boot_id") or "?")[:8]
    pid = rec.get("shell_pid") or "?"
    when = rec.get("launched_at") or ""

    # ---- tier color ----
    tier_colors = {"continue": "ok", "id": "info", "replay": "warn", "recorded": "info", "skip": "muted"}
    tier_color = tier_colors.get(tier, "muted")

    # ---- header line ----
    lines = []
    lines.append("  %2s. %s %s" % (idx, colorize("bold", "%-12s" % key), cwd))

    # ---- session name (optional) ----
    sname = rec.get("name") or ""
    if sname:
        lines.append("       Name:        %s" % colorize("highlight", sname))

    # ---- git context ----
    git = _git_context(cwd)
    if git:
        flag = colorize("warn", "✗") if git.get("dirty") else colorize("ok", "✓")
        lines.append("       Git:         %s  %s" % (git.get("branch", "?"), flag))

    # ---- tier ----
    tier_str = "       Tier:        %s" % colorize(tier_color, tier)
    if item.get("session"):
        tier_str += "  %s" % colorize("info", "id=%s" % short(item["session"], 8))
    lines.append(tier_str)

    # ---- recorded argv (what was originally captured) ----
    recorded_str = _recorded_argv(rec)
    lines.append("       Recorded:    %s" % colorize("muted", recorded_str))

    # ---- restore cmd (what will be executed after cg_run --) ----
    if item["argv"]:
        restore_str = " ".join(shlex.quote(a) for a in item["argv"])
        lines.append("       Restore cmd: %s" % colorize("bold", restore_str))
    else:
        lines.append("       Restore cmd: %s" % colorize("muted", "(skipped)"))

    # ---- full shell command (the actual command that gets spawned) ----
    if detail and item["argv"]:
        shell = os.environ.get("SHELL", "/bin/zsh")
        exports = ""
        for k, v in (item.get("env") or {}).items():
            exports += "export %s=%s; " % (k, shlex.quote(v))
        pre = (cfg.get("restore") or {}).get("pre", "")
        pre_part = (pre.rstrip() + " ") if pre else ""
        payload = "cd %s; %s%scg_run %s -- %s" % (
            shlex.quote(item["cwd"]),
            exports,
            pre_part,
            shlex.quote(item["key"]),
            " ".join(shlex.quote(a) for a in item["argv"]),
        )
        lines.append("       Full shell:  %s" % colorize("dim", _short_path(payload)))
        if len(payload) > _SHORT_WIDTH:
            lines.append("                    %s" % colorize("dim", payload))
    elif item["argv"] and not detail:
        # Brief one-line summary when --verbose is not set
        shell = os.environ.get("SHELL", "/bin/zsh")
        brief = "cd %s; cg_run %s -- %s" % (
            item["cwd"],
            item["key"],
            " ".join(shlex.quote(a) for a in item["argv"]),
        )
        lines.append("       Command:    %s" % colorize("dim", _short_path(brief)))

    # ---- metadata: inv, boot, pid, launched_at ----
    meta_parts = []
    meta_parts.append("inv_%-8s" % short_id)
    meta_parts.append("boot_%-8s" % boot_short)
    meta_parts.append("pid_%s" % pid)
    if when:
        meta_parts.append("@ %s" % when)
    lines.append("       Sent:        %s" % "  ".join(meta_parts))

    # ---- verify status (for "id" tier) ----
    if item.get("verify") and item["verify"] not in ("ok", ""):
        verify_color = "ok" if item["verify"] == "repaired" else "fail"
        lines.append("       Verify:      %s" % colorize(verify_color, item["verify"]))
    if item.get("session"):
        lines.append("       Session ID:  %s" % colorize("highlight", item["session"]))

    # ---- env ----
    env_lines = _fmt_env_table(item.get("env") or {})
    if env_lines:
        lines.append("       Env:         %s" % colorize("muted", env_lines[0]))
        for el in env_lines[1:]:
            lines.append("                     %s" % colorize("muted", el))

    # ---- note ----
    if note:
        lines.append("       Note:        %s" % colorize("warn", note))

    # ---- cass hint (when cass binary is on PATH) ----
    cass_summary = item.get("_cass_summary", "")
    if cass_summary:
        lines.append(cass_summary)
    elif _cass_available() and cwd:
        lines.append("       cass:        %s" % colorize("muted",
            'cass sessions --workspace "%s" --limit 3' % cwd))

    return "\n".join(lines) + "\n"


def edit_plan_interactive(plan, cfg):
    """Walk the user through modifying extra args for each plan item.

    Returns a new *plan* list with updated ``argv`` values.  The original
    plan items are not mutated (shallow copy).
    """
    plan = [dict(item) for item in plan]   # shallow copy
    print("")
    print("== Argument Edit Mode ==")
    print("For each session, you can replace the full restore argv.")
    print("  %s Keep the current command as-is." % colorize("muted", "• Enter"))
    print("  %s Type new argument tokens to replace the restore argv." % colorize("ok", "• <args>"))
    print("  %s Use the base command only (strip extras)." % colorize("warn", "• clear"))
    print("  %s Exclude this session from the restore." % colorize("fail", "• skip"))
    print("  %s Finish editing early." % colorize("info", "• done"))
    print("")

    for i, item in enumerate(plan, 1):
        if not item["argv"]:
            continue
        key = item["key"]
        cwd_path = item["cwd"]
        base_argv = " ".join(shlex.quote(a) for a in item["argv"])
        print("  [%d/%d] %s @ %s" % (i, len(plan), colorize("bold", key), cwd_path))
        print("    current: %s" % base_argv)
        raw = input("    new args [Enter=keep]: ").strip()
        if raw.lower() in ("done", "done()"):
            break
        if raw.lower() == "skip":
            item["argv"] = None
            print("    %s" % colorize("muted", "    -> skipped"))
            continue
        if raw == "":
            print("    %s" % colorize("muted", "    -> kept"))
            continue
        if raw.lower() == "clear":
            # Recompute from program config without extra args
            prog = cfg["programs"].get(item["key"])
            if prog:
                item["argv"] = list(prog.get("continue") or prog.get("resume_by_id") or [])
            else:
                # No config — use just the tool name from recorded argv
                rec_argv = (item.get("rec") or {}).get("argv") or []
                item["argv"] = list(rec_argv) if rec_argv else None
            restored = " ".join(shlex.quote(a) for a in (item["argv"] or []))
            print("    %s" % colorize("info", "    -> base only: %s" % restored))
            continue
        # Replace with user-typed args
        item["argv"] = shlex.split(raw)
        print("    %s" % colorize("ok", "    -> updated: %s" % raw))

    print("")
    return plan


def print_detailed_plan(plan, cfg, detail=True):
    """Print the full detailed plan header + all items.

    Set ``detail=False`` to hide the verbose full shell command
    (shown with ``--verbose``).
    """
    if not plan:
        return
    # Gather cass context for each unique workspace (one subprocess per workspace)
    cass_cache = {}
    if _cass_available():
        cwds = sorted(set(item["cwd"] for item in plan if item.get("cwd")))
        for cwd in cwds:
            summary = _cass_workspace_summary(cwd)
            if summary:
                cass_cache[cwd] = summary
        for item in plan:
            if item.get("cwd") in cass_cache:
                item["_cass_summary"] = cass_cache[item["cwd"]]

    print("crash-guard restore plan (%d session(s)):\n" % len(plan))
    for i, item in enumerate(plan, 1):
        print(format_plan_item(item, cfg, i, detail=detail))
    plansig = sum(len(item.get("argv") or []) for item in plan)
    print("  total arguments across %d item(s): %d\n" % (len(plan), plansig))


def resolve_terminal_backend(cfg, requested="auto"):
    """Return (backend, cli, note) for the terminal used by restore."""
    requested = requested or "auto"
    aliases = {
        "windows_terminal": "windows-terminal",
        "wt": "windows-terminal",
    }
    requested = aliases.get(requested, requested)

    def cli_for(backend):
        if backend == "tmux":
            return _which_configured(cfg, "tmux", "cli", ("tmux",))
        if backend == "wezterm":
            return wez_cli(cfg)
        if backend == "kitty":
            return _which_configured(cfg, "kitty", "cli", ("kitty",))
        if backend == "ghostty":
            return _which_configured(cfg, "ghostty", "cli", ("ghostty",))
        if backend == "windows-terminal":
            return _which_configured(cfg, "windows_terminal", "cli", ("wt.exe", "wt"))
        return None

    if requested != "auto":
        cli = cli_for(requested)
        if cli:
            return requested, cli, "configured"
        return None, None, "no CLI found for terminal backend '%s'" % requested

    # Prefer the terminal/multiplexer we are actually inside. tmux wins because
    # it works uniformly inside Ghostty, Windows Terminal, kitty, and WezTerm.
    current = []
    if os.environ.get("TMUX"):
        current.append("tmux")
    if os.environ.get("WEZTERM_PANE") or _env_is("WezTerm"):
        current.append("wezterm")
    if os.environ.get("KITTY_WINDOW_ID") or os.environ.get("KITTY_LISTEN_ON"):
        current.append("kitty")
    if os.environ.get("WT_SESSION"):
        current.append("windows-terminal")

    # NOTE: Ghostty on Linux (GTK) opens separate OS windows via +new-window.
    # Opening many Ghostty OS windows with heavy AI agents can OOM the system.
    # When running inside Ghostty AND tmux is available, prefer tmux windows
    # (which appear as tabs in the current Ghostty window). Only fall back to
    # opening new Ghostty OS windows when tmux is not installed.
    in_ghostty = _env_is("ghostty")
    if in_ghostty and shutil.which("tmux"):
        current.append("tmux")
    elif in_ghostty:
        current.append("ghostty")

    order = (cfg.get("terminal") or {}).get("order") or DEFAULT_CONFIG["terminal"]["order"]
    for backend in current + [b for b in order if b not in current]:
        cli = cli_for(backend)
        if cli:
            return backend, cli, "auto"
    return None, None, "no supported terminal CLI found"


def spawn_terminal_prepare(cfg, backend, cli):
    if backend == "wezterm":
        domain = wez_domain(cfg)
        window_id = wez_current_window(cli)
        if window_id is not None:
            return {"domain": domain, "window_id": window_id, "label": "WezTerm tabs in window %s" % window_id}
        return {"domain": domain, "window_id": None, "label": "WezTerm new window"}
    if backend == "tmux":
        if os.environ.get("TMUX"):
            return {"inside": True, "label": "tmux windows in current session"}
        name = "crash-guard-%s-%s" % (time.strftime("%Y%m%d-%H%M%S"), os.getpid())
        return {
            "inside": False,
            "session": name,
            "session_started": False,
            "attach_after": True,
            "label": "new tmux session %s" % name,
        }
    if backend == "kitty":
        return {"label": "kitty tabs"}
    if backend == "ghostty":
        return {"label": "Ghostty windows"}
    if backend == "windows-terminal":
        wsl = _which_configured(cfg, "windows_terminal", "wsl", ("wsl.exe", "wsl"))
        if not wsl:
            return {"error": "windows-terminal backend requires wsl.exe/wsl on PATH"}
        return {"wsl": wsl, "label": "Windows Terminal tabs"}
    return {"error": "unsupported terminal backend '%s'" % backend}


def spawn_terminal(cfg, backend, cli, ctx, item, inner):
    title = terminal_title(item)
    if backend == "wezterm":
        pane, err = wez_spawn(cli, ctx["domain"], inner, window_id=ctx["window_id"])
        if pane is None:
            return None, err
        if ctx["window_id"] is None:
            ctx["window_id"] = wez_window_for_pane(cli, pane)
        wez_set_title(cli, pane, title)
        return "pane %s" % pane, None
    if backend == "tmux":
        return tmux_spawn(cli, ctx, item["cwd"], title, inner)
    if backend == "kitty":
        return kitty_spawn(cli, item["cwd"], title, inner)
    if backend == "ghostty":
        return ghostty_spawn(cli, item["cwd"], title, inner)
    if backend == "windows-terminal":
        return wt_spawn(cli, ctx["wsl"], item["cwd"], title, inner)
    return None, "unsupported terminal backend '%s'" % backend


def tmux_spawn(cli, ctx, cwd, title, inner):
    command = shell_join(inner)
    if ctx.get("inside"):
        argv = [cli, "new-window", "-P", "-F", "#{window_id}", "-n", title, "-c", cwd, command]
    elif not ctx.get("session_started"):
        argv = [cli, "new-session", "-d", "-P", "-F", "#{session_name}:#{window_id}",
                "-s", ctx["session"], "-n", title, "-c", cwd, command]
        ctx["session_started"] = True
    else:
        argv = [cli, "new-window", "-P", "-F", "#{session_name}:#{window_id}",
                "-t", ctx["session"], "-n", title, "-c", cwd, command]
    try:
        res = subprocess.run(argv, capture_output=True, text=True, timeout=5)
        if res.returncode != 0:
            return None, res.stderr.strip()
        return res.stdout.strip() or "tmux window", None
    except subprocess.TimeoutExpired:
        return "tmux window (timeout)", None


def tmux_attach(cli, ctx):
    if not ctx.get("attach_after") or not ctx.get("session_started"):
        return 0
    print("  -> attaching current terminal to tmux session %s" % ctx["session"])
    return subprocess.run([cli, "attach-session", "-t", ctx["session"]]).returncode


def kitty_spawn(cli, cwd, title, inner):
    argv = [
        cli, "@", "launch",
        "--type=tab",
        "--tab-title", title,
        "--cwd", cwd,
    ] + inner
    try:
        res = subprocess.run(argv, capture_output=True, text=True, timeout=5)
        if res.returncode == 0:
            return res.stdout.strip() or "kitty tab", None
        err = res.stderr.strip()
    except subprocess.TimeoutExpired:
        err = "kitty @ launch timed out (remote control may not be enabled)"
    except Exception as e:
        err = str(e)

    fallback = [cli, "--directory", cwd, "--title", title] + inner
    try:
        proc = subprocess.Popen(fallback, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        return None, "%s; fallback failed: %s" % (err, e)
    return "kitty pid %s" % proc.pid, None


def ghostty_spawn(cli, cwd, title, inner):
    # Use Popen (non-blocking) for both +new-window and the plain fallback.
    # subprocess.run would block the spawn loop until the inner command exits,
    # which could be hours for an AI agent session.
    argv = [
        cli, "+new-window",
        "--working-directory=%s" % cwd,
        "--title=%s" % title,
        "-e",
    ] + inner
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return "ghostty pid %s" % proc.pid, None
    except Exception as e:
        primary_err = str(e)

    # Older or platform-specific Ghostty builds may not support +new-window.
    # Plain ghostty -e still creates a surface and returns immediately via Popen.
    fallback = [
        cli,
        "--working-directory=%s" % cwd,
        "--title=%s" % title,
        "-e",
    ] + inner
    try:
        proc = subprocess.Popen(fallback, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        return None, "%s; fallback failed: %s" % (primary_err, e)
    return "ghostty pid %s" % proc.pid, None


def wt_spawn(cli, wsl, cwd, title, inner):
    distro = os.environ.get("WSL_DISTRO_NAME")
    wsl_argv = [wsl]
    if distro:
        wsl_argv += ["-d", distro]
    wsl_argv += ["--cd", cwd, "--exec"] + inner
    argv = [cli, "-w", "0", "new-tab", "--title", title] + wsl_argv
    try:
        res = subprocess.run(argv, capture_output=True, text=True, timeout=5)
        if res.returncode != 0:
            return None, res.stderr.strip()
        return "wt tab", None
    except subprocess.TimeoutExpired:
        return "wt tab (timeout)", None


# --------------------------------------------------------------------------
# WezTerm spawning (Windows interop aware)
# --------------------------------------------------------------------------

def wez_cli(cfg):
    explicit = (cfg.get("wezterm") or {}).get("cli")
    if explicit:
        return explicit
    for cand in ("wezterm.exe", "wezterm"):
        found = shutil.which(cand)
        if found:
            return found
    return None


def wez_domain(cfg):
    explicit = (cfg.get("wezterm") or {}).get("domain")
    if explicit:
        return explicit
    distro = os.environ.get("WSL_DISTRO_NAME")
    if distro:
        return "WSL:%s" % distro
    return ""


def wez_list(cli):
    res = subprocess.run([cli, "cli", "list", "--format", "json"],
                         capture_output=True, text=True)
    if res.returncode != 0:
        return []
    try:
        return json.loads(res.stdout)
    except Exception:
        return []


def wez_focused_pane(cli):
    """The GUI's currently-focused pane id, via the mux (WSL-proof).

    WezTerm does not export WEZTERM_PANE across the WSL boundary, so inside a
    WSL pane the env var is empty. The mux still knows the focused pane, so we
    ask it directly. If several clients are attached, prefer the least-idle.
    """
    res = subprocess.run([cli, "cli", "list-clients", "--format", "json"],
                         capture_output=True, text=True)
    if res.returncode != 0:
        return None
    try:
        clients = [c for c in json.loads(res.stdout)
                   if c.get("focused_pane_id") is not None]
    except Exception:
        return None
    if not clients:
        return None
    clients.sort(key=lambda c: (c.get("idle_time") or {}).get("secs", 1 << 30))
    return clients[0]["focused_pane_id"]


def wez_current_window(cli):
    """Window id of the EXISTING window to attach restored tabs to.

    Resolution order: WEZTERM_PANE (native Linux/macOS) -> the mux's focused
    pane (works under WSL where WEZTERM_PANE is absent) -> the sole window if
    there is exactly one.
    """
    panes = wez_list(cli)
    if not panes:
        return None

    def window_of(pane_id):
        for entry in panes:
            if str(entry.get("pane_id")) == str(pane_id):
                return entry.get("window_id")
        return None

    env_pane = os.environ.get("WEZTERM_PANE")
    if env_pane:
        w = window_of(env_pane)
        if w is not None:
            return w

    focused = wez_focused_pane(cli)
    if focused is not None:
        w = window_of(focused)
        if w is not None:
            return w

    windows = {entry.get("window_id") for entry in panes}
    if len(windows) == 1:
        return next(iter(windows))
    return None


def build_inner(item, cfg):
    shell = os.environ.get("SHELL", "/bin/zsh")
    exports = ""
    for k, v in (item.get("env") or {}).items():
        exports += "export %s=%s; " % (k, shlex.quote(v))
    pre = (cfg.get("restore") or {}).get("pre", "")
    pre_part = (pre.rstrip() + " ") if pre else ""
    resume_argv = item["argv"]
    payload = "cd %s; %s%scg_run %s -- %s" % (
        shlex.quote(item["cwd"]),
        exports,
        pre_part,
        shlex.quote(item["key"]),
        " ".join(shlex.quote(a) for a in resume_argv),
    )
    # -l login, -i interactive -> sources ~/.zshrc so cg_run + the proxy
    # function are defined; -c runs our payload.
    return [shell, "-lic", payload]


def wez_spawn(cli, domain, inner, window_id=None):
    argv = [cli, "cli", "spawn"]
    if domain:
        argv += ["--domain-name", domain]
    if window_id is None:
        argv += ["--new-window"]
    else:
        argv += ["--window-id", str(window_id)]
    argv += ["--"] + inner
    res = subprocess.run(argv, capture_output=True, text=True)
    if res.returncode != 0:
        return None, res.stderr.strip()
    return res.stdout.strip(), None


def wez_window_for_pane(cli, pane_id):
    for entry in wez_list(cli):
        if str(entry.get("pane_id")) == str(pane_id):
            return entry.get("window_id")
    return None


def wez_set_title(cli, pane_id, title):
    subprocess.run([cli, "cli", "set-tab-title", "--pane-id", str(pane_id), title],
                   capture_output=True, text=True)


# --------------------------------------------------------------------------
# commands: status / restore / list / prune / init / notify / genid
# --------------------------------------------------------------------------

def short(s, n=8):
    return (s or "")[:n]


def fmt_row(r, status, cfg=None):
    label = r.get("key", "?")
    if cfg:
        resolved, _ = resolve_record_program(r, cfg)
        if resolved and resolved != label:
            label = resolved
    color_map = {"run": "ok", "stl": "warn", "crx": "fail"}
    status_display = colorize(color_map.get(status, "muted"), "%-4s" % status)
    return "  [%s] %s %s" % (status_display, colorize("bold", "%-12s" % label), r.get("cwd", "?"))


def cmd_status(args):
    cur = boot_id()
    recs = read_sentinels()
    running, stale, crashed = classify(recs, cur)
    cfg = load_config()
    if args.json:
        # Machine-readable JSON output for claude-code-proxy integration
        tools = {}
        for recs_list, status in [(running, "running"), (stale, "stale"), (crashed, "crashed")]:
            for r in recs_list:
                k = r.get("key", "unknown")
                s = tools.setdefault(k, {"running": 0, "stale": 0, "crashed": 0})
                s[status] += 1
        print(json.dumps({
            "boot_id": cur[:8],
            "tracked": len(recs),
            "running": len(running),
            "stale": len(stale),
            "crashed": len(crashed),
            "tools": tools,
        }))
        return 0
    print("crash-guard status  (boot %s)" % colorize("muted", short(cur, 8)))
    print("  tracked sentinels: %d" % len(recs))
    if running:
        print(colorize("ok", "\nrunning (%d):" % len(running)))
        for r in running:
            print(fmt_row(r, "run", cfg))
    if stale:
        print(colorize("warn", "\nstale this boot (%d) -- launcher died, tool gone:" % len(stale)))
        for r in stale:
            print(fmt_row(r, "stl", cfg))
    if crashed:
        print(colorize("fail", "\ncrashed / from a previous boot (%d) -- restorable:" % len(crashed)))
        for r in crashed:
            print(fmt_row(r, "crx", cfg))
    if stale:
        print("  \033[2m(Hint: run 'crash-guard prune' to remove stale sentinels)\033[0m")
    if not (running or stale or crashed):
        print("  nothing tracked.")
    # Check data directory disk space if available
    try:
        st = os.statvfs(str(DATA_DIR))
        free_mb = st.f_frsize * st.f_bavail / 1048576
        if free_mb < 100:
            print("  \033[33m[WARN]\033[0m low disk space on data volume: ~%dMB free" % round(free_mb))
    except Exception:
        pass
    # Check if repo marker exists and hint about self-update
    if (CFG_DIR / ".crash-guard-repo").exists():
        print("  \033[2m(Update: run 'crash-guard self-update' to pull latest)\033[0m")
    return 0


def _last_restore_diagnostic():
    """Scan history for the most recent restore_done event and return a
    one-line diagnostic string, or empty string if none found."""
    if not HISTORY_FILE.exists():
        return ""
    last_restore = None
    last_start = None
    try:
        with HISTORY_FILE.open("r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    ev = json.loads(line)
                except Exception:
                    continue
                if ev.get("event") == "restore_done":
                    last_restore = ev
                elif ev.get("event") == "restore_start":
                    last_start = ev
    except Exception:
        pass
    if not last_restore:
        return ""
    ok = last_restore.get("ok", 0)
    total = last_restore.get("total", 0)
    backend = last_restore.get("backend", "?")
    system = last_restore.get("system") or {}
    avail = system.get("mem_avail_kb", 0)
    parts = []
    if total > 0:
        if ok == total:
            parts.append("restored %d/%d OK via %s" % (ok, total, backend))
        else:
            parts.append("restored %d/%d via %s (%d failed)" % (ok, total, backend, total - ok))
    if avail:
        avail_mb = avail / 1024
        if avail_mb < 500:
            parts.append("critically low memory before crash: ~%dMB available" % round(avail_mb))
        elif avail_mb < 2000:
            parts.append("low memory: ~%dMB available before restore" % round(avail_mb))
    return " ".join(parts)


def cmd_notify(args):
    """One-line, once-per-boot hint when crashed sessions exist. Login hook."""
    cur = boot_id()
    marker = DATA_DIR / (".notified-" + cur)
    if marker.exists() and not args.force:
        return 0
    recs = read_sentinels()
    _, _, crashed = classify(recs, cur)
    # Mark shown for this boot regardless, so later shells skip the check.
    try:
        ensure_dirs()
        marker.touch()
    except Exception:
        pass
    lines = []
    if crashed:
        lines.append(
            "\033[33mcrash-guard:\033[0m %d crashed session(s) from a previous "
            "boot -- run \033[1mcgr\033[0m to restore (\033[1mcgs\033[0m to preview)."
            % len(crashed)
        )
    # Append restore diagnostic if available
    diag = _last_restore_diagnostic()
    if diag:
        lines.append("  \033[2m%s\033[0m" % diag)
    if lines:
        sys.stdout.write("\n".join(lines) + "\n")
    return 0


def cmd_list(args):
    for r in read_sentinels():
        print(json.dumps({k: v for k, v in r.items() if k != "env"}))
    return 0


def cmd_prune(args):
    cur = boot_id()
    recs = read_sentinels()
    _, stale, _ = classify(recs, cur)
    for r in stale:
        try:
            Path(r["_path"]).unlink()
            print("pruned stale: %s %s" % (r.get("key"), r.get("cwd")))
        except Exception as e:
            sys.stderr.write("prune: %s\n" % e)
    if not stale:
        print("no stale sentinels.")
    return 0


def cmd_history(args):
    periods = boot_periods()
    if args.json:
        serial = [{
            "period": i,
            "boot_id": p["boot_id"],
            "start": p["start"].strftime("%Y-%m-%dT%H:%M:%S%z") if p.get("start") else "",
            "end": p["end"].strftime("%Y-%m-%dT%H:%M:%S%z") if p.get("end") else "",
            "records": p["records"],
            "recoverable": p["recoverable"],
            "closed": p["closed"],
            "running": p["running"],
        } for i, p in enumerate(periods, 1)]
        print(json.dumps(serial, indent=2))
        return 0
    if not periods:
        print("crash-guard: no history recorded.")
        return 0
    print_boot_periods(periods)
    if args.cass:
        # Show cass session context for all workspaces across all groups
        all_cwds = sorted(set(
            r.get("cwd")
            for p in periods
            for g in restore_groups(include_closed=True, boot_id=p["boot_id"], include_archived=True)
            for r in g["records"] if r.get("cwd")
        ))
        if all_cwds:
            print(colorize("bold", "\ncass session context:"))
            for cwd in all_cwds:
                summary = _cass_workspace_summary(cwd)
                if summary:
                    print("  %s" % colorize("muted", cwd))
                    print(summary)
                else:
                    print("  %s: %s" % (colorize("muted", cwd),
                                        colorize("muted", "\u2014 no cass sessions")))
            print("")
    if args.list or not sys.stdin.isatty():
        return 0
    opts = [
        "%s -> %s  records=%d recoverable=%d boot=%s" % (
            fmt_period_time(p.get("start")), fmt_period_time(p.get("end")),
            p["records"], p["recoverable"], short(p["boot_id"], 8))
        for p in periods
    ]
    try:
        idx = arrow_select(opts, "Select OS boot period:")
    except (KeyboardInterrupt, EOFError):
        print("\naborted.")
        return 1
    print("")
    period = periods[idx]
    groups = restore_groups(include_closed=True, boot_id=period["boot_id"], include_archived=True)
    print_restore_groups(groups)
    print("Restore from this period with: crash-guard restore --boot %s --group N" % period["boot_id"])
    return 0


def cmd_excise(args):
    ensure_dirs()
    cutoff = dt.datetime.now().astimezone() - dt.timedelta(days=args.older_than)

    # Count events without loading all into memory
    total_events = 0
    drop_count = 0
    keep_lines = []
    if HISTORY_FILE.exists():
        with HISTORY_FILE.open("r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                total_events += 1
                try:
                    ev = json.loads(line)
                    ev_time = parse_time(ev.get("at"))
                    if ev_time and ev_time < cutoff:
                        drop_count += 1
                    else:
                        keep_lines.append(line)
                except Exception:
                    # Keep malformed lines
                    keep_lines.append(line)

    archive_drop = []
    if ARCH_DIR.exists():
        for p in sorted(ARCH_DIR.glob("*.json")):
            if dt.datetime.fromtimestamp(p.stat().st_mtime, dt.datetime.now().astimezone().tzinfo) < cutoff:
                archive_drop.append(p)

    history_bytes = HISTORY_FILE.stat().st_size if HISTORY_FILE.exists() else 0
    archive_bytes = sum(p.stat().st_size for p in archive_drop)
    print("crash-guard excise dry-run")
    print("  cutoff: records older than %d day(s) (%s)" % (args.older_than, cutoff.strftime("%Y-%m-%d %H:%M:%S %z")))
    print("  history events affected: %d/%d" % (drop_count, total_events))
    print("  archive files affected: %d" % len(archive_drop))
    print("  history file size: %d bytes" % history_bytes)
    print("  archive bytes reclaimable: %d bytes" % archive_bytes)

    if not args.apply:
        print("\ndry-run only. Re-run with --apply to excise old history.")
        return 0

    phrase = input('\nType "%s" to confirm old session history removal: ' % EXCISE_PHRASE)
    if phrase != EXCISE_PHRASE:
        print("aborted; the ghosts keep their bunks.")
        return 1

    # Write kept lines to temp file, then atomic replace
    tmp = HISTORY_FILE.with_suffix(".jsonl.tmp-%d" % os.getpid())
    with tmp.open("w", encoding="utf-8") as f:
        for line in keep_lines:
            f.write(line + "\n")
    os.replace(str(tmp), str(HISTORY_FILE))
    for p in archive_drop:
        try:
            p.unlink()
        except Exception as e:
            sys.stderr.write("excise: failed to remove %s: %s\n" % (p, e))
    print("excised %d history event(s) and %d archive file(s)." % (drop_count, len(archive_drop)))
    return 0


def archive_sentinel(r):
    try:
        src = Path(r["_path"])
        if src.exists():
            ts = time.strftime("%Y%m%d-%H%M%S")
            dst = ARCH_DIR / ("%s.%s.json" % (src.stem, ts))
            # Compute session duration from launched_at to archive time
            launched = r.get("launched_at")
            dur = None
            if launched:
                lt = parse_time(launched)
                if lt:
                    dur = max(0, (dt.datetime.now(lt.tzinfo) - lt).total_seconds())
            extra = {"reason": r.get("_history_reason") or "restored", "archive_path": str(dst)}
            if dur is not None:
                extra["duration_secs"] = round(dur, 1)
            shutil.move(str(src), str(dst))
            append_history("archive", r, **extra)
    except Exception as e:
        sys.stderr.write("archive: %s\n" % e)


def select_group_records(groups, args):
    if args.from_archive:
        targets = read_archived_sentinels()
        # Skip ephemeral archive sessions (< 5s — test launches, missing commands)
        filtered = [r for r in targets if not r.get("_ephemeral")]
        skipped = len(targets) - len(filtered)
        if skipped:
            print("  (%d ephemeral archive session(s) filtered out)\n" % skipped)
        return filtered
    if not groups:
        return []
    if args.group:
        if not (1 <= args.group <= len(groups)):
            raise ValueError("group %d out of range" % args.group)
        records = groups[args.group - 1]["records"]
    elif args.yes or args.dry_run:
        records = groups[0]["records"]
    elif sys.stdin.isatty() and sys.stdout.isatty():
        args._history_prompted = True
        group_opts = [
            "%s  %d session(s)  %s" % (
                g.get("status") or "unknown",
                len(g["records"]),
                g["time"].strftime("%Y-%m-%d %H:%M:%S %z") if g.get("time") else "unknown",
            )
            for g in groups
        ]
        try:
            gi = arrow_select(group_opts, "Select recovery group (Enter = newest):")
        except (KeyboardInterrupt, EOFError):
            print("\naborted.")
            return []
        if gi is None:
            return []
        group_records = groups[gi]["records"]
        item_opts = ["all sessions in group %d" % (gi + 1)] + [
            "%s  %s" % (r.get("key", "?"), r.get("cwd", "?")) for r in group_records
        ]
        try:
            ii = arrow_select(item_opts, "Select session (Enter = all):")
        except (KeyboardInterrupt, EOFError):
            print("\naborted.")
            return []
        if ii is None:
            return []
        records = group_records if ii == 0 else [group_records[ii - 1]]
    else:
        args._history_prompted = True
        try:
            raw = input("Restore group/item [1]? (1, 2.1, 2.1,3.2, all, none): ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print("\naborted.")
            return []
        if raw in ("", "1"):
            records = groups[0]["records"]
        elif raw in ("none", "n", "no"):
            return []
        elif raw in ("all", "a"):
            records = [r for g in groups for r in g["records"]]
        else:
            picked = []
            for part in raw.replace(" ", "").split(","):
                if not part:
                    continue
                if "." in part:
                    graw, iraw = part.split(".", 1)
                    gi, ii = int(graw), int(iraw)
                    if 1 <= gi <= len(groups) and 1 <= ii <= len(groups[gi - 1]["records"]):
                        picked.append(groups[gi - 1]["records"][ii - 1])
                else:
                    gi = int(part)
                    if 1 <= gi <= len(groups):
                        picked.extend(groups[gi - 1]["records"])
            records = picked
    if args.item:
        picked = []
        for part in args.item.replace(" ", "").split(","):
            if not part:
                continue
            idx = int(part)
            if 1 <= idx <= len(records):
                picked.append(records[idx - 1])
        records = picked
    return records


def _print_restore_help():
    print("")
    print("  Commands:")
    print("    Y / Enter   — restore all sessions with current args")
    print("    n / no      — abort")
    print("    e / edit    — interactively edit extra arguments per session")
    print("    ? / help    — show this help")
    print("")


def _apply_args_from_cli(plan, cfg, spec):
    """Parse *spec* (e.g. ``1:--model gpt4``) and update *plan* argv.

    Multiple specs can be given by repeating ``--apply-args``.
    """
    if ":" not in spec:
        return
    idx_part, _, remainder = spec.partition(":")
    try:
        idx = int(idx_part) - 1   # 1-based → 0-based
    except ValueError:
        return
    if idx < 0 or idx >= len(plan):
        return
    tokens = shlex.split(remainder.strip())
    if tokens:
        plan[idx]["argv"] = tokens
    else:
        # No tokens → use base command (clear extras)
        item = plan[idx]
        prog = cfg.get("programs", {}).get(item["key"])
        if prog:
            plan[idx]["argv"] = list(prog.get("continue") or prog.get("resume_by_id") or [])
        else:
            rec_argv = (item.get("rec") or {}).get("argv") or []
            plan[idx]["argv"] = list(rec_argv) if rec_argv else None


def cmd_restore(args):
    ensure_dirs()
    cfg = load_config()
    cur = boot_id()
    # --batch implies auto-select group 1 and skip prompts
    if args.batch:
        if not args.group:
            args.group = 1
        args.yes = True
    # Unique restore_id for correlating all events in this invocation.
    # Full UUID (36 chars) — no collision risk across machines or time.
    try:
        restore_id = Path("/proc/sys/kernel/random/uuid").read_text().strip()
    except Exception:
        try:
            import uuid
            restore_id = str(uuid.uuid4())
        except Exception:
            restore_id = "fallback-%.0f-%d" % (time.time(), os.getpid())
    if args.from_archive:
        targets = read_archived_sentinels()
        # Skip ephemeral archive sessions (< 5s)
        filtered = [r for r in targets if not r.get("_ephemeral")]
        skipped = len(targets) - len(filtered)
        if skipped:
            print("  (%d ephemeral archive session(s) filtered out)\n" % skipped)
        targets = filtered
    else:
        # Default to current boot only (crashed from previous boot or stale this boot).
        # When --boot is not specified, use the current boot. This prevents accidentally
        # restoring sessions from many boots ago.
        effective_boot = args.boot if args.boot else cur
        groups = restore_groups(
            include_closed=args.include_closed,
            boot_id=effective_boot,
            include_archived=args.from_archive,
        )
        if args.list_groups:
            print_restore_groups(groups)
            return 0
        print_restore_groups(groups)
        try:
            targets = select_group_records(groups, args)
        except ValueError as e:
            sys.stderr.write("crash-guard: %s\n" % e)
            return 2
    if not targets:
        msg = "no archived sessions to restore" if args.from_archive else "no sessions to restore"
        print("crash-guard: %s." % msg)
        if not args.from_archive:
            print("  (try \033[1m--include-closed\033[0m for closed sessions,")
            print("   \033[1m--from-archive\033[0m for archived ones, or")
            print("   \033[1mcrash-guard history\033[0m to browse older boot periods)")
        if args.batch:
            return 1
        return 0

    plan = build_plan(targets, cfg, repair=args.repair)

    # --apply-args (CLI override, applied before showing the plan)
    if args.apply_args:
        for spec in args.apply_args:
            _apply_args_from_cli(plan, cfg, spec)

    # Inherit --yes into the history prompt when it was used for the login check.
    args._history_prompted = getattr(args, "_history_prompted", False)

    # Print the restore_id in the plan header so users can correlate
    # dry-run output to actual history events after the restore
    print("  restore_id: %s\n" % restore_id)
    print_detailed_plan(plan, cfg, detail=args.verbose)

    if args.dry_run:
        print("dry-run: nothing spawned.")
        return 0

    if not args.no_spawn:
        shell = os.environ.get("SHELL", "/bin/zsh")
        test_rc = subprocess.run([shell, "-lic", "command -v cg_run >/dev/null 2>&1"], capture_output=True).returncode
        if test_rc != 0:
            print(colorize("fail", "\nERROR: cg_run not found in shell environment."))
            print("The crash-guard shell integration must be sourced in your ~/.zshrc or ~/.bashrc:")
            print("  source ~/.config/crash-guard/crash-guard.sh")
            print("Then restart your shell or run: exec $SHELL")
            print("\nRun with --no-spawn to see the commands without executing.")
            return 2

    selected = plan
    if args.select:
        raw = input("Restore which? (e.g. 1,3-5 / all / none): ").strip().lower()
        if raw in ("none", "n", ""):
            print("aborted.")
            return 0
        if raw not in ("all", "a"):
            selected = _select(plan, raw)
    elif not args.yes and not args._history_prompted:
        prompt = ("Restore all %d session(s)? [Y/n/e/?] " % len(plan))
        # First time? show hint
        sys.stderr.write("  %s \033[2mY=yes  n=no  e=edit-args  ?=help\033[0m\n" % colorize("muted", "\u2014"))
        while True:
            ans = input(prompt).strip().lower()
            if ans in ("y", "yes", ""):
                break
            if ans in ("n", "no"):
                print("aborted.")
                return 0
            if ans in ("e", "edit", "a", "args"):
                plan = edit_plan_interactive(plan, cfg)
                selected = plan
                print_detailed_plan(plan, cfg, detail=args.verbose)
                prompt = "Restore all %d session(s) with updated args? [Y/n/?] " % len(plan)
                continue
            if ans in ("?", "help"):
                _print_restore_help()
                continue
            # unknown — re-prompt
            _print_restore_help()
            prompt = "Restore all %d session(s)? [Y/n/e/?] " % len(plan)

    if args.no_spawn:
        print("no-spawn: printing commands only.\n")
        for item in selected:
            if item["argv"]:
                print("cd %s && %s" % (item["cwd"], " ".join(item["argv"])))
        return 0

    backend, cli, note = resolve_terminal_backend(cfg, args.terminal or (cfg.get("terminal") or {}).get("backend", "auto"))
    if not cli:
        sys.stderr.write(
            "crash-guard: %s.\n"
            "Set terminal.backend or a per-terminal cli in %s, or run with --no-spawn.\n" % (note, CFG_FILE))
        return 2
    ctx = spawn_terminal_prepare(cfg, backend, cli)
    if ctx.get("error"):
        sys.stderr.write("crash-guard: %s.\n" % ctx["error"])
        return 2
    # Validate backend CLI works before spawning
    if backend == "wezterm":
        test = subprocess.run([cli, "cli", "list", "--format", "json"], capture_output=True, timeout=5)
        if test.returncode != 0:
            sys.stderr.write("crash-guard: wezterm CLI not responding (is WezTerm running?)\n")
            return 2
    elif backend == "kitty":
        test = subprocess.run([cli, "@", "ls"], capture_output=True, timeout=5)
        if test.returncode != 0:
            sys.stderr.write("crash-guard: kitty remote control not enabled (set 'allow_remote_control yes' in kitty.conf)\n")
            return 2
    elif backend == "ghostty":
        test = subprocess.run([cli, "--version"], capture_output=True, timeout=5)
        if test.returncode != 0:
            sys.stderr.write("crash-guard: ghostty not found or not working\n")
            return 2
    elif backend == "windows-terminal":
        test = subprocess.run([cli, "--help"], capture_output=True, timeout=5)
        if test.returncode != 0:
            sys.stderr.write("crash-guard: wt.exe not found or not working\n")
            return 2
    print("  -> terminal backend: %s (%s)\n" % (backend, ctx["label"]))
    print("  -> archiving old sentinel(s) and spawning fresh sessions (new inv_id per restore)")
    print("     (a new crash will find the new sessions, not the old archives)")
    if backend == "tmux" and not ctx.get("inside"):
        sess_name = ctx.get("session", "crash-guard-???")
        print("  -> tmux session \033[1m%s\033[0m will be created in detached mode." % sess_name)
        print("     After restore, attach with:  \033[1mtmux attach -t %s\033[0m" % sess_name)
        print("     (or use \033[1m--terminal ghostty\033[0m to open OS windows instead)\n")

    # Pre-spawn disk-space check: warn if < 10MB free on data volume
    try:
        st = os.statvfs(str(DATA_DIR))
        free_mb = st.f_frsize * st.f_bavail / 1048576
        if free_mb < 10:
            print("  %s critical: only ~%dMB free on data volume (%s)" % (
                colorize("fail", "DISK"), round(free_mb), DATA_DIR))
            print("  Restore may fail silently. Free space and run again,")
            print("  or use \033[1m--no-spawn\033[0m to preview without executing.")
    except Exception:
        pass

    # Log restore_start with system snapshot and plan details before spawning
    # — if the system crashes mid-restore we need evidence of what was attempted.
    plan_summary = []
    for s in selected:
        rec = s.get("rec") or {}
        plan_summary.append({
            "key": s["key"],
            "cwd": s.get("cwd", ""),
            "inv_id": rec.get("inv_id", ""),
            "argv": s.get("argv", []),
            "tier": s.get("tier", ""),
        })
    append_history(
        "restore_start", None,
        plan_count=len(selected),
        backend=backend,
        plan=plan_summary,
        system=_system_snapshot(),
        restore_id=restore_id,
        flush=True,
    )

    ok = 0
    ok_list = []
    fail_list = []
    spawn_delay = (cfg.get("restore") or {}).get("spawn_delay", 0.5)
    # Validate spawn_delay
    try:
        spawn_delay = float(spawn_delay)
        if spawn_delay < 0:
            spawn_delay = 0.5
        elif spawn_delay > 30:
            spawn_delay = 30.0
    except (ValueError, TypeError):
        spawn_delay = 0.5
    for i, item in enumerate(selected):
        if not item["argv"]:
            print("  skip %s (%s)" % (item["key"], item.get("note", "")))
            continue
        # Warn if the first command in the restore argv doesn't exist on PATH
        cmd_name = Path(item["argv"][0]).name if item["argv"] else ""
        if cmd_name and not shutil.which(cmd_name):
            print("  %s %s: command '%s' not found on PATH; spawning anyway" % (
                colorize("warn", "WARN"), item["key"], cmd_name))
        inner = build_inner(item, cfg)
        # Log each item before spawning for crash tracing
        append_history("restore_attempt", item["rec"], backend=backend, spawn_idx=i,
                        cmd=item.get("argv", []), restore_id=restore_id, flush=True)
        try:
            spawned, err = spawn_terminal(cfg, backend, cli, ctx, item, inner)
        except KeyboardInterrupt:
            print("\n  %s interrupted by user" % colorize("warn", "WARN"))
            # Don't archive unspawned sessions — they remain in live dir for next restore
            break
        # Fallback: if tmux fails and ghostty is available, try ghostty once
        if spawned is None and backend == "tmux" and shutil.which("ghostty"):
            print("  %s tmux failed, retrying with ghostty (new OS window)" % colorize("warn", "WARN"))
            ghostty_cli = shutil.which("ghostty")
            ghostty_ctx = {"label": "Ghostty window"}
            try:
                spawned, err = spawn_terminal(cfg, "ghostty", ghostty_cli, ghostty_ctx, item, inner)
            except KeyboardInterrupt:
                print("\n  %s interrupted by user" % colorize("warn", "WARN"))
                break
        if spawned is None:
            sys.stderr.write("  FAIL %s @ %s: %s\n" % (item["key"], item["cwd"], err))
            append_history("restore_fail", item["rec"], backend=backend, error=err, restore_id=restore_id, flush=True)
            fail_list.append("%s @ %s" % (item["key"], item["cwd"]))
            continue
        print("  ok   %s @ %s  (%s)" % (item["key"], item["cwd"], spawned))
        append_history("restore_ok", item["rec"], backend=backend, restore_id=restore_id, flush=True)
        if item["rec"].get("_path") and "/live/" in item["rec"].get("_path"):
            archive_sentinel(item["rec"])
        ok += 1
        ok_list.append("%s @ %s" % (item["key"], item["cwd"]))
        if i < len(selected) - 1 and spawn_delay > 0:
            time.sleep(spawn_delay)

    print("\nrestored %d/%d session(s)." % (ok, len(selected)))
    if args.batch and ok == 0:
        return 1
    if ok_list:
        print("  ok:   %s" % "; ".join(ok_list))
    if fail_list:
        print("  fail: %s" % "; ".join(fail_list))
    append_history(
        "restore_done", None,
        ok=ok, total=len(selected), backend=backend,
        system=_system_snapshot(),
        restore_id=restore_id,
        flush=True,
    )
    if backend == "tmux" and ok and ctx.get("inside"):
        attach_rc = tmux_attach(cli, ctx)
        if attach_rc != 0:
            return attach_rc
    return 0


def _select(plan, raw):
    idx = set()
    for part in raw.replace(" ", "").split(","):
        if "-" in part:
            a, b = part.split("-", 1)
            idx.update(range(int(a), int(b) + 1))
        elif part:
            idx.add(int(part))
    return [plan[i - 1] for i in sorted(idx) if 1 <= i <= len(plan)]


def cmd_init(args):
    created = write_default_config()
    ensure_dirs()
    if created:
        print("wrote default config: %s" % CFG_FILE)
    else:
        print("config already exists: %s" % CFG_FILE)
    print("data dir: %s" % DATA_DIR)
    print("\nNext: add the README shell integration block, then wrap launchers with cg_run.")
    return 0


def cmd_context(args):
    """Show a unified view: crash-guard sentinel status + cass session data for a path."""
    target = Path(args.path or os.getcwd()).resolve()
    print("crash-guard context for %s" % target)

    # ---- crash-guard sentinels ----
    recs = read_sentinels()
    cur = boot_id()
    running, stale, crashed = classify(recs, cur)

    print(colorize("bold", "\ncrash-guard:"))
    matching = [r for r in recs
                if Path(r.get("cwd", "")).resolve() == target]
    if matching:
        for r in matching:
            status = "running" if r in running else ("stale" if r in stale else "crashed")
            sc = {"running": "ok", "stale": "warn", "crashed": "fail"}.get(status, "muted")
            print("  %s %s %s  (pid %s, boot %s)" % (
                colorize(sc, "%-8s" % status),
                colorize("bold", r.get("key", "?")),
                r.get("cwd", "?"),
                r.get("shell_pid", "?"),
                short(r.get("boot_id", ""), 8),
            ))
    else:
        print("  %s no tracked sentinels for this path." % colorize("muted", "\u2014"))

    # ---- cass sessions ----
    if _cass_available():
        print(colorize("bold", "\ncass:"))
        sessions = _cass_workspace_sessions(str(target), limit=args.limit or 10)
        if sessions:
            for s in sessions:
                print(_cass_format_session(s))
        else:
            print("  %s no sessions indexed for this workspace." % colorize("muted", "\u2014"))
    else:
        print(colorize("bold", "\ncass:"))
        print("  %s cass binary not found on PATH." % colorize("muted", "\u2014"))
        print("  Install from https://github.com/ice-ninja/cass")

    return 0


def _cmd_check(args):
    """Run a self-test and report go/no-go status."""
    issues = []
    # Test 1: Python version
    v = sys.version_info
    if v.major < 3 or (v.major == 3 and v.minor < 8):
        issues.append("Python %d.%d is too old (3.8+ required)" % (v.major, v.minor))
    # Test 2: crash-guard binary integrity
    try:
        ensure_dirs()
        test_id = "check-%.0f-%d" % (time.time(), os.getpid())
        test_data = json.dumps({"test": True, "inv_id": test_id})
        atomic_write(LIVE_DIR / (test_id + ".json"), test_data)
        (LIVE_DIR / (test_id + ".json")).unlink()
    except Exception as e:
        issues.append("sentinel write test failed: %s" % e)
    # Test 3: History file readability
    try:
        if HISTORY_FILE.exists():
            with HISTORY_FILE.open("r", encoding="utf-8") as f:
                f.readline()
    except Exception as e:
        issues.append("history file read test failed: %s" % e)
    # Test 4: tmux availability
    tmux_ok = shutil.which("tmux") is not None
    # Test 5: Terminal detection
    term = os.environ.get("TERM_PROGRAM", "unknown")
    backend, _, _ = resolve_terminal_backend(load_config())

    status = "\033[32mGO\033[0m" if not issues else "\033[31mNO-GO\033[0m"
    print("crash-guard check: %s" % status)
    print("  Python:   %d.%d.%d" % (v.major, v.minor, v.micro))
    print("  Terminal: %s (backend: %s)" % (term, backend or "none"))
    print("  tmux:     %s" % ("\033[32mavailable\033[0m" if tmux_ok else "\033[33mnot found\033[0m"))
    print("  Data dir: %s" % DATA_DIR)
    for iss in issues:
        print("  \033[31m✗\033[0m %s" % iss)
    return 0 if not issues else 1


def _cmd_validate(args):
    """Validate the config file and report any issues."""
    issues = []
    if not CFG_FILE.exists():
        print("\033[32m✓\033[0m Config file: %s (using defaults)" % CFG_FILE)
        return 0
    try:
        raw = json.loads(CFG_FILE.read_text())
    except Exception as e:
        print("\033[31m✗\033[0m Config file: %s — parse error: %s" % (CFG_FILE, e))
        return 1
    print("\033[32m✓\033[0m Config file: %s (valid JSON)" % CFG_FILE)

    cfg = load_config()

    # Check terminal backend
    term = cfg.get("terminal") or {}
    backend = term.get("backend", "auto")
    if backend not in ("auto", "tmux", "wezterm", "kitty", "ghostty", "windows-terminal"):
        issues.append("terminal.backend='%s' is not a valid backend" % backend)

    # Check spawn_delay
    delay = (cfg.get("restore") or {}).get("spawn_delay", 0.5)
    if not isinstance(delay, (int, float)) or delay < 0 or delay > 30:
        issues.append("restore.spawn_delay=%s is out of range (0-30)" % delay)

    # Check programs
    progs = cfg.get("programs") or {}
    for name, prog in progs.items():
        if not isinstance(prog, dict):
            issues.append("programs.%s: expected dict, got %s" % (name, type(prog).__name__))
            continue
        if not prog.get("use_sentinel_argv") and not prog.get("continue") and not prog.get("resume_by_id"):
            issues.append("programs.%s: no continue or resume_by_id command defined" % name)

    # Check user hasn't accidentally deleted a default program entry
    raw_progs = raw.get("programs") or {}
    for key in DEFAULT_CONFIG.get("programs", {}):
        if key not in raw_progs:
            issues.append("programs.%s: missing from config (will use default)" % key)

    # Check unknown keys (top-level only)
    known = set(DEFAULT_CONFIG.keys())
    for key in raw:
        if key not in known:
            issues.append("unknown top-level key: '%s'" % key)

    # (List-key replacement vs merge is standard deep-merge behavior;
    #  terminal.order and env_patterns are intentionally replaced.)

    if issues:
        print("\nFound %d issue(s):" % len(issues))
        for iss in issues:
            print("  \033[33m[WARN]\033[0m %s" % iss)
        return 1
    print("\033[32m✓\033[0m No issues found.")
    return 0


def cmd_genid(args):
    try:
        print(Path("/proc/sys/kernel/random/uuid").read_text().strip())
    except Exception:
        import uuid
        print(str(uuid.uuid4()))
    return 0


cmd_uuid = cmd_genid  # alias for discoverability


def cmd_self_update(args):
    """Pull latest from git repo and reinstall crash-guard."""
    marker = CFG_DIR / ".crash-guard-repo"
    if not marker.exists():
        print("\033[31mNo repo marker found at %s\033[0m" % marker)
        print("  Run the installer from your cloned repo:")
        print("    git clone https://github.com/aaaronmiller/crash-guard ~/code/crash-guard")
        print("    cd ~/code/crash-guard && bash scripts/install.sh")
        return 1
    repo = marker.read_text().strip()
    if not Path(repo).exists():
        print("\033[31mRepo directory not found: %s\033[0m" % repo)
        return 1
    if not (Path(repo) / ".git").exists():
        print("\033[31mNot a git repository: %s\033[0m" % repo)
        return 1
    print("Updating crash-guard from %s ..." % repo)
    # Stash local changes, pull, reapply
    subprocess.run(["git", "-C", repo, "stash"], capture_output=True)
    pull = subprocess.run(
        ["git", "-C", repo, "pull", "--ff-only"],
        capture_output=True, text=True,
    )
    subprocess.run(["git", "-C", repo, "stash", "pop"], capture_output=True)
    if pull.returncode != 0:
        print("\033[31mgit pull failed:\033[0m")
        print(pull.stderr.strip())
        return 1
    if "Already up to date" in pull.stdout:
        print("Already up to date.")
        return 0
    print(pull.stdout.strip())
    # reinstall
    print("Reinstalling...")
    install = subprocess.run(
        ["bash", str(Path(repo) / "scripts" / "install.sh")],
        capture_output=True, text=True,
    )
    if install.returncode != 0:
        print("\033[31mInstall failed:\033[0m")
        print(install.stderr.strip())
        return 1
    print(install.stdout.strip())
    if install.stderr.strip():
        print(install.stderr.strip())
    # verify
    res = subprocess.run(["crash-guard", "--version"], capture_output=True, text=True)
    print("Now running: %s" % res.stdout.strip())
    print("\033[32mUpdate complete.\033[0m")
    return 0


def cmd_metrics(args):
    """Emit Prometheus text-format metrics from history + live sentinels.

    Designed to be scraped by Prometheus (either via a tiny HTTP endpoint
    wrapping this command, or via the ``prometheus_text`` format that
    node_exporter's textfile collector can consume).

    Usage:
        crash-guard metrics                  # print to stdout
        crash-guard metrics --watch 5        # print every 5 seconds (for HTTP serving)
    """
    cfg = load_config()
    cur = boot_id()

    def _prom_esc(v):
        """Escape a Prometheus label value: backslash, double-quote, newline."""
        return str(v).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")

    def _emit():
        lines = []
        ts = int(time.time())

        # ---- build info ----
        lines.append("# HELP crash_guard_build_info Build metadata for crash-guard")
        lines.append("# TYPE crash_guard_build_info gauge")
        lines.append('crash_guard_build_info{version="2.1.0",python="%s"} 1 %d' % (
            _prom_esc(sys.version.split()[0]), ts))

        # ---- live sentinel gauges ----
        live = read_sentinels()
        running, stale, crashed = classify(live, cur)
        lines.append("# HELP crash_guard_live_sessions Current tracked sessions by status")
        lines.append("# TYPE crash_guard_live_sessions gauge")
        for status_name, recs in [("running", running), ("stale", stale), ("crashed", crashed)]:
            lines.append('crash_guard_live_sessions{status="%s"} %d %d' % (_prom_esc(status_name), len(recs), ts))
        lines.append('crash_guard_live_sessions{status="total"} %d %d' % (len(live), ts))

        # ---- tool usage gauge ----
        tool_counts = {}
        for r in running + stale + crashed:
            k = r.get("key", "unknown")
            tool_counts[k] = tool_counts.get(k, 0) + 1
        lines.append("# HELP crash_guard_sessions_by_tool Live sessions by tool key")
        lines.append("# TYPE crash_guard_sessions_by_tool gauge")
        for k, c in sorted(tool_counts.items()):
            lines.append('crash_guard_sessions_by_tool{tool="%s"} %d %d' % (_prom_esc(k), c, ts))

        # ---- history event counters ----
        events = read_history_events()
        counters = {
            "start": 0, "stop": 0, "restore_ok": 0, "restore_fail": 0,
            "restore_attempt": 0, "archive": 0,
        }
        restore_by_backend = {}
        for ev in events:
            e = ev.get("event", "")
            if e in counters:
                counters[e] += 1
            if e in ("restore_ok", "restore_attempt", "restore_fail"):
                bk = ev.get("backend", "unknown")
                restore_by_backend.setdefault(e, {}).setdefault(bk, 0)
                restore_by_backend[e][bk] += 1

        lines.append("# HELP crash_guard_history_events_total Count of history events by type")
        lines.append("# TYPE crash_guard_history_events_total counter")
        for e, c in sorted(counters.items()):
            lines.append('crash_guard_history_events_total{event="%s"} %d %d' % (_prom_esc(e), c, ts))

        lines.append("# HELP crash_guard_restore_by_backend Restore events by backend")
        lines.append("# TYPE crash_guard_restore_by_backend counter")
        for ev_type, backends in sorted(restore_by_backend.items()):
            for bk, c in sorted(backends.items()):
                lines.append('crash_guard_restore_by_backend{result="%s",backend="%s"} %d %d' % (
                    _prom_esc(ev_type.replace("restore_", "")), _prom_esc(bk), c, ts))

        # ---- session duration summary from history ----
        durations = []
        for ev in events:
            dur = ev.get("duration_secs")
            if dur is not None:
                durations.append(dur)
        if durations:
            lines.append("# HELP crash_guard_session_duration_seconds Session lifetime from stop/archive events")
            lines.append("# TYPE crash_guard_session_duration_seconds gauge")
            sorted_d = sorted(durations)
            n = len(sorted_d)
            for p, label in [(50, "p50"), (90, "p90"), (95, "p95"), (99, "p99")]:
                idx = min(int(n * p / 100), n - 1)
                lines.append('crash_guard_session_duration_seconds{percentile="%s"} %d %d' % (label, sorted_d[idx], ts))
            lines.append('crash_guard_session_duration_seconds{percentile="max"} %d %d' % (sorted_d[-1], ts))

        # ---- system snapshot from last restore events ----
        for ev in reversed(events):
            snap = ev.get("system")
            if snap:
                lines.append("# HELP crash_guard_system_memory_kb Memory at last restore event")
                lines.append("# TYPE crash_guard_system_memory_kb gauge")
                avail = snap.get("mem_avail_kb")
                total = snap.get("mem_total_kb")
                if avail:
                    lines.append('crash_guard_system_memory_kb{type="available"} %d %d' % (avail, ts))
                if total:
                    lines.append('crash_guard_system_memory_kb{type="total"} %d %d' % (total, ts))
                procs = snap.get("user_procs")
                if procs:
                    lines.append("# HELP crash_guard_user_processes User process count at restore")
                    lines.append("# TYPE crash_guard_user_processes gauge")
                    lines.append('crash_guard_user_processes %d %d' % (procs, ts))
                break

        # ---- orphaned sentinel counter (crashed from prior boots) ----
        lines.append("# HELP crash_guard_crashed_sentinels_total Crashed sentinels from prior boots")
        lines.append("# TYPE crash_guard_crashed_sentinels_total gauge")
        lines.append('crash_guard_crashed_sentinels_total %d %d' % (len(crashed), ts))

        # ---- last crash detection timestamp ----
        if crashed:
            crash_tss = [parse_time(r.get("launched_at")) for r in crashed]
            crash_tss = [t for t in crash_tss if t is not None]
            if crash_tss:
                latest = max(crash_tss)
                lines.append("# HELP crash_guard_last_crash_detected_timestamp_seconds Unix epoch when last crashed sentinel was launched")
                lines.append("# TYPE crash_guard_last_crash_detected_timestamp_seconds gauge")
                lines.append('crash_guard_last_crash_detected_timestamp_seconds %d %d' % (latest.timestamp(), ts))

        # ---- last restore timestamp ----
        for ev in reversed(events):
            if ev.get("event") == "restore_done":
                at = ev.get("at", "")
                if at:
                    try:
                        from datetime import datetime as _dt
                        parsed = _dt.strptime(at[:19], "%Y-%m-%dT%H:%M:%S")
                        epoch = int(parsed.timestamp())
                        lines.append("# HELP crash_guard_last_restore_timestamp_seconds Unix epoch of last restore_done")
                        lines.append("# TYPE crash_guard_last_restore_timestamp_seconds gauge")
                        lines.append('crash_guard_last_restore_timestamp_seconds %d %d' % (epoch, ts))
                    except Exception:
                        pass
                break

        return "\n".join(lines) + "\n"

    if args.watch:
        import time as _time
        try:
            while True:
                sys.stdout.write(_emit())
                sys.stdout.write("\n")
                sys.stdout.flush()
                _time.sleep(args.watch)
        except KeyboardInterrupt:
            pass
    else:
        sys.stdout.write(_emit())
    return 0


def cmd_analytics(args):
    """Export structured analytics as JSON for web UI / Grafana integration.

    Outputs pre-computed statistics drawn from history, live sentinels, and
    archives. Designed to be consumed by the claude-code-proxy web interface
    or any analytics dashboard.

    Use ``--format prometheus`` to get Prometheus text format instead.
    """
    events = read_history_events()
    if args.preview:
        hist_size = HISTORY_FILE.stat().st_size if HISTORY_FILE.exists() else 0
        print("History file: %s (%d bytes)" % (HISTORY_FILE, hist_size))
        print("Events: %d" % len(events))
        print("Live sentinels: %d" % len(list(LIVE_DIR.glob("*.json"))))
        est_secs = max(0.1, len(events) * 0.002)  # ~2ms per event
        print("Estimated processing time: ~%.2fs" % est_secs)
        return 0
    if args.limit and args.limit > 0:
        events = events[-args.limit:]
    cfg = load_config()
    cur = boot_id()
    live = read_sentinels()
    running, stale, crashed = classify(live, cur)
    archived = read_archived_sentinels()

    analytics = {}

    # ---- session summary ----
    analytics["sessions"] = {
        "live": {"running": len(running), "stale": len(stale), "crashed": len(crashed), "total": len(live)},
        "archived": len(archived),
        "history_events": len(events),
    }

    # ---- per-tool breakdown ----
    tool_stats = {}
    for r in running + stale + crashed:
        k = r.get("key", "unknown")
        s = tool_stats.setdefault(k, {"running": 0, "stale": 0, "crashed": 0, "cwd": set()})
        if r in running:
            s["running"] += 1
        elif r in stale:
            s["stale"] += 1
        else:
            s["crashed"] += 1
        s["cwd"].add(r.get("cwd", ""))
    # Convert sets to counts for JSON
    for k, s in tool_stats.items():
        s["directories"] = len(s.pop("cwd"))
    analytics["tools"] = tool_stats

    # ---- time-series: events per day ----
    from collections import Counter
    from datetime import datetime as _dt
    day_counts = Counter()
    day_counts_by_type = {}
    for ev in events:
        at = ev.get("at", "")
        if at:
            day = at[:10]  # YYYY-MM-DD
            day_counts[day] += 1
            etype = ev.get("event", "unknown")
            if etype not in day_counts_by_type:
                day_counts_by_type[etype] = Counter()
            day_counts_by_type[etype][day] += 1
    analytics["events_per_day"] = sorted(({"date": d, "count": c} for d, c in day_counts.items()), key=lambda x: x["date"])
    analytics["events_per_day_by_type"] = {
        etype: sorted(({"date": d, "count": c} for d, c in counter.items()), key=lambda x: x["date"])
        for etype, counter in sorted(day_counts_by_type.items())
    }

    # ---- event type breakdown ----
    event_types = Counter(ev.get("event", "unknown") for ev in events)
    analytics["event_types"] = dict(event_types)

    # ---- event counts by boot ----
    boot_counts = Counter()
    for ev in events:
        rec = ev.get("record") or {}
        bid = rec.get("boot_id", "unknown") or "unknown"
        boot_counts[bid[:8]] += 1
    analytics["events_by_boot"] = sorted(({"boot": b, "count": c} for b, c in boot_counts.items()), key=lambda x: x["boot"])

    # ---- restore success/fail by backend ----
    restore_stats = {}
    for ev in events:
        e = ev.get("event", "")
        if e not in ("restore_ok", "restore_fail", "restore_attempt"):
            continue
        bk = ev.get("backend", "unknown")
        rs = restore_stats.setdefault(bk, {"attempts": 0, "ok": 0, "fail": 0})
        rs["attempts"] += 1
        if e == "restore_ok":
            rs["ok"] += 1
        elif e == "restore_fail":
            rs["fail"] += 1
    for bk, rs in restore_stats.items():
        if rs["attempts"] > 0:
            rs["success_rate"] = round(rs["ok"] / rs["attempts"] * 100, 1)
    analytics["restore_by_backend"] = restore_stats

    # ---- session duration percentiles ----
    durations = []
    for ev in events:
        dur = ev.get("duration_secs")
        if dur is not None:
            durations.append(dur)
    if durations:
        sorted_d = sorted(durations)
        n = len(sorted_d)
        analytics["session_duration_seconds"] = {
            "count": n,
            "min": sorted_d[0],
            "max": sorted_d[-1],
            "p50": sorted_d[min(int(n * 0.50), n - 1)],
            "p90": sorted_d[min(int(n * 0.90), n - 1)],
            "p95": sorted_d[min(int(n * 0.95), n - 1)],
            "p99": sorted_d[min(int(n * 0.99), n - 1)],
        }

    # ---- system snapshot summary (last known) ----
    for ev in reversed(events):
        snap = ev.get("system")
        if snap:
            analytics["last_system_snapshot"] = snap
            break

    # ---- ephemeral session ratio ----
    sessions = history_sessions()
    ephemeral_count = sum(1 for s in sessions.values() if s.get("_ephemeral"))
    total_known = sum(1 for s in sessions.values() if s.get("_duration_secs") is not None)
    analytics["ephemeral_ratio"] = {
        "ephemeral": ephemeral_count,
        "total_with_duration": total_known,
        "ratio": round(ephemeral_count / total_known, 3) if total_known > 0 else 0,
    }

    # ---- last restore timestamp (from most recent restore_done) ----
    for ev in reversed(events):
        if ev.get("event") == "restore_done":
            analytics["last_restore"] = {
                "at": ev.get("at", ""),
                "backend": ev.get("backend", ""),
                "ok": ev.get("ok", 0),
                "total": ev.get("total", 0),
                "restore_id": ev.get("restore_id", ""),
            }
            break

    # ---- boot periods summary ----
    periods = boot_periods()
    analytics["boot_periods"] = []
    for p in periods:
        analytics["boot_periods"].append({
            "boot_id": p["boot_id"][:8],
            "start": fmt_period_time(p.get("start")),
            "end": fmt_period_time(p.get("end")),
            "records": p["records"],
            "running": p["running"],
            "closed": p["closed"],
            "recoverable": p["recoverable"],
        })

    # ---- cwd concentration (optionally anonymized) ----
    cwd_counts = Counter()
    for r in live:
        cwd = r.get("cwd", "")
        cwd_counts[cwd] += 1
    cwd_list = [{"cwd": c, "sessions": n} for c, n in cwd_counts.most_common(20)]
    if args.anonymize_paths:
        home = str(Path.home())
        for item in cwd_list:
            if item["cwd"].startswith(home):
                item["cwd"] = "~" + item["cwd"][len(home):]
    analytics["cwd_concentration"] = cwd_list

    if args.output == "pretty":
        print(json.dumps(analytics, indent=2, default=str))
    else:
        print(json.dumps(analytics, default=str))
    return 0


def main():
    # Handle --version at the top level before argparse touches subparsers
    if len(sys.argv) == 2 and sys.argv[1] == "--version":
        print("crash-guard version 2.1.0")
        print("Python %s" % sys.version.split()[0])
        sys.exit(0)

    p = argparse.ArgumentParser(prog="crash-guard", description="WSL2 agentic session recovery")
    if len(sys.argv) == 1 or (len(sys.argv) > 1 and sys.argv[1].startswith("-") and sys.argv[1] not in ("-h", "--help")):
        sys.argv.insert(1, "restore")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start")
    s.add_argument("--key", required=True)
    s.add_argument("--inv-id", required=True)
    s.add_argument("--cwd", default="")
    s.add_argument("--shell-pid", type=int, default=0)
    s.add_argument("--name", default="",
                   help="human-readable session name (shown in restore groups)")
    s.add_argument("argv", nargs=argparse.REMAINDER)
    s.set_defaults(func=cmd_start)

    s = sub.add_parser("stop")
    s.add_argument("--inv-id", required=True)
    s.set_defaults(func=cmd_stop)

    s = sub.add_parser("status")
    s.add_argument("--json", action="store_true",
                   help="machine-readable JSON output")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("notify")
    s.add_argument("--force", action="store_true")
    s.set_defaults(func=cmd_notify)

    s = sub.add_parser("list")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("prune")
    s.set_defaults(func=cmd_prune)

    s = sub.add_parser("history")
    s.add_argument("--json", action="store_true")
    s.add_argument("--list", action="store_true",
                   help="list OS boot periods without interactive selection")
    s.add_argument("--cass", action="store_true",
                   help="enrich with cass session data for each workspace")
    s.set_defaults(func=cmd_history)

    s = sub.add_parser("context",
                       help="unified view: crash-guard sentinels + cass sessions for a path")
    s.add_argument("path", nargs="?", default=None,
                   help="directory path (default: current working directory)")
    s.add_argument("--limit", type=int, default=10,
                   help="max cass sessions to show per workspace (default: 10)")
    s.set_defaults(func=cmd_context)

    s = sub.add_parser("excise")
    s.add_argument("--older-than", type=int, default=365,
                   help="remove history/archive records older than this many days")
    s.add_argument("--apply", action="store_true",
                   help="actually rewrite history and remove old archive files after confirmation")
    s.set_defaults(func=cmd_excise)

    s = sub.add_parser("restore")
    s.add_argument("--yes", "-y", action="store_true")
    s.add_argument("--select", action="store_true")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--no-spawn", action="store_true")
    s.add_argument("--group", type=int, default=0,
                   help="restore recovery group N (run --list-groups to see groups)")
    s.add_argument("--boot", default="",
                   help="restore groups from a specific boot (run 'crash-guard history --list' to see boot IDs)")
    s.add_argument("--item", default="",
                   help="restore one or more item numbers from the selected group")
    s.add_argument("--list-groups", action="store_true",
                   help="list recovery groups without restoring")
    s.add_argument("--include-closed", dest="include_closed", action="store_true", default=False,
                   help="also include cleanly closed sessions in recovery groups")
    s.add_argument("--terminal", default=None,
                   choices=("auto", "tmux", "wezterm", "kitty", "ghostty", "windows-terminal", "wt"),
                   help="terminal backend for spawning restored sessions")
    s.add_argument("--verbose", action="store_true",
                   help="show full shell commands in plan (default: collapsed)")
    s.add_argument("--batch", action="store_true",
                   help="non-interactive mode: auto-confirm + group 1")
    s.add_argument("--repair", action="store_true",
                   help="repair truncated Claude/Codex session artifacts before resuming (backs up originals)")
    # --include-stale was intentionally removed: stale sessions from the
    # current boot are already included by default in restore groups.
    s.add_argument("--from-archive", action="store_true",
                   help="restore previously archived sentinel records")
    s.add_argument("--apply-args", action="append", default=None,
                   help="Override extra arguments for a session (e.g. 1:--model gpt4);"
                        " can be repeated")
    s.set_defaults(func=cmd_restore)

    s = sub.add_parser("init")
    s.set_defaults(func=cmd_init)

    s = sub.add_parser("metrics",
                       help="export Prometheus-formatted metrics for scraping")
    s.add_argument("--watch", type=int, default=0,
                   help="re-emit every N seconds (for HTTP serving)")
    s.set_defaults(func=cmd_metrics)

    s = sub.add_parser("analytics",
                       help="export structured analytics as JSON")
    s.add_argument("--output", choices=("json", "pretty"), default="json",
                   help="output format: json (compact) or pretty (indented)")
    s.add_argument("--limit", type=int, default=0,
                   help="max history events to process (0 = unlimited)")
    s.add_argument("--preview", action="store_true",
                   help="show history file size and estimated processing time before querying")
    s.add_argument("--anonymize-paths", action="store_true",
                   help="replace home directories with ~/ in path fields")
    s.set_defaults(func=cmd_analytics)

    s = sub.add_parser("check",
                       help="run self-test and report go/no-go status")
    s.set_defaults(func=_cmd_check)

    s = sub.add_parser("validate",
                       help="validate config and report any issues")
    s.set_defaults(func=_cmd_validate)

    s = sub.add_parser("self-update",
                       help="pull latest from git repo and reinstall")
    s.set_defaults(func=cmd_self_update)

    s = sub.add_parser("uuid", help="generate a UUID (utility)")
    s.set_defaults(func=cmd_uuid)

    s = sub.add_parser("genid", help="alias for uuid (deprecated)")
    s.set_defaults(func=cmd_uuid)

    args = p.parse_args()
    # strip a leading "--" left in REMAINDER for start
    if getattr(args, "argv", None) and args.argv and args.argv[0] == "--":
        args.argv = args.argv[1:]
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
