# -- boots and processes -----------------------------------------------------

def current_boot():
    """(start epoch, boot_id) of the running kernel."""
    btime = 0
    try:
        with open("/proc/stat") as fh:
            for line in fh:
                if line.startswith("btime "):
                    btime = int(line.split()[1])
                    break
    except OSError:
        pass
    try:
        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        boot_id = ""
    return btime, boot_id


def boot_start():
    """(start epoch, boot_id) of the running kernel, as first read this boot.

    btime is the wall clock minus uptime, and the two drift apart: in WSL it
    read 18 minutes early 12 hours into a boot (2026-10-10). Read that late,
    sessions busy just before a crash would count as this boot's. The watcher
    starts with the boot, so its reading is kept per boot id and reused.
    """
    btime, boot_id = current_boot()
    path = watch_dir() / ("boot-%s" % boot_id)
    try:
        return int(read_own(path)), boot_id
    except (OSError, ValueError):
        pass
    try:
        private_dir(STATE)
        private_dir(watch_dir())
        write_private(path, "%d\n" % btime)
    except OSError:
        pass
    return btime, boot_id


def previous_boot_start(btime):
    """When the boot before this one began, from wtmp.

    Every process alive when that boot ended was started inside it, so this is
    the floor for "running when the machine went down". wtmp stamps a WSL boot
    a minute or two after the kernel's btime, hence the margin.
    """
    starts = []
    try:
        data = WTMP.read_bytes()
    except OSError:
        data = b""
    for off in range(0, len(data) - UTMP.size + 1, UTMP.size):
        rec = UTMP.unpack_from(data, off)
        if rec[0] == BOOT_TIME:
            starts.append(rec[9])
    earlier = [s for s in starts if s < btime - 60]
    return max(earlier) if earlier else btime - 86400


def boot_periods():
    """Boot intervals with actual shutdowns, or an end inferred from the next boot.

    Watcher markers supply stable kernel start times and ids; wtmp supplies
    historical starts and shutdowns. Only the shutdown inside an interval
    belongs to that boot. `last` can misleadingly pair a crash with a later
    boot's shutdown when used without this interval check.
    """
    btime, boot_id = boot_start()
    starts, shutdowns = set(), set()
    try:
        data = WTMP.read_bytes()
    except OSError:
        data = b""
    for off in range(0, len(data) - UTMP.size + 1, UTMP.size):
        rec = UTMP.unpack_from(data, off)
        if rec[0] == BOOT_TIME:
            starts.add(rec[9])
        elif rec[0] == 1 and rec[4].rstrip(b"\0") == b"shutdown":
            shutdowns.add(rec[9])
    markers = {boot_id: btime}
    for f in watch_dir().glob("boot-*"):
        try:
            markers[f.name[5:]] = int(read_own(f))
        except (OSError, ValueError):
            continue
    ids = {}
    for bid, began in sorted(markers.items(), key=lambda kv: kv[1]):
        close = [t for t in starts if abs(t - began) < 300 and t not in ids]
        matched = min(close, key=lambda t: abs(t - began)) if close else None
        if matched is not None:
            starts.discard(matched)
        starts.add(began)
        ids[began] = bid
    times = sorted(starts)
    out = []
    for i, began in enumerate(times):
        next_start = times[i + 1] if i + 1 < len(times) else None
        ends = [t for t in shutdowns if began <= t and (next_start is None or t < next_start)]
        ended = min(ends) if ends else next_start
        out.append({"boot": ids.get(began) or "wtmp-%d" % began, "start": began,
                    "end": ended, "end_kind": "normal shutdown" if ends else
                    "crash (end inferred from next boot)" if next_start else "running"})
    return out


def ended_with_agents(boot_id):
    """The watcher's set held an agent when that boot ended, or `cgr --save` ran in it."""
    try:
        if any(session_record(r) for r in json.loads(read_own(watch_dir() / ("live-%s.json" % boot_id)))):
            return True
    except (OSError, ValueError):
        pass
    try:
        return any(session_record(s) and s.get("boot") == boot_id
                   for s in json.loads(read_own(saved_path())).get("sessions") or [])
    except (OSError, ValueError, AttributeError):
        return False


def crash_boot_start(btime, boot_id):
    """When the boot that went down with your agents began.

    Usually the boot before this one. But WSL can boot again and idle out
    before you look: on 2026-10-13 its own update stopped the VM at 05:05 with
    six agents running, started it at 05:06 to finish, and let it idle out at
    05:12, so the boot before this one was five empty minutes. A boot the
    watcher saw end with no agent running and nothing saved is stepped over to
    the one before it; a boot it did not see is not.
    """
    empty = []
    for f in watch_dir().glob("boot-*"):
        if f.name[5:] != boot_id and not ended_with_agents(f.name[5:]):
            try:
                empty.append(int(read_own(f)))
            except (OSError, ValueError):
                pass
    start = previous_boot_start(btime)
    for _ in empty:
        if not any(abs(start - began) < 300 for began in empty):  # wtmp stamps a boot late
            break
        start = previous_boot_start(start)
    return start


def proc_stat(pid):
    """(ppid, session id, tty_nr, start ticks) of a live process, or None.

    A zombie counts as dead: a closed window's shell can sit unreaped for a
    moment, and it is no longer at any prompt.
    """
    try:
        f = Path("/proc/%d/stat" % int(pid)).read_text().rsplit(")", 1)[1].split()
    except (OSError, TypeError, ValueError, IndexError):
        return None
    if f[0] in ("Z", "X"):
        return None
    return int(f[1]), int(f[3]), int(f[4]), f[19]


def proc_ticks(pid):
    st = proc_stat(pid)
    return st[3] if st else None


def proc_argv(pid):
    try:
        raw = Path("/proc/%d/cmdline" % int(pid)).read_bytes()
    except (OSError, TypeError, ValueError):
        return []
    return [a.decode("utf-8", "replace") for a in raw.split(b"\0") if a]


def alive(pid, ticks):
    return ticks is not None and proc_ticks(pid) == ticks


def mine(pid):
    """A process of this account. Another account chooses its own argv
    (`claude --mcp-config=...`), and reopening it would run that as you."""
    try:
        return os.stat("/proc/%d" % int(pid)).st_uid == ME
    except (OSError, TypeError, ValueError):
        return False


def read_own(path):
    """A state file's text, only if this account owns it: a typed line in it
    runs as a shell command when its session is reopened."""
    with open(path) as fh:
        if os.fstat(fh.fileno()).st_uid != ME:
            raise OSError("%s: owned by another account" % path)
        return fh.read()


def harness_of(argv):
    """(harness, index of its word in argv) for an interactive agent, else None."""
    i = 0
    if argv and INTERPRETERS.match(os.path.basename(argv[0])):
        if len(argv) > 1 and argv[1] == "-c":
            return None  # `sh -c '...'`: a command string, not a script
        i = 1
        while i < len(argv) and argv[i].startswith("-"):
            i += 1
    if i >= len(argv):
        return None
    name = re.sub(r"\.(c?js|mjs|py)$", "", os.path.basename(argv[i]))
    if name not in HARNESSES:
        # npm entrypoints can be cli.js or cli-entry.js. Only recognized
        # package paths identify those; an arbitrary cli.js is not an agent.
        path = Path(argv[i]).as_posix()
        if "/@earendil-works/pi-coding-agent/" in path and name == "cli":
            name = "pi"
        elif "/@qwen-code/qwen-code/" in path and name == "cli-entry":
            name = "qwen"
    if name not in HARNESSES:
        return None
    rest = argv[i + 1:]
    flags = {a.split("=", 1)[0] for a in rest if a.startswith("-")}
    if flags & ({"--version", "-v", "-V", "--help", "-h"} |
                HEADLESS_FLAGS.get(name, {"-p", "--print"})):
        return None
    first, owned, many = None, False, False
    values = VALUE_FLAGS.get(name, set()) | HARNESSES[name][2] | PROMPT_FLAGS.get(name, set())
    for a in rest:
        if a.startswith("-"):
            flag = a.split("=", 1)[0]
            owned = "=" not in a and flag in values
            many = owned and flag in MULTI_VALUE_FLAGS.get(name, set())
        elif owned:
            owned = many
        else:
            first = a
            break
    if first in NON_SESSION_COMMANDS.get(name, NOT_A_SESSION):
        return None
    if name == "qwen" and first is not None and not flags & {"-i", "--prompt-interactive"}:
        return None  # its positional query is one-shot; -i explicitly stays interactive
    return name, i


def session_record(rec):
    """Recheck old watcher and save records under today's CLI classification."""
    return isinstance(rec, dict) and (not rec.get("argv") or harness_of(rec["argv"]) is not None)


# -- what you typed ------------------------------------------------------------

def history(size=1 << 20):
    """[(epoch, command line)] from the end of the zsh history, oldest first."""
    path = Path(os.environ.get("HISTFILE") or HOME / ".zsh_history").expanduser()
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - size))
            raw = fh.read()
    except OSError:
        return []
    if b"\x83" in raw:  # zsh "metafies" bytes >= 0x83 as 0x83, byte ^ 0x20
        out, it = bytearray(), iter(raw)
        for b in it:
            out.append((next(it, 0x20) ^ 0x20) if b == 0x83 else b)
        raw = bytes(out)
    entries = []
    for line in raw.decode("utf-8", "replace").split("\n"):
        m = re.match(r": (\d+):\d+;(.*)$", line)
        if m:
            entries.append([int(m.group(1)), m.group(2)])
        elif entries and entries[-1][1].endswith("\\"):
            entries[-1][1] = entries[-1][1][:-1] + "\n" + line
    return [(t, c) for t, c in entries]


def aliases():
    """{name: expansion} from the alias lines in your zsh startup files."""
    out = {}
    for name in (".zshrc", ".zsh_aliases"):
        try:
            text = (HOME / name).read_text(errors="replace")
        except OSError:
            continue
        for m in re.finditer(r"^\s*alias\s+([\w.+-]+)=(.*)$", text, re.M):
            try:
                words = shlex.split(m.group(2), comments=True)
            except ValueError:
                continue
            if words:
                out[m.group(1)] = words[0]
    return out


def words_of(text):
    try:
        return shlex.split(text)
    except ValueError:
        return None


def segments(line):
    return [s.strip() for s in re.split(r"&&|\|\||;|\n", line) if s.strip()]


def head_word(words):
    """Index of the command word, past any VAR=value assignments."""
    i = 0
    while i < len(words) - 1 and re.match(r"[A-Za-z_]\w*=", words[i]):
        i += 1
    return i


def harness_in(line, amap):
    """The harness the last command of a typed line starts, directly or via an alias."""
    segs = segments(line)
    words = words_of(segs[-1]) if segs else None
    if not words:
        return None
    word = words[head_word(words)]
    if os.path.basename(word) in HARNESSES:
        return os.path.basename(word)
    found = [os.path.basename(w) for w in (words_of(amap.get(word, "")) or [])
             if os.path.basename(w) in HARNESSES]
    return found[-1] if found else None


def typed_for(harness, started, hist, amap, argv=None):
    """The command line typed to start `harness` at `started`, from zsh history.

    zsh writes the entry when the command starts, so it sits a moment before
    the process does -- longer when an alias starts a proxy first.
    """
    best = None
    for t, line in hist:
        if started - 300 <= t <= started + 5 and harness_in(line, amap) == harness:
            if argv and not launch_matches(harness, line, argv, amap):
                continue
            best = line  # oldest first, so the last match is the closest
    return best


def launch_matches(harness, line, argv, amap):
    """History may supply options only when they match the actual process.

    An inherited CGR_LAUNCH bypasses history. For a missing launch line, do
    not borrow the model or proxy options of an unrelated earlier invocation.
    """
    words = words_of(segments(line)[-1]) or []
    if not words:
        return False
    at = head_word(words)
    expanded = (words_of(amap.get(words[at], "")) or [words[at]]) + words[at + 1:]
    places = [i for i, w in enumerate(expanded) if os.path.basename(w) == harness]
    hit = harness_of(argv)
    if not places or not hit:
        return False
    strip = HARNESSES[harness][2] | PROMPT_FLAGS.get(harness, set())
    return strip_args(expanded[places[-1] + 1:], strip, harness) == \
        strip_args(argv[hit[1] + 1:], strip, harness)


def launch_env(pid):
    """CGR_LAUNCH from a process environment: the typed line cgr reopened it with."""
    try:
        raw = Path("/proc/%d/environ" % pid).read_bytes()
    except OSError:
        return None
    for kv in raw.split(b"\0"):
        if kv.startswith(b"CGR_LAUNCH="):
            return kv[11:].decode("utf-8", "replace") or None
    return None


# -- the watcher -------------------------------------------------------------

def watch_dir():
    return STATE / "watch"


def private_dir(path):
    """Owner-only, like history.jsonl: cgr's state holds argv, cwds and typed
    command lines. The chmod repairs a directory made before this rule."""
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path, 0o700)


def write_private(path, text, append=False):
    """Write a state file owner-only, repairing one created before the rule.
    Explicit modes rather than a umask, which tabs cgr opens would inherit."""
    flags = os.O_WRONLY | os.O_CREAT | (os.O_APPEND if append else os.O_TRUNC)
    with os.fdopen(os.open(path, flags, 0o600), "a" if append else "w") as fh:
        os.fchmod(fh.fileno(), 0o600)
        fh.write(text)


class Watcher:
    """Tracks agents on terminals; records the ones whose terminal died with them."""

    def __init__(self):
        private_dir(STATE)
        private_dir(watch_dir())
        for f in watch_dir().iterdir():
            os.chmod(f, 0o600)  # files written before the owner-only rule
        self.boot = boot_start()[1]
        self.known = set()   # pids already looked at
        self.agents = {}     # pid -> record
        self.pending = {}    # agent gone, shell alive: asked once more next scan
        self.live = watch_dir() / ("live-%s.json" % self.boot)
        self.deaths = watch_dir() / "deaths.jsonl"
        try:  # what an earlier run saw at launch: dated then, not re-dated from an age
            self.seen = {(r["pid"], r["ticks"]): r for r in json.loads(read_own(self.live))}
        except (OSError, ValueError, TypeError, KeyError):
            self.seen = {}

    def scan(self):
        now = time.time()
        pids = {int(p) for p in os.listdir("/proc") if p.isdigit()}
        changed = False
        due, self.pending = self.pending, {}
        for rec in due.values():
            if not alive(rec["leader"], rec["leader_ticks"]):
                self.died(rec, now)
        for pid, rec in list(self.agents.items()):
            if pid in pids and alive(pid, rec["ticks"]):
                changed |= self.refresh(rec)
                continue
            del self.agents[pid]
            changed = True
            if rec["leader"] == pid:
                continue  # it owned its own terminal: no shell to ask
            if alive(rec["leader"], rec["leader_ticks"]):
                self.pending[pid] = rec  # in case the shell is mid-hangup
            else:
                self.died(rec, now)
        for pid in sorted(pids - self.known):
            self.known.add(pid)
            rec = self.consider(pid)
            if rec:
                self.agents[pid] = rec
                changed = True
        self.known &= pids
        if changed:
            self.write_live()

    def consider(self, pid):
        st = proc_stat(pid)
        if not st or st[2] == 0 or not mine(pid):
            return None  # gone already, no terminal (a daemon or a pipe), or not ours
        argv = proc_argv(pid)
        hit = harness_of(argv)
        if not hit:
            return None
        parent = st[0]
        for _ in range(40):  # only the outermost agent on this terminal is a session
            pst = proc_stat(parent)
            if not pst or pst[1] != st[1]:
                break  # past the terminal's shell: another tab or pane is its own session
            if parent in self.agents or harness_of(proc_argv(parent)):
                return None
            parent = pst[0]
        old = self.seen.pop((pid, st[3]), {})
        # btime as of now: one read when the watcher started slides with the clock.
        started = old.get("started") or current_boot()[0] + int(st[3]) / HZ
        try:
            cwd = os.readlink("/proc/%d/cwd" % pid)
        except OSError:
            cwd = ""
        rec = {"pid": pid, "ticks": st[3], "started": started, "harness": hit[0],
               "argv": argv, "cwd": cwd, "leader": st[1], "leader_ticks": proc_ticks(st[1]),
               "boot": self.boot, "session": None,
               "typed": old.get("typed") or launch_env(pid)
               or typed_for(hit[0], started, history(), aliases(), argv)}
        self.refresh(rec)
        return rec

    def refresh(self, rec):
        """Claude names its session in its pid file; keep up with /clear and /resume."""
        if rec["harness"] != "claude":
            return False
        try:
            sid = json.loads((HOME / ".claude" / "sessions" / ("%d.json" % rec["pid"]))
                             .read_text()).get("sessionId")
        except (OSError, ValueError):
            return False
        if sid and sid != rec["session"]:
            rec["session"] = sid
            return True
        return False

    def died(self, rec, now):
        write_private(self.deaths, json.dumps(dict(rec, died=now)) + "\n", append=True)

    def write_live(self):
        tmp = self.live.with_suffix(".tmp")
        write_private(tmp, json.dumps(list(self.agents.values())))
        os.replace(tmp, self.live)

    def prune(self):
        cutoff = time.time() - KEEP_DAYS * 86400
        for f in list(watch_dir().glob("live-*.json")) + list(watch_dir().glob("boot-*")):
            if mtime(f) < cutoff:
                f.unlink()
        try:
            lines = self.deaths.read_text().splitlines()
        except OSError:
            return
        keep = [l for l in lines if (json.loads(l).get("died") or 0) >= cutoff]
        if len(keep) != len(lines):
            write_private(self.deaths, "".join(l + "\n" for l in keep))


def refresh_index():
    """`cgr --history` in a low-priority child, so the scan loop never waits on it."""
    return subprocess.Popen([sys.executable, os.path.realpath(__file__), "--history", "--json"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True, preexec_fn=lambda: os.nice(10))


def watch(interval=2.0):
    w = Watcher()
    w.prune()
    write_private(watch_dir() / "watch.pid", "%d\n%s\n" % (os.getpid(), w.boot))
    # sessions.db once a day, before the harnesses prune their old sessions
    # (Claude Code's default is 30 days); first look ten minutes in, clear of the boot.
    check, child = time.time() + 600, None
    while True:
        try:
            w.scan()
            if child is not None and child.poll() is not None:
                child = None
            if child is None and time.time() >= check:
                check = time.time() + 3600
                if mtime(db_path()) < time.time() - 86400:
                    child = refresh_index()
        except Exception as e:  # one bad /proc read must not stop the watcher
            print("cgr --watch: %r" % e, file=sys.stderr, flush=True)
        time.sleep(interval)


def watcher_running(boot_id):
    try:
        pid, boot = (watch_dir() / "watch.pid").read_text().split()[:2]
    except (OSError, ValueError):
        return False
    return boot == boot_id and "--watch" in proc_argv(int(pid))


def watched(boot_id, since, boot_since=None):
    """Agents the watcher saw die: alive at the end of an earlier boot, or
    gone together with their shell."""
    out = []
    periods = {p["boot"]: p for p in boot_periods()}
    for f in watch_dir().glob("live-*.json"):
        bid = f.stem[5:]
        period = periods.get(bid)
        ended = (period or {}).get("end") or mtime(f)
        if bid == boot_id or ended < since or (period and boot_since is not None
                                               and period["start"] < boot_since):
            continue
        try:
            recs = json.loads(read_own(f))
        except (OSError, ValueError):
            continue
        out += [dict(r, boot=bid, how="machine went down", last=ended,
                     boot_end=(period or {}).get("end")) for r in recs
                if session_record(r)]
    try:
        lines = read_own(watch_dir() / "deaths.jsonl").splitlines()
    except OSError:
        lines = []
    for line in lines:
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if session_record(r) and r.get("died", 0) >= since:
            out.append(dict(r, how="window closed", last=r["died"]))
    return out


# -- reading transcripts -----------------------------------------------------

def tail(path, size=262144):
    """Records from the end of a JSONL file, newest first."""
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - size))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return
    for line in reversed(lines):
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if isinstance(rec, dict):
            yield rec


# session_exit reasons that mean the session did not choose to end: claude's
# SessionEnd says "other" on SIGHUP, omp names the signal.
CUT_EXITS = {"other": "window closed", "sighup": "window closed", "sigterm": "killed"}


def session_exit_reason(rec):
    """The reason a session_exit record names. omp nests the signal under
    `data` (`{"data": {"reason": "sighup"}}`), claude's hook writes it flat,
    and a harness may flatten `data` to the reason string itself."""
    data = rec.get("data")
    if isinstance(data, dict):
        data = data.get("reason")
    return rec.get("reason") or (data if isinstance(data, str) and data else None) or "unknown"


def exit_reason(path):
    """The reason on a session_exit that follows the last message, else None."""
    for rec in tail(path):
        if rec.get("customType") == "session_exit":
            return session_exit_reason(rec)
        if rec.get("type") in ("user", "assistant", "message"):
            return None
    return None


def prompt_text(rec):
    if rec.get("type") == "title" and isinstance(rec.get("title"), str):
        return rec["title"]  # omp keeps a running title as its first record
    msg = rec.get("message")
    if rec.get("isMeta") or not isinstance(msg, dict) or msg.get("role") != "user":
        return ""
    text = msg.get("content")
    if isinstance(text, list):
        text = " ".join(b.get("text", "") for b in text
                        if isinstance(b, dict) and b.get("type") == "text")
    if not isinstance(text, str):
        return ""
    text = " ".join(text.split())
    return "" if text.startswith(("<", "Caveat:", "[Request interrupted")) else text


def head(path, limit=300):
    """(entrypoint, cwd, first prompt) from the start of a transcript."""
    entry = cwd = None
    title = ""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i >= limit or (entry and cwd and title):
                    break
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if isinstance(rec, dict):
                    entry = entry or rec.get("entrypoint")
                    cwd = cwd or rec.get("cwd")
                    title = title or prompt_text(rec)
    except OSError:
        pass
    return entry, cwd, title


def mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0.0


def session(harness, sid, cwd, last, how, title, started=None):
    return {"harness": harness, "id": sid, "cwd": cwd or str(HOME), "last": last, "how": how,
            "title": title or "", "started": started, "typed": None, "argv": None}


# -- claude ------------------------------------------------------------------

def claude_pids(btime):
    """Session ids with a live process, and pid files whose process is gone."""
    live, dead = set(), {}
    for f in (HOME / ".claude" / "sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        sid = d.get("sessionId")
        if not sid or d.get("entrypoint", "cli") != "cli":
            continue  # sdk-cli / sdk-py are `claude -p` and SDK runs, not terminals
        ticks = d.get("procStart")
        started = (d.get("startedAt") or 0) / 1000
        if started >= btime - 5 and (proc_ticks(d.get("pid")) == str(ticks) if ticks
                                     else os.path.exists("/proc/%s" % d.get("pid"))):
            live.add(sid)
        else:
            dead[sid] = d
    return live, dead


def claude(since, btime, live, dead):
    out = []
    for path in glob.glob(str(HOME / ".claude" / "projects" / "*" / "*.jsonl")):
        last, sid = mtime(path), Path(path).stem
        if last < since or sid in live:
            continue
        reason = exit_reason(path)
        if reason in CUT_EXITS:
            how = CUT_EXITS[reason]
        elif reason is None and sid in dead:
            how = "machine went down" if last < btime else "killed"
        else:
            continue  # closed on purpose, or no evidence either way
        entry, cwd, title = head(path)
        if entry not in (None, "cli") or not title:
            continue
        pid = dead.get(sid, {})
        out.append(session("claude", sid, pid.get("cwd") or cwd, last, how, title,
                           (pid.get("startedAt") or 0) / 1000 or None))
    return out


def claude_transcript(sid):
    found = glob.glob(str(HOME / ".claude" / "projects" / "*" / (sid + ".jsonl")))
    return found[0] if found else None


def claude_in(cwd, since, live, taken, until=None):
    """Newest claude session in `cwd` touched since `since` that nobody holds."""
    d = HOME / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)
    for path in sorted(d.glob("*.jsonl"), key=mtime, reverse=True):
        last, sid = mtime(path), path.stem
        if last < since:
            break
        if until is not None and last > until:
            continue
        reason = exit_reason(path)
        if sid in live or ("claude", sid) in taken or not (reason is None or reason in CUT_EXITS):
            continue
        entry, _, title = head(path)
        if entry in (None, "cli") and title:
            return sid, last, title
    return None


# -- codex -------------------------------------------------------------------

INTERACTIVE = ("source NOT IN ('exec', 'mcp') AND source NOT LIKE '{%' "
               "AND COALESCE(thread_source, '') != 'subagent' AND archived = 0")


def codex_db(pattern):
    found = glob.glob(str(HOME / ".codex" / pattern))
    return max(found, key=lambda p: int(re.sub(r"\D", "", Path(p).stem) or 0)) if found else None


def ro(path):
    return sqlite3.connect("file:%s?mode=ro" % path, uri=True, timeout=2)


def codex_threads(where, params):
    db = codex_db("state_*.sqlite")
    if not db:
        return []
    try:
        con = ro(db)
        try:
            return con.execute("SELECT id, cwd, title, updated_at, created_at FROM threads WHERE "
                               + INTERACTIVE + " AND " + where + " ORDER BY updated_at DESC",
                               params).fetchall()
        finally:
            con.close()
    except sqlite3.Error:
        return []


def codex(since, btime):
    logs = codex_db("logs_*.sqlite")
    if not logs:
        return []
    out = []
    try:
        con = ro(logs)
    except sqlite3.Error:
        return out
    try:
        for tid, cwd, title, _, created in codex_threads("updated_at >= ?", (since,)):
            last, ended = con.execute(
                "SELECT MAX(ts), MAX(CASE WHEN feedback_log_body LIKE '%Agent loop exited%' "
                "OR feedback_log_body LIKE '%op.dispatch.shutdown%' THEN ts END) "
                "FROM logs WHERE thread_id = ?", (tid,)).fetchone()
            if last is None or last >= btime:
                continue  # nothing to judge by, or touched this boot (the watcher's job)
            if ended is not None and ended >= last - 120:
                continue  # torn down: /quit, or the daemon reaping a closed window
            out.append(session("codex", tid, cwd, last, "machine went down", title, created))
    except sqlite3.Error:
        pass
    finally:
        con.close()
    return out


# -- omp / hermes ------------------------------------------------------------

def omp_files(since, until):
    """omp transcripts with no session_exit, or one a signal wrote (window closed, killed)."""
    for path in glob.glob(str(HOME / ".omp" / "agent" / "sessions" / "*" / "*.jsonl")):
        last = mtime(path)
        if not since <= last < until:
            continue
        reason = exit_reason(path)
        if reason is None or reason in CUT_EXITS:
            _, cwd, title = head(path, limit=40)
            if title:
                yield path, last, cwd, title, CUT_EXITS.get(reason, "not closed")


def omp(since, btime):
    return [session("omp", Path(path).stem.split("_", 1)[-1], cwd, last, how, title)
            for path, last, cwd, title, how in omp_files(since, btime)]


def hermes_rows(where, params):
    db = HOME / ".hermes" / "state.db"
    if not db.exists():
        return []
    try:
        con = ro(db)
        try:
            return con.execute(
                "SELECT id, cwd, COALESCE(last_activity_at, started_at), COALESCE(title, ''), "
                "started_at FROM sessions WHERE ended_at IS NULL AND id NOT LIKE 'cron_%' "
                "AND COALESCE(message_count, 0) > 0 AND " + where
                + " ORDER BY COALESCE(last_activity_at, started_at) DESC", params).fetchall()
        finally:
            con.close()
    except sqlite3.Error:
        return []


def hermes(since, btime):
    return [session("hermes", sid, cwd, last, "not closed", title or "(untitled)", started)
            for sid, cwd, last, title, started in hermes_rows(
                "COALESCE(last_activity_at, started_at) >= ?", (since,)) if last < btime]


# -- watcher records to sessions ---------------------------------------------

def argv_id(h, argv):
    """The session a command line names: `codex resume <id>`, `claude --resume <id>`."""
    by_id = HARNESSES.get(h, (None,))[0]
    hit = harness_of(argv or [])
    if not by_id or not hit:
        return None
    rest = argv[hit[1] + 1:]
    id_flags = {by_id[0]} | {
        "claude": {"-r", "--session-id"}, "omp": {"-r"}, "hermes": {"-r"},
        "opencode": {"-s"}, "kilo": {"-s"}, "gemini": {"-r"},
        "qwen": {"-r", "--session-id"}, "pi": {"--session-id"},
        "openclaw": {"--session"},
    }.get(h, set())
    for i, a in enumerate(rest):
        if a in id_flags and i + 1 < len(rest) and not rest[i + 1].startswith("-"):
            return rest[i + 1]
        if "=" in a and a.split("=", 1)[0] in id_flags and a.startswith("-"):
            return a.split("=", 1)[1] or None
    return None


def agy_id(rec):
    """A unique conversation presence lock created near this process's launch.

    Locks contain no pid. A start-time match is useful only when unique and
    backed by that conversation's cascade_id in SQLite. Never choose the
    newest database, which may belong to a conversation started after death.
    """
    root = HOME / ".gemini" / "antigravity-cli"
    found = []
    for lock in (root / "presence").glob("*.lock"):
        stamp = mtime(lock)
        if abs(stamp - rec["started"]) > 60 or stamp > rec["last"]:
            continue
        db = root / "conversations" / (lock.stem + ".db")
        if not db.is_file():
            continue
        try:
            con = ro(db)
            try:
                if con.execute("SELECT 1 FROM trajectory_meta WHERE cascade_id = ? LIMIT 1",
                               (lock.stem,)).fetchone():
                    found.append(lock.stem)
            finally:
                con.close()
        except sqlite3.Error:
            continue
    return found[0] if len(found) == 1 else None


def resolve(rec, live, taken):
    """The session a dead agent process was running, looked up in its harness's store."""
    h, cwd, since = rec["harness"], rec["cwd"], rec["started"] - 5
    hit = None
    named = argv_id(h, rec.get("argv"))
    if h != "claude" and named and (h, named) not in taken:
        # Claude's pid file follows /clear and /resume; for the rest, a session
        # named on the command line is the one it ran.
        hit = session(h, named, cwd, rec["last"], rec["how"], "")
        if h == "codex":
            for _, _, title, updated, _ in codex_threads("id = ?", (named,)):
                hit.update(title=title or "", last=updated)
    elif h == "claude":
        path = rec.get("session") and claude_transcript(rec["session"])
        if path:
            hit = session(h, rec["session"], cwd, mtime(path), rec["how"], head(path)[2])
        else:
            found = claude_in(cwd, since, live, taken, rec["last"] + 5)
            if found:
                hit = session(h, found[0], cwd, found[1], rec["how"], found[2])
    elif h == "codex":
        for tid, _, title, updated, _ in codex_threads("cwd = ? AND updated_at >= ? AND updated_at <= ?",
                                                       (cwd, since, rec["last"] + 5)):
            if ("codex", tid) not in taken:
                hit = session(h, tid, cwd, updated, rec["how"], title)
                break
    elif h == "omp":
        def rank(x):
            # The transcript opened nearest this process's start is its own,
            # whichever dead window is resolved first; touched-last is the fallback.
            began = epoch(head_meta(x[0]).get("started"))
            if began is not None and since <= began <= rec["last"] + 5:
                return 0, abs(began - rec["started"]), -x[1]
            return 1, 0, -x[1]
        for path, last, ocwd, title, _ in sorted(omp_files(since, rec["last"] + 5), key=rank):
            sid = Path(path).stem.split("_", 1)[-1]
            if ocwd == cwd and ("omp", sid) not in taken:
                hit = session(h, sid, cwd, last, rec["how"], title)
                break
    elif h == "hermes":
        for sid, _, last, title, _ in hermes_rows("cwd = ? AND started_at >= ? AND started_at <= ?",
                                                (cwd, since, rec["last"] + 5)):
            if ("hermes", sid) not in taken:
                hit = session(h, sid, cwd, last, rec["how"], title or "(untitled)")
                break
    elif h == "agy":
        sid = agy_id(rec)
        if sid and (h, sid) not in taken:
            hit = session(h, sid, cwd, rec["last"], rec["how"], "")
    elif h in STORE_INDEXERS:
        try:
            rows = sorted(STORE_INDEXERS[h](), key=lambda r: -(r["last"] or 0))
            for r in rows:
                if r["harness"] != h or r.get("source") in AUTOMATED:
                    continue
                if r.get("cwd") and r["cwd"] != cwd:
                    continue
                if not since <= (r["last"] or 0) <= rec["last"] + 5 or (h, r["id"]) in taken:
                    continue
                hit = session(h, r["id"], cwd, r["last"], rec["how"], r["title"])
                break
        except (OSError, sqlite3.Error, ValueError, TypeError, KeyError) as e:
            print("cgr: resolving %s: %s" % (h, e), file=sys.stderr)
    # No readable store: its own "continue" flag picks the newest session there.
    s = hit or session(h, None, cwd, rec["last"], rec["how"], "")
    s["last"] = max(s["last"], rec["last"])
    s.update(started=rec["started"], typed=rec.get("typed"), argv=rec.get("argv"))
    s.update({f: rec[f] for f in ("pid", "ticks") if rec.get(f) is not None})
    s.update({f: rec[f] for f in ("boot", "boot_end", "died") if rec.get(f) is not None})
    if not s["title"]:
        s["title"] = s["typed"] or " ".join(rec.get("argv") or [h])
    return s


# -- collecting --------------------------------------------------------------

def key(s):
    return "%s:%s" % (s["harness"], s["id"] or "%s@%s" % (s["cwd"], int(s["started"] or 0)))


def running_words():
    """Every word on the command line of an agent running now. A session named
    there (`claude --resume <id>`) is alive again, even before its harness
    records that: a resumed claude writes its pid file late."""
    words = set()
    for p in os.listdir("/proc"):
        if p.isdigit() and mine(p):  # another account could hide yours by naming them
            argv = proc_argv(int(p))
            if harness_of(argv):
                words.update(argv)
                words.update(a.split("=", 1)[1] for a in argv if "=" in a)
    return words


def load_handled():
    try:
        return json.loads(read_own(STATE / "cgr-handled.json"))
    except (OSError, ValueError):
        return {}


def mark_handled(items):
    now = time.time()
    handled = {k: v for k, v in load_handled().items() if v > now - KEEP_DAYS * 86400}
    for s in items:
        handled[key(s)] = now
    private_dir(STATE)
    tmp = STATE / "cgr-handled.json.tmp"
    write_private(tmp, json.dumps(handled, indent=1))
    os.replace(tmp, STATE / "cgr-handled.json")


def item_key(s):
    return (s["harness"], s["id"]) if s["id"] else (s["harness"], s["cwd"], s["started"])


def same_window(a, b):
    """False when two rows are known to be different processes or launches: the
    pid and start ticks the watcher and `cgr --save` both record, or the
    command lines you typed. A side that lacks one cannot rule the pair out."""
    for f in (("pid", "ticks"), ("typed",)):
        if all(a.get(x) is not None for x in f) and all(b.get(x) is not None for x in f) \
                and [a[x] for x in f] != [b[x] for x in f]:
            return False
    return True


def merge(items, s):
    """A `cgr --save` record absorbs the watcher's id-less row for its window,
    which `resolve` cannot match by id: same harness, same window, both dying
    in the same minute. Its id and title survive the watcher update."""
    if s.get("how") == "saved" and s.get("id"):
        best = None
        for k, cur in items.items():
            gap = abs(cur["started"] - s["started"]) if cur.get("started") and s.get("started") else None
            if (cur.get("id") is None and cur.get("harness") == s["harness"]
                    and cur.get("cwd") == s["cwd"] and gap is not None and gap < 300
                    and same_window(cur, s) and (best is None or gap < best[0])):
                best = gap, k
        if best:
            cur = items[best[1]]
            cur.update({f: s[f] for f in ("typed", "argv", "started", "id", "title") if s.get(f)})
            cur.update({f: s[f] for f in ("last", "how", "boot", "boot_end", "died") if f in s})
            cur.update({f: s[f] for f in ("messages", "bytes", "model", "mid_turn",
                                          "last_prompt") if s.get(f)})
            if item_key(cur) != best[1]:
                items[item_key(cur)] = items.pop(best[1])
            return
    k = item_key(s)
    if k in items:
        was_saved = items[k].get("how") == "saved"
        items[k].update({f: s[f] for f in ("typed", "argv", "started") if s.get(f)})
        if s["last"] >= items[k]["last"]:
            items[k].update({f: s[f] for f in ("last", "how", "boot", "boot_end", "died") if f in s})
        if s.get("how") == "saved" or was_saved:
            items[k]["how"] = "saved"  # the planned restart outlives the watcher's verdict
    else:
        items[k] = s


def cut_off(everything=False, use_index=True):
    """{key: session} for every session cut off since the boot that went down
    with them began (ever, with `everything`), before the reopened and running
    ones are dropped."""
    btime, boot_id = boot_start()
    since = 0 if everything else crash_boot_start(btime, boot_id) - 120
    live, dead = claude_pids(btime)
    items = {}
    for s in claude(since, btime, live, dead) + codex(since, btime) + omp(since, btime) \
            + hermes(since, btime):
        items.setdefault((s["harness"], s["id"]), s)
    if use_index:
        for s in indexed_cut_off(since, btime):
            merge(items, s)
    taken = set()
    for rec in sorted(watched(boot_id, since, boot_since=None if everything else since),
                      key=lambda r: -r["started"]):
        s = resolve(rec, live, taken)
        taken.add(item_key(s))
        merge(items, s)
    for s in saved(since):
        merge(items, s)
    hist, amap = None, None
    for s in items.values():
        if not s["typed"] and s["started"] and s.get("source") != "sessions.db":
            if hist is None:
                hist, amap = history(), aliases()
            s["typed"] = typed_for(s["harness"], s["started"], hist, amap, s.get("argv"))
    return items


def collect(everything=False):
    items = cut_off(everything)
    handled = load_handled()
    running = running_words()
    shown, continued = [], set()
    for s in sorted(items.values(), key=lambda s: -s["last"]):
        if handled.get(key(s), 0) >= s["last"] or s["id"] in running:
            continue
        if s["id"] is None:
            # Without an id, "continue the newest" can only reopen one session per directory.
            if (s["harness"], s["cwd"]) in continued:
                continue
            continued.add((s["harness"], s["cwd"]))
        shown.append(s)
    return group_sessions(shown)


def group_sessions(items):
    """Attach event keys and order groups by their end, newest sessions within each.

    A watcher boot id identifies the event. Native-only sessions are assigned
    by last activity inside a boot interval, explicitly labeled as inferred.
    Window closes form a separate group for the boot in which they happened.
    """
    periods = boot_periods()
    by_boot = {p["boot"]: p for p in periods}
    groups = {}
    for s in items:
        period = by_boot.get(s.get("boot"))
        association = "watcher boot" if period else "last activity"
        if period is None:
            period = next((p for p in reversed(periods) if p["start"] <= s["last"]
                           and (p["end"] is None or s["last"] <= p["end"])), None)
        kind = {"window closed": "window closed", "killed": "killed"}.get(s["how"], "machine went down")
        if s["how"] == "saved":
            kind = "saved"
        if period:
            event = dict(period, kind=kind)
            if kind in ("window closed", "killed", "saved"):
                event["boot_end"] = event["end"]
                event["end"] = s["last"]
            gid = "%s:%s" % (kind.replace(" ", "-"), period["boot"])
        else:
            day = time.strftime("%Y-%m-%d", time.localtime(s["last"]))
            gid = "activity:%s" % day
            event = {"boot": None, "start": s["last"], "end": s["last"],
                     "kind": "unmatched activity", "end_kind": "no boot interval"}
            association = "usage date only"
        s["group"], s["event_association"] = gid, association
        if gid not in groups:
            groups[gid] = {"event": event, "items": []}
        group = groups[gid]
        if kind in ("window closed", "killed", "saved") or not period:
            group["event"]["end"] = max(group["event"]["end"], s["last"])
        group["items"].append(s)
    out = []
    for gid, group in sorted(groups.items(), key=lambda kv: (-(kv[1]["event"]["end"] or 0), kv[0])):
        for s in sorted(group["items"], key=lambda s: (-s["last"], s["harness"], s["id"] or s["cwd"])):
            s["event"] = dict(group["event"])
            out.append(s)
    return out


# -- a planned restart (cgr --save) ------------------------------------------

def saved_path():
    return STATE / "saved.json"


def running_sessions():
    """Every agent running on a terminal now, as sessions with the ids their
    harnesses gave them where one can be found. The watcher's own rules, read
    fresh, so this works with the watcher stopped too."""
    w = Watcher()
    for pid in sorted(int(p) for p in os.listdir("/proc") if p.isdigit()):
        rec = w.consider(pid)
        if rec:
            w.agents[pid] = rec
    recs = sorted(w.agents.values(), key=lambda r: -r["started"])
    # A running claude names its own session; the others must not take it.
    taken = {("claude", r["session"]) for r in recs if r.get("session")}
    now, out = time.time(), []
    for rec in recs:
        s = resolve(dict(rec, how="saved", last=now), set(), taken)
        taken.add(item_key(s))
        s.update(pid=rec["pid"], ticks=rec["ticks"], boot=rec["boot"], last=now)
        out.append(s)
    return out


def save():
    items = running_sessions()
    private_dir(STATE)
    tmp = saved_path().with_suffix(".tmp")
    write_private(tmp, json.dumps({"saved": time.time(), "sessions": items}, indent=1))
    os.replace(tmp, saved_path())
    return items


def saved(since):
    """What `cgr --save` recorded, once each process is gone, however it went:
    exited, its window closed, or the machine restarted."""
    try:
        data = json.loads(read_own(saved_path()))
    except (OSError, ValueError):
        return []
    boot = current_boot()[1]
    out = []
    for s in data.get("sessions") or []:
        if not session_record(s) or s.get("last", 0) < since:
            continue
        if s.get("boot") == boot and alive(s.get("pid"), s.get("ticks")):
            continue
        out.append(dict(s, how="saved"))
    return out


# -- every session, in one database (cgr --history) ---------------------------

SCHEMA = """
CREATE TABLE IF NOT EXISTS sessions (
    harness     TEXT NOT NULL,
    id          TEXT NOT NULL,
    cwd         TEXT,
    source      TEXT,     -- what started it: cli, exec, subagent, sdk-cli, cron ...
    interactive INTEGER,  -- 1: you ran it at a prompt; 0: a script, subagent or schedule did
    started     REAL,     -- epoch seconds
    last        REAL,     -- last activity
    status      TEXT,     -- running | closed | cut off | unknown
    how         TEXT,     -- the evidence for status
    exit_record TEXT,     -- the end record the harness wrote, verbatim
    mid_turn    INTEGER,  -- 1: it stops on your prompt, a tool step or an error
    title       TEXT,     -- the harness's title, else your first prompt
    last_prompt TEXT,
    messages    INTEGER,  -- where the harness counts them
    bytes       INTEGER,  -- transcript size
    model       TEXT,
    branch      TEXT,
    path        TEXT,     -- the transcript or database it was read from
    typed       TEXT,     -- the command line that started it, when the watcher saw it
    argv        TEXT,     -- the process argv as JSON, when the watcher saw it and typed is unknown
    resume      TEXT,     -- the line that reopens it
    reopened    REAL,     -- when cgr last reopened or forgot it
    in_store    INTEGER,  -- 0: its harness has since deleted it; this row is all that is left
    first_seen  REAL,
    last_seen   REAL,
    PRIMARY KEY (harness, id)
);
"""
AUDIT_VIEW = """
DROP VIEW IF EXISTS audit;
CREATE VIEW audit AS
SELECT harness, id, cwd, datetime(last, 'unixepoch', 'localtime') AS last_active,
       status, how, mid_turn, title, last_prompt, resume
FROM sessions
WHERE interactive = 1 AND (status = 'cut off' OR (status = 'unknown' AND mid_turn = 1))
ORDER BY last DESC;
"""
COLUMNS = ("harness", "id", "cwd", "source", "interactive", "started", "last", "status", "how", "exit_record",
           "mid_turn", "title", "last_prompt", "messages", "bytes", "model", "branch", "path",
           "typed", "argv", "resume", "reopened", "in_store", "first_seen", "last_seen")
SNIP = 400                      # characters of a prompt kept
TOOL_BLOCKS = {"tool_use", "toolCall", "functionCall"}
RESULT_BLOCKS = {"tool_result", "functionResponse"}
# Harnesses that write an end record on every exit they get to run, so a
# session with none, newer than the first one seen, never got to exit.
WRITES_EXIT = {"claude", "omp", "muse"}
# Sources that are a program's runs, not a session you would sit down to finish.
AUTOMATED = {"exec", "mcp", "subagent", "sdk-cli", "sdk-py", "cron", "kanban", "gateway"}


def db_path():
    return STATE / "sessions.db"


def epoch(v):
    """Seconds since the epoch from the harnesses' assorted timestamps."""
    if isinstance(v, bool) or v is None:
        return None
    if isinstance(v, (int, float)):
        return v / 1e6 if v > 1e14 else v / 1000 if v > 1e11 else float(v)
    m = re.match(r"(\d{4}-\d\d-\d\d)[T ](\d\d:\d\d:\d\d)(\.\d+)?(Z|[+-]\d\d:?\d\d)?$",
                 str(v).strip())
    if not m:
        return None
    import datetime
    zone = m.group(4) if m.group(4) not in (None, "Z") else "+00:00"
    return datetime.datetime.fromisoformat("%sT%s%s%s" % (m.group(1), m.group(2),
                                                          (m.group(3) or "")[:7], zone)).timestamp()


def blocks(content):
    """[(kind, text)] for a message body in any harness's shape."""
    if isinstance(content, str):
        return [("text", content)]
    out = []
    for b in content if isinstance(content, list) else []:
        if isinstance(b, str):
            out.append(("text", b))
        elif isinstance(b, dict):
            kind = b.get("type") or b.get("kind") or (
                "thinking" if b.get("thought") else
                next((k for k in ("functionCall", "functionResponse") if k in b), "text"))
            out.append((kind, b["text"] if isinstance(b.get("text"), str) else ""))
    return out


def step(role, content, stop=None):
    """A conversation record as the turn sees it: ("prompt", text), ("tool", ""),
    ("call", ""), ("reply", ""), ("error", ""), ("stopped", ""), or None."""
    parts = blocks(content)
    kinds = {k for k, _ in parts}
    if role in ("tool", "toolResult") or kinds & RESULT_BLOCKS:
        return "tool", ""
    if role == "user":
        text = " ".join(" ".join(t for k, t in parts if k in ("text", "input_text")).split())
        if text.startswith("[Request interrupted"):
            return "stopped", ""
        if not text or text.startswith(("<", "Caveat:")):
            return None  # a slash command's echo or injected context
        return "prompt", text
    if role in ("assistant", "model", "gemini"):
        if stop == "aborted":
            return "stopped", ""
        if stop == "error":
            return "error", ""
        return ("call", "") if kinds & TOOL_BLOCKS else ("reply", "")
    return None


def turn(steps):
    """(mid_turn, last prompt) from conversation steps, newest first. Mid-turn:
    the record stops on your prompt, a tool call or result, or an error, so the
    agent was still at work when it ended."""
    mid, prompt = None, ""
    for st in steps:
        if not st:
            continue
        if mid is None:
            mid = st[0] in ("prompt", "tool", "call", "error")
        if st[0] == "prompt":
            prompt = st[1]
            break
    return mid, prompt[:SNIP]


def message_step(rec):
    """step() for transcripts with one message per record: claude, qwen, omp, pi."""
    m = rec.get("message")
    if not isinstance(m, dict) or rec.get("isMeta") or rec.get("isSidechain"):
        return None, None
    content = m["content"] if "content" in m else m.get("parts")
    return step(m.get("role"), content, m.get("stopReason")), m.get("model")


def first_records(path, limit=300):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i >= limit:
                    return
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if isinstance(rec, dict):
                    yield rec
    except OSError:
        return


def head_meta(path, step_of=message_step):
    """cwd, start, branch, source and first prompt from the start of a transcript."""
    meta = {}
    for rec in first_records(path):
        for k, field in (("cwd", "cwd"), ("branch", "gitBranch"), ("source", "entrypoint"),
                         ("started", "timestamp"), ("id", "sessionId")):
            if rec.get(field) and k not in meta:
                meta[k] = rec[field]
        if rec.get("type") == "session" and rec.get("id"):
            meta.setdefault("id", rec["id"])  # pi and omp open with a session header
        if "title" not in meta:
            st = step_of(rec)[0]
            title = prompt_text(rec) or (st[1] if st and st[0] == "prompt" else "")
            if title:
                meta["title"] = title[:SNIP]
    return meta


def tail_scan(path, step_of=message_step):
    """(end record, mid_turn, last prompt, model) from the end of a transcript."""
    end, steps, model, talked = None, [], None, False
    for rec in tail(path):
        if rec.get("customType") == "session_exit" and not talked and end is None:
            end = session_exit_reason(rec)
        if rec.get("type") == "last-prompt" and isinstance(rec.get("lastPrompt"), str):
            steps.append(("last-prompt", " ".join(rec["lastPrompt"].split())))
        st, mdl = step_of(rec)
        model = model or mdl
        if st:
            talked = True
            steps.append(st)
    mid, prompt = turn(s for s in steps if s[0] != "last-prompt")
    if not prompt:  # claude notes your last prompt even when the turn ran past the tail
        prompt = next((s[1] for s in steps if s[0] == "last-prompt"), "")[:SNIP]
    return end, mid, prompt, model


def entry(harness, sid, path=None, **kw):
    r = dict.fromkeys(COLUMNS)
    r.update(harness=harness, id=str(sid), path=str(path) if path else None, verdict=None)
    if path and os.path.isfile(path):
        r["bytes"] = os.path.getsize(path)
        r["last"] = mtime(path)
    r.update({k: v for k, v in kw.items() if v is not None})
    for k in ("started", "last"):
        r[k] = epoch(r[k])
    for k in ("title", "last_prompt"):
        r[k] = " ".join(str(r[k]).split())[:SNIP] if r[k] else None
    return r


def exit_verdict(end):
    if end is None:
        return None
    if end in CUT_EXITS:
        return "cut off", CUT_EXITS[end]
    return "closed", "exit record: %s" % end


def index_claude():
    for path in glob.glob(str(HOME / ".claude" / "projects" / "*" / "*.jsonl")):
        meta = head_meta(path)
        end, mid, prompt, model = tail_scan(path)
        source = meta.get("source") or "cli"
        r = entry("claude", Path(path).stem, path, cwd=meta.get("cwd"), source=source,
                  started=meta.get("started"), title=meta.get("title"), exit_record=end,
                  mid_turn=mid, last_prompt=prompt, model=model, branch=meta.get("branch"))
        r["verdict"] = exit_verdict(end) or (
            None if source == "cli" else ("unknown", "%s run: no end record" % source))
        yield r


def jsonl_index(harness, pattern, sid_of):
    for path in glob.glob(str(HOME / pattern)):
        meta = head_meta(path)
        end, mid, prompt, model = tail_scan(path)
        r = entry(harness, sid_of(path, meta), path, cwd=meta.get("cwd"),
                  started=meta.get("started"), title=meta.get("title"), exit_record=end,
                  mid_turn=mid, last_prompt=prompt, model=model, branch=meta.get("branch"),
                  source="cli")
        r["verdict"] = exit_verdict(end)
        yield r


def index_omp():
    return jsonl_index("omp", ".omp/agent/sessions/*/*.jsonl",
                       lambda p, m: Path(p).stem.split("_", 1)[-1])


def index_pi():
    return jsonl_index("pi", ".pi/agent/sessions/*/*.jsonl",
                       lambda p, m: Path(p).stem.split("_", 1)[-1])


def index_qwen():
    return jsonl_index("qwen", ".qwen/projects/*/chats/*.jsonl",
                       lambda p, m: m.get("id") or Path(p).stem)


def codex_step(rec):
    p = rec.get("payload") if isinstance(rec.get("payload"), dict) else {}
    if rec.get("type") != "event_msg":
        return None, None
    t = p.get("type")
    if t == "user_message":
        text = " ".join(str(p.get("message") or "").split())
        return (("prompt", text) if text else None), None
    return {"task_started": ("call", ""), "task_complete": ("reply", ""),
            "turn_aborted": ("stopped", ""), "error": ("error", "")}.get(t), None


def index_codex():
    db = codex_db("state_*.sqlite")
    if not db:
        return
    ends, span = {}, None
    logs = codex_db("logs_*.sqlite")
    if logs:
        try:
            con = ro(logs)
            try:
                span = con.execute("SELECT MIN(ts) FROM logs").fetchone()[0]
                for tid, last, ended in con.execute(
                        "SELECT thread_id, MAX(ts), MAX(CASE WHEN feedback_log_body LIKE "
                        "'%Agent loop exited%' OR feedback_log_body LIKE '%op.dispatch.shutdown%' "
                        "THEN ts END) FROM logs GROUP BY thread_id"):
                    ends[tid] = (last, ended)
            finally:
                con.close()
        except sqlite3.Error:
            pass
    con = ro(db)
    try:
        con.row_factory = sqlite3.Row
        rows = con.execute("SELECT * FROM threads").fetchall()
    finally:
        con.close()
    for t in rows:
        t = dict(t)
        path = t.get("rollout_path")
        _, mid, prompt, _ = tail_scan(path, codex_step) if path else (None, None, "", None)
        src = t.get("source") or ""
        r = entry("codex", t["id"], path, cwd=t.get("cwd"),
                  source="subagent" if src.startswith("{") else src,
                  started=t.get("created_at"), title=t.get("title") or t.get("first_user_message"),
                  mid_turn=mid, last_prompt=prompt, model=t.get("model"),
                  branch=t.get("git_branch"))
        r["last"] = epoch(t.get("updated_at")) or r["last"]
        last, ended = ends.get(t["id"], (None, None))
        if t.get("archived"):
            r["verdict"] = ("closed", "archived")
        elif ended is not None and ended >= (last or 0) - 120:
            r["exit_record"] = "Agent loop exited"
            r["verdict"] = ("closed", "shut down (codex log)")
        elif last is not None:
            r["verdict"] = ("cut off", "no shutdown in codex log")
        elif span and (r["last"] or 0) >= span:
            r["verdict"] = ("unknown", "nothing in codex log")
        yield r


# hermes's end reasons for a session whose process went away without closing
# it (its own hermes_state_common.py and finalize_orphaned_compression_sessions).
HERMES_CUT = {"startup_orphan_reap", "ws_orphan_reap", "orphaned_compression"}


def index_hermes():
    db = HOME / ".hermes" / "state.db"
    if not db.exists():
        return
    con = ro(db)
    try:
        con.row_factory = sqlite3.Row
        for s in [dict(x) for x in con.execute("SELECT * FROM sessions")]:
            msgs = con.execute("SELECT role, content, tool_calls FROM messages WHERE session_id = ? "
                               "ORDER BY id DESC LIMIT 60", (s["id"],)).fetchall()
            steps = []
            for role, content, calls in msgs:
                if role == "assistant" and str(content or "").startswith("Operation interrupted"):
                    steps.append(("stopped", ""))
                elif role == "assistant" and calls and calls not in ("[]", "null"):
                    steps.append(("call", ""))
                else:
                    steps.append(step(role, content if isinstance(content, str) else ""))
            mid, prompt = turn(steps)
            r = entry("hermes", s["id"], db, cwd=s.get("cwd"), source=s.get("source"),
                      started=s.get("started_at"), title=s.get("title"),
                      exit_record=s.get("end_reason"), mid_turn=mid, last_prompt=prompt,
                      messages=s.get("message_count"), model=s.get("model"),
                      branch=s.get("git_branch"))
            r["bytes"] = None
            r["last"] = epoch(s.get("last_activity_at") or s.get("ended_at") or s.get("started_at"))
            reason = s.get("end_reason")
            if s.get("ended_at") is None:
                r["verdict"] = ("cut off", "not closed")
            elif reason in HERMES_CUT:
                r["verdict"] = ("cut off", "end record: %s" % reason)
            else:
                r["verdict"] = ("closed", "end record: %s" % (reason or "ended"))
            yield r
    finally:
        con.close()


def index_jcode():
    for path in glob.glob(str(HOME / ".jcode" / "sessions" / "*.json")):
        try:
            d = json.loads(Path(path).read_text(errors="replace"))
        except (OSError, ValueError):
            continue
        msgs = d.get("messages") if isinstance(d.get("messages"), list) else []
        mid, prompt = turn(step(m.get("role"), m.get("content"))
                           for m in reversed(msgs) if isinstance(m, dict))
        first = next((st[1] for st in (step(m.get("role"), m.get("content"))
                                       for m in msgs if isinstance(m, dict))
                      if st and st[0] == "prompt"), None)
        status = d.get("status")
        r = entry("jcode", d.get("id") or Path(path).stem, path, cwd=d.get("working_dir"),
                  source="cli", started=d.get("created_at"),
                  title=d.get("title") or d.get("short_name") or first, mid_turn=mid,
                  last_prompt=prompt, messages=len(msgs), model=d.get("model"),
                  exit_record=status if isinstance(status, str) or status is None
                  else json.dumps(status)[:SNIP])
        r["last"] = epoch(d.get("last_active_at") or d.get("updated_at")) or r["last"]
        if status == "Closed":
            r["verdict"] = ("closed", "status Closed")
        elif isinstance(status, dict) and "Crashed" in status:
            msg = (status["Crashed"] or {}).get("message") if isinstance(status["Crashed"], dict) else None
            r["verdict"] = ("cut off", "status Crashed" + (": " + msg if msg else ""))
        else:
            r["verdict"] = ("cut off", "left %s" % (status or "open"))
        yield r


def index_muse():
    for path in glob.glob(str(HOME / ".local/share/muse/sessions/*/*/*/*/session.jsonl")):
        meta = {}
        for rec in first_records(path):
            p = rec.get("payload") if isinstance(rec.get("payload"), dict) else {}
            inner = p.get("record") if isinstance(p.get("record"), dict) else {}
            meta.setdefault("started", rec.get("recorded_at"))
            if inner.get("cwd"):
                meta.setdefault("cwd", inner["cwd"])
            if inner.get("model_id"):
                meta.setdefault("model", inner["model_id"])
            if rec.get("payload_type") == "runtime.user_intent.accepted" and "title" not in meta:
                meta["title"] = muse_prompt(p)
        end = prompt = None
        for rec in tail(path):
            p = rec.get("payload") if isinstance(rec.get("payload"), dict) else {}
            if rec.get("payload_type") == "session.end" and end is None:
                end = (p.get("record") or {}).get("exit_reason") or "ended"
            if rec.get("payload_type") == "runtime.user_intent.accepted" and prompt is None:
                prompt = muse_prompt(p)
        r = entry("muse", Path(path).parent.name, path, cwd=meta.get("cwd"), source="cli",
                  started=meta.get("started"), title=meta.get("title"), exit_record=end,
                  last_prompt=prompt or meta.get("title"), model=meta.get("model"))
        if end:
            r["verdict"] = ("closed", "session.end: %s" % end) if end == "clean" else \
                ("cut off", "session.end: %s" % end)
        yield r


def muse_prompt(payload):
    for m in payload.get("model_messages") or []:
        text = " ".join(t for _, t in blocks(m.get("content") if isinstance(m, dict) else None))
        if text.strip():
            return text
    return None


def index_gemini():
    for path in glob.glob(str(HOME / ".gemini" / "tmp" / "*" / "chats" / "*.json")):
        try:
            d = json.loads(Path(path).read_text(errors="replace"))
            cwd = (Path(path).parent.parent / ".project_root").read_text().strip()
        except (OSError, ValueError):
            continue
        if not isinstance(d, dict):
            continue
        msgs = [m for m in d.get("messages") or [] if isinstance(m, dict)]

        def gstep(m):
            if m.get("type") == "user":
                return step("user", m.get("content"))
            if m.get("type") == "gemini":
                return ("call", "") if m.get("toolCalls") and not m.get("content") else ("reply", "")
            return ("error", "") if m.get("type") == "error" else None
        mid, prompt = turn(gstep(m) for m in reversed(msgs))
        first = next((st[1] for st in map(gstep, msgs) if st and st[0] == "prompt"), None)
        model = next((m.get("model") for m in reversed(msgs) if m.get("model")), None)
        r = entry("gemini", d.get("sessionId") or Path(path).stem, path, cwd=cwd, source="cli",
                  started=d.get("startTime"), title=first, mid_turn=mid, last_prompt=prompt,
                  messages=len(msgs), model=model)
        r["last"] = epoch(d.get("lastUpdated")) or r["last"]
        yield r


def index_opencode():
    for harness, db in (("opencode", HOME / ".local/share/opencode/opencode.db"),
                        ("kilo", HOME / ".local/share/kilo/kilo.db")):
        if not db.exists():
            continue
        con = ro(db)
        try:
            sessions = con.execute("SELECT id, directory, title, time_created, time_updated, "
                                   "parent_id, time_archived FROM session").fetchall()
            for sid, cwd, title, created, updated, parent, archived in sessions:
                msgs = con.execute("SELECT id, data FROM message WHERE session_id = ? "
                                   "ORDER BY time_created DESC", (sid,)).fetchall()
                steps, model = [], None
                for mid_, data in msgs[:200]:
                    try:
                        m = json.loads(data)
                    except ValueError:
                        continue
                    mm = m.get("model")
                    model = model or m.get("modelID") or (mm.get("modelID")
                                                          if isinstance(mm, dict) else None)
                    if m.get("role") == "user":
                        text = " ".join(json.loads(d).get("text") or "" for (d,) in con.execute(
                            "SELECT data FROM part WHERE message_id = ? ORDER BY id", (mid_,))
                            if '"type":"text"' in d)
                        steps.append(step("user", text))
                        if steps[-1]:
                            break  # the last prompt: turn() reads no further
                    elif m.get("error"):
                        steps.append(("error", ""))
                    elif not (m.get("time") or {}).get("completed") or m.get("finish") == "tool-calls":
                        steps.append(("call", ""))
                    else:
                        steps.append(("reply", ""))
                mid, prompt = turn(steps)
                r = entry(harness, sid, db, cwd=cwd, source="subagent" if parent else "cli",
                          started=created, title=title, mid_turn=mid, last_prompt=prompt,
                          messages=len(msgs), model=model)
                r["bytes"] = None
                r["last"] = epoch(updated)
                if archived:
                    r["verdict"] = ("closed", "archived")
                yield r
        finally:
            con.close()


def index_openclaw():
    for db in glob.glob(str(HOME / ".openclaw" / "agents" / "*" / "agent" / "openclaw-agent.sqlite")):
        con = ro(db)
        try:
            rows = con.execute("SELECT session_id, started_at, created_at, updated_at, ended_at, "
                               "status, model, display_name, chat_type FROM session_windows").fetchall()
        except sqlite3.Error:
            rows = []
        finally:
            con.close()
        for sid, started, created, updated, ended, status, model, name, kind in rows:
            r = entry("openclaw", sid, db, source=kind or "gateway", started=started or created,
                      title=name, exit_record=status, model=model)
            r["bytes"] = None
            r["last"] = epoch(ended or updated)
            r["verdict"] = {"done": ("closed", "status done"),
                            "failed": ("cut off", "status failed")}.get(status)
            yield r


INDEXERS = (index_claude, index_codex, index_omp, index_pi, index_hermes, index_jcode,
            index_muse, index_gemini, index_qwen, index_opencode, index_openclaw)
STORE_INDEXERS = {"jcode": index_jcode, "muse": index_muse, "pi": index_pi,
                  "gemini": index_gemini, "qwen": index_qwen, "opencode": index_opencode,
                  "kilo": index_opencode, "openclaw": index_openclaw}
NATIVE_RECOVERY = {"claude", "codex", "omp", "hermes"}


def ensure_index():
    """Refresh absent or day-old indexes. Rebuild from stores, never cached verdicts."""
    path = db_path()
    if path.exists() and path.stat().st_uid != ME:
        return False
    stale = not path.exists() or mtime(path) < time.time() - 86400
    if not stale:
        try:
            con = ro(path)
            try:
                stale = not set(COLUMNS).issubset({c[1] for c in con.execute("PRAGMA table_info(sessions)")})
            finally:
                con.close()
        except sqlite3.Error:
            stale = True
    if stale:
        write_index(*build_index())
    return True


def indexed_cut_off(since, btime):
    """Additional harnesses with explicit cut-off, interactive, available rows.

    A current-boot missing end marker could be an idle living process. As
    with native omp records, it needs a watcher death before being recoverable.
    """
    out = []
    try:
        if not ensure_index():
            return out
        con = ro(db_path())
        try:
            con.row_factory = sqlite3.Row
            rows = [dict(r) for r in con.execute(
                "SELECT * FROM sessions WHERE interactive = 1 AND status = 'cut off' "
                "AND in_store = 1 AND last >= ?", (since,))]
        finally:
            con.close()
        for r in rows:
            h, sid = r["harness"], r["id"]
            if h not in HARNESSES or h in NATIVE_RECOVERY or not sid or sid.startswith("@"):
                continue
            if r.get("source") in AUTOMATED or (r.get("path") and not Path(r["path"]).is_file()):
                continue
            how = r["how"] or "indexed cut off"
            if r["last"] >= btime and (how in ("no end record", "not closed") or how.startswith("left ")):
                continue
            s = session(h, sid, r["cwd"], r["last"], how, r["title"], r["started"])
            s.update(typed=r["typed"], source="sessions.db", path=r.get("path"))
            out.append(s)
    except (OSError, sqlite3.Error, ValueError, TypeError, KeyError) as e:
        print("cgr: recovery index: %s" % e, file=sys.stderr)
    return out


def build_index():
    """Every session every harness on this machine kept, with how each one ended."""
    rows, failed = {}, set()
    for indexer in INDEXERS:
        try:
            for r in indexer():
                rows[(r["harness"], r["id"])] = r
        except (OSError, sqlite3.Error, ValueError, TypeError, KeyError, AttributeError) as e:
            failed.add(indexer.__name__[6:])  # its rows not read this time are not gone
            print("cgr: %s: %s" % (indexer.__name__[6:], e), file=sys.stderr)
    first = {}
    for r in rows.values():
        if r["exit_record"] and r["harness"] in WRITES_EXIT:
            first[r["harness"]] = min(first.get(r["harness"], r["last"] or 0),
                                      r["started"] or r["last"] or 0)
    btime = boot_start()[0]
    live, _ = claude_pids(btime)
    running = {("claude", sid) for sid in live}
    running |= {(s["harness"], s["id"]) for s in running_sessions() if s["id"]}
    named = running_words()
    # A `cgr --save` record is cut-off evidence once its process is gone (the
    # planned restart), unless the harness wrote a deliberate exit record.
    evidence = {k: s for k, s in cut_off(everything=True, use_index=False).items()
                if s.get("id") or s["harness"] in STORE_INDEXERS}
    for s in evidence.values():
        sid = s["id"] or "@%d" % int(s["started"] or s["last"])
        if (s["harness"], sid) in rows:
            continue  # watcher evidence can also resolve an exact id
        path = s.get("path")
        if s["harness"] == "agy" and s["id"]:
            path = HOME / ".gemini/antigravity-cli/conversations" / (s["id"] + ".db")
        r = entry(s["harness"], sid, path, cwd=s["cwd"],
                  source="cli", started=s["started"], title=s["title"])
        r["last"] = s["last"]
        rows[(r["harness"], r["id"])] = dict(r, verdict=None, evidence=s)
    handled = load_handled()
    now = time.time()
    for k, r in rows.items():
        ev = r.pop("evidence", None) or evidence.get(k)
        if k in running or r["id"] in named:
            r["status"], r["how"] = "running", "process alive"
        elif ev and not (ev["how"] == "saved" and r["verdict"] and r["verdict"][0] == "closed"):
            r["status"], r["how"] = "cut off", ev["how"]
        elif r["verdict"]:
            r["status"], r["how"] = r["verdict"]
        elif r["harness"] in first and (r["last"] or 0) >= first[r["harness"]]:
            r["status"], r["how"] = "cut off", "no end record"
        else:
            r["status"], r["how"] = "unknown", "no end record"
        s = dict(session(r["harness"], None if r["id"].startswith("@") else r["id"],
                         r["cwd"], r["last"] or now, r["how"], r["title"]),
                 typed=(ev or {}).get("typed"), argv=(ev or {}).get("argv"))
        r["typed"] = s["typed"]
        r["argv"] = json.dumps(s["argv"]) if s["argv"] else None
        r["resume"] = runnable(s)
        r["reopened"] = handled.get(key(s))
        r["in_store"] = 0 if r["id"].startswith("@") else 1
        r["interactive"] = 0 if r["source"] in AUTOMATED else 1
        r["last_seen"] = r["first_seen"] = now
    return [rows[k] for k in sorted(rows, key=lambda k: -(rows[k]["last"] or 0))], failed

def write_index(rows, failed=()):
    """Upsert into sessions.db. A row outlives its transcript: once a harness
    deletes an old session, the row keeps what was known, with in_store 0."""
    private_dir(STATE)
    path = db_path()
    con = sqlite3.connect(str(path), timeout=10)
    try:
        os.chmod(path, 0o600)
        con.executescript(SCHEMA)
        have = {c[1] for c in con.execute("PRAGMA table_info(sessions)")}
        for c in COLUMNS:
            if c not in have:  # a database an older cgr made
                con.execute("ALTER TABLE sessions ADD COLUMN %s" % c)
        con.executescript(AUDIT_VIEW)
        keep = ("first_seen",)
        sticky = ("status", "how")  # a cut-off verdict outlives the evidence for it
        sets = []
        for c in COLUMNS[2:]:
            if c in keep:
                continue
            if c in sticky:
                sets.append("%s = CASE WHEN excluded.status = 'unknown' AND sessions.status = "
                            "'cut off' THEN sessions.%s ELSE excluded.%s END" % (c, c, c))
            elif c in ("typed", "argv", "reopened"):
                sets.append("%s = COALESCE(excluded.%s, sessions.%s)" % (c, c, c))
            else:
                sets.append("%s = excluded.%s" % (c, c))
        read = sorted({r["harness"] for r in rows} - set(failed))
        with con:
            # cgr no longer mints `@` rows for harnesses that resume by id; older ones left some.
            con.execute("DELETE FROM sessions WHERE id LIKE '@%%' AND harness IN (%s)"
                        % ",".join("?" * len(NATIVE_RECOVERY)), sorted(NATIVE_RECOVERY))
            if read:
                con.execute("UPDATE sessions SET in_store = 0 WHERE harness IN (%s)"
                            % ",".join("?" * len(read)), read)
            con.executemany(
                "INSERT INTO sessions (%s) VALUES (%s) ON CONFLICT(harness, id) DO UPDATE SET %s"
                % (", ".join(COLUMNS), ", ".join("?" * len(COLUMNS)), ", ".join(sets)),
                [tuple(r[c] for c in COLUMNS) for r in rows])
        return con.execute("SELECT %s FROM sessions ORDER BY last DESC" % ", ".join(COLUMNS)) \
            .fetchall()
    finally:
        con.close()


def flagged(r):
    """Worth an audit: you ran it, and it was cut off, or stopped mid-turn with
    no record of how it ended. A clean exit record outranks mid-turn: hermes
    closes a session mid-turn to continue it in a compressed one."""
    return bool(r["interactive"]) and (
        r["status"] == "cut off" or (r["status"] == "unknown" and bool(r["mid_turn"])))


def history_row(r):
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(r["last"] or 0))
    mark = "mid-turn" if r["mid_turn"] else ""
    return clean("%-8s  %-24s  %s  %-8s  %-24s  %s" % (
        r["harness"], short_path(r["cwd"] or "")[-24:], when, mark, (r["how"] or "")[:24],
        r["last_prompt"] or r["title"] or ""))


HISTORY_CAP = 40                # sessions shown before --all; a date is never cut in two


def cap_dates(groups, cap=HISTORY_CAP):
    """The newest date groups holding at least `cap` sessions, each whole."""
    out, n = [], 0
    for day, rows in groups:
        if n >= cap:
            break
        out.append((day, rows))
        n += len(rows)
    return out


def old_history_group(rows):
    return (rows[0]["last"] or 0) < time.time() - 7 * 86400


def print_history_groups(groups, collapse, preview):
    width = shutil.get_terminal_size((160, 20)).columns
    for day, grows in groups:
        folded = collapse and old_history_group(grows)
        tail = _c(" [collapsed; --expand-old shows sessions]", "2") if folded else ""
        print(history_group_label(day, grows) + tail)
        if not folded:
            for r in grows:
                print("  " + history_row(r)[:width - 3])
                if preview and preview_line(r):
                    print("    " + preview_line(r)[:width - 3])
        print()


def show_history(everything=False, as_json=False, list_only=False, groups=None, days=None,
                 yes=False, expand_old=False, preview=False):
    rows = [dict(zip(COLUMNS, t)) for t in write_index(*build_index())]
    if as_json:
        print(json.dumps(rows, indent=1))
        return 0
    by = {}
    for r in rows:
        c = by.setdefault(r["harness"], dict.fromkeys(
            ("sessions", "running", "closed", "cut off", "unknown", "mid-turn"), 0))
        c["sessions"] += 1
        c[r["status"]] = c.get(r["status"], 0) + 1
        c["mid-turn"] += 1 if r["mid_turn"] else 0
    print("cgr: %d sessions from %d harnesses, in\n%s\n" % (len(rows), len(by), db_path()))
    cols = ("sessions", "running", "closed", "cut off", "unknown", "mid-turn")
    print("  %-9s" % "harness" + "".join("%9s" % c for c in cols))
    for h in sorted(by, key=lambda h: -by[h]["sessions"]):
        print("  %-9s" % h + "".join("%9d" % by[h][c] for c in cols))
    flagged_rows = [r for r in rows if flagged(r)]
    # A row without an id could only be reopened with "continue the newest",
    # which is not necessarily the session that died.
    bad = [r for r in flagged_rows if not r["id"].startswith("@")]
    every = history_groups(bad)
    selected = bool(days or groups)
    if days:
        every = [g for g in every if g[0] in days]
    shown = every if everything or days else cap_dates(every)
    if groups:
        want = {int(n) - 1 for spec in groups for n in str(spec).split(",") if n.strip().isdigit()}
        shown = [g for i, g in enumerate(shown) if i in want]
    if selected and not shown:
        print("\ncgr: no sessions in %s" % ("day(s) %s" % ", ".join(days) if days and not groups
                                           else "group(s) %s" % ", ".join(groups)))
        return 0
    shown_rows = [r for _, g in shown for r in g]
    total = sum(len(g) for _, g in every)
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if yes:
        print("\nReopening %d session%s from %d date%s" % (
            len(shown_rows), "" if len(shown_rows) == 1 else "s", len(shown), "" if len(shown) == 1 else "s"))
        return reopen_history(shown_rows)
    if list_only or not interactive:
        note = ""
        if not selected and not everything and len(shown_rows) < total:
            note = " (showing %d of %d, whole dates; --all shows every one)" % (len(shown_rows), total)
        print("\n%d you ran were cut off or left mid-turn, newest first%s:\n" % (total, note))
        print_history_groups(shown, not (expand_old or selected), preview)
        if len(flagged_rows) > len(bad):
            print("%d more have no session id, so cannot be reopened by id from here "
                  "(`cgr` reopens this boot's)\n" % (len(flagged_rows) - len(bad)))
        print("audit them:   sqlite3 -box %s 'SELECT * FROM audit'" % shlex.quote(str(db_path())))
        return 0
    chosen = choose_history(shown_rows, shown, preview=preview)
    if not chosen:
        print("nothing reopened")
        return 0
    return reopen_history(chosen)


# -- the command a tab runs --------------------------------------------------

def history_groups(rows):
    """Date groups, newest first: (date label, rows newest-first)."""
    groups = {}
    for r in sorted(rows, key=lambda r: -(r["last"] or 0)):
        day = time.strftime("%Y-%m-%d", time.localtime(r["last"] or 0))
        groups.setdefault(day, []).append(r)
    return list(groups.items())


def history_kind(r):
    how = r.get("how")
    return "saved" if how == "saved" else "window" if how in ("window closed", "killed") else "crash"


def history_group_label(day, rows):
    """Date + count, colored like the picker by the date's dominant kind (a tie
    takes the worse): green saved, yellow window, red crash. A mixed date also
    spells out its counts, so one old crash neither paints a saved date red nor
    hides inside it."""
    stamp = time.strftime("%a %Y-%m-%d", time.localtime(rows[0]["last"] or 0)) if rows else day
    counts = {}
    for r in rows:
        counts[history_kind(r)] = counts.get(history_kind(r), 0) + 1
    code = "32"
    for kind, c in (("window", "33"), ("crash", "31")):  # later wins a tie
        if counts.get(kind, 0) and counts[kind] >= max(counts.values()):
            code = c
    detail = ""
    if len(counts) > 1:
        detail = ": " + ", ".join("%d %s" % (counts[k], k) for k in ("saved", "window", "crash")
                                  if k in counts)
    label = "%s  [%s, %d session%s%s]" % (stamp, day, len(rows), "" if len(rows) == 1 else "s", detail)
    return _c(label, "1;" + code)


def choose_history(rows, groups, preview=False):
    """A date group per line with its count; space expands one group into its
    sessions, and inside an open group space picks sessions to reopen."""
    import termios
    import tty
    fd = sys.stdin.fileno()
    picked, cur = set(), 0
    open_day = None
    width = shutil.get_terminal_size((120, 20)).columns
    help_line = ("  up/down move   space open group / pick session   "
                 "a all/none in group   enter reopen   q quit")

    def entries():
        rows_out = []
        for day, grows in groups:
            rows_out.append((day, None))
            if day == open_day:
                rows_out.extend((day, r) for r in grows)
        return rows_out

    def lines_of(day, r):
        """The screen lines of one entry; only the first is the highlighted one."""
        if r is None:
            grows = dict(groups)[day]
            n = len(picked & {(x["harness"], x["id"]) for x in grows})
            tick = "x" if n == len(grows) and grows else "+" if n else " "
            marker = "-" if day == open_day else "+"
            return ["%s [%s] %s" % (marker, tick, history_group_label(day, grows))]
        key = (r["harness"], r["id"])
        head = "    " + _c("[x] " if key in picked else "[ ] ", "1;32" if key in picked else "2")
        out = [head + history_row(r)]
        if preview and preview_line(r):
            out.append("        " + preview_line(r))
        if r.get("resume"):
            out.append("        " + _c(r["resume"], "2"))
        return out

    def draw(first):
        nonlocal drawn, top
        ents = entries()
        height = shutil.get_terminal_size((120, 24)).lines
        budget = max(2, height - 2)
        shown = [lines_of(day, r) for day, r in ents]
        top = min(top, cur)
        while top < cur and sum(len(x) for x in shown[top:cur + 1]) > budget:
            top += 1
        screen, used = [], 0
        for pos in range(top, len(ents)):
            if used + len(shown[pos]) > budget and screen:
                break
            for n, text in enumerate(shown[pos][:max(1, budget - used)]):
                line = ("%s %s" % (">" if pos == cur and n == 0 else " ", text))[:width - 1]
                screen.append("\x1b[7m%s\x1b[0m" % line if pos == cur and n == 0 else line)
            used = len(screen)
        out = [] if first else ["\r\x1b[%dA" % drawn]
        out.extend("\r\x1b[K" + line + "\n" for line in screen)
        if drawn > len(screen):
            out.extend("\r\x1b[K\n" for _ in range(drawn - len(screen)))
            out.append("\r\x1b[%dA" % (drawn - len(screen)))
        drawn = len(screen)
        out.append("\r\x1b[K" + help_line[:width - 1])
        sys.stdout.write("".join(out))
        sys.stdout.flush()

    top = 0
    drawn = 0
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\x1b[?25l")
        draw(True)
        while True:
            k = os.read(fd, 1)
            while k in (b"\x1b", b"\x1b[", b"\x1bO") and select.select([fd], [], [], 0.05)[0]:
                k += os.read(fd, 1)
                if k != b"\x1b" and k not in (b"\x1b[", b"\x1bO"):
                    break
            ents = entries()
            if k in (b"\x1b[A", b"\x1bOA", b"k"):
                cur = (cur - 1) % len(ents)
            elif k in (b"\x1b[B", b"\x1bOB", b"j"):
                cur = (cur + 1) % len(ents)
            elif k == b" ":
                day, r = ents[cur]
                if r is None:
                    # Space opens a closed date; on the open date it closes it again.
                    open_day = None if day == open_day else day
                    if day == open_day:
                        cur = next(i for i, e in enumerate(entries()) if e[0] == day and e[1] is not None)
                    else:
                        cur = next(i for i, e in enumerate(entries()) if e == (day, None))
                else:
                    key = (r["harness"], r["id"])
                    picked.discard(key) if key in picked else picked.add(key)
            elif k == b"a":
                grows = dict(groups)[ents[cur][0]]
                keys = {(x["harness"], x["id"]) for x in grows}
                picked -= keys if keys <= picked else picked | keys
            elif k in (b"\r", b"\n"):
                return [r for r in rows if (r["harness"], r["id"]) in picked]
            elif k in (b"", b"q", b"\x1b", b"\x03", b"\x04"):
                return []
            draw(False)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?25h\n")
        sys.stdout.flush()

def resume_args(s):
    by_id, cont, _ = HARNESSES.get(s["harness"], (None, None, set()))
    if s["id"] and by_id:
        return [a.replace("{id}", s["id"]) for a in by_id]
    return list(cont or [])


def strip_args(args, strip, harness=None):
    """Drop old session-picking flags, and typed prompts, which must not be re-sent."""
    out, drop_value, value, many = [], False, False, False
    values = VALUE_FLAGS.get(harness, {"--model", "-m"})
    multi = MULTI_VALUE_FLAGS.get(harness, set())
    for a in args:
        if drop_value:
            drop_value = False
            if not a.startswith("-"):
                continue
        if a.split("=", 1)[0] in strip:
            drop_value = "=" not in a
            value = many = False
            continue
        if a == "--":
            break  # the rest is a prompt, even if it starts with a dash
        if a.startswith("-"):
            out.append(a)
            flag = a.split("=", 1)[0]
            value = "=" not in a and flag in values
            many = value and flag in multi
            continue
        if value:
            out.append(a)
            value = many
    return out


def command(s):
    """What you typed, minus old session flags, plus this harness's resume."""
    h = s["harness"]
    session_flags = HARNESSES.get(h, (None, None, set()))[2]
    strip = session_flags | PROMPT_FLAGS.get(h, set())
    extra = resume_args(s)
    tail_text = " " + shlex.join(extra) if extra else ""
    typed = s.get("typed")
    if typed:
        segs = segments(typed)
        prefix = "".join(x + " && " for x in segs[:-1] if not re.match(r"cd(\s|$)", x))
        last = segs[-1]
        words = None if re.search(r"[$`|<>]", last) else words_of(last)
        if words:
            i = head_word(words)
            if os.path.basename(words[i]) != h:
                exp = words_of(aliases().get(words[i], "")) or []
                at = [j for j, w in enumerate(exp) if os.path.basename(w) == h]
                if at and any(w.split("=", 1)[0] in session_flags for w in exp[at[-1] + 1:]):
                    return prefix + last  # the alias picks its session itself (--continue)
            return prefix + shlex.join(words[:i + 1] + strip_args(words[i + 1:], strip, h) + extra)
        return prefix + last + tail_text
    argv = s.get("argv") or [h]
    hit = harness_of(argv)
    at = hit[1] if hit else 0
    return shlex.join([h] + strip_args(argv[at + 1:], strip, h) + extra)


# -- showing -----------------------------------------------------------------

CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def clean(text):
    """Text safe for the terminal. Titles are prompts and model-written thread
    names, so a control character in one is shown as '?', never sent as an
    escape sequence."""
    return CONTROL.sub(lambda m: " " if m.group() in "\t\n\r" else "?", str(text))


def short_path(p):
    home = str(HOME)
    return "~" + p[len(home):] if p == home or p.startswith(home + "/") else p


def row(s):
    when = time.strftime("%m-%d %H:%M", time.localtime(s["last"]))
    return clean("%-8s  %-26s  %-11s  %-17s  %s" % (
        s["harness"], short_path(s["cwd"])[-26:], when, s["how"], s["title"]))


def how_color(s):
    """Group color by provenance: green=saved, red=crash, yellow=current."""
    if s.get("how") == "saved":
        return "32"
    if s.get("event", {}).get("kind") in ("window closed", "killed"):
        return "33"
    return "31"


def row_colored(s):
    """Recovery row with harness in green and how in its group color."""
    when = time.strftime("%m-%d %H:%M", time.localtime(s["last"]))
    base = clean("%-8s  %-26s  %-11s  %-17s  %s" % (
        s["harness"], short_path(s["cwd"])[-26:], when, s["how"], s["title"]))
    if not USE_COLOR:
        return base
    harness = clean(str(s["harness"]))
    how = clean(str(s["how"]))
    start = base.find(how)
    head = base[len(harness):start] if start > 0 else base[len(harness):]
    return (color("1;32") + harness + color("0") + head
            + color("1;" + how_color(s)) + how + color("0")
            + base[start + len(how):])


def preview_line(s):
    """Content preview: id, messages/bytes, model, last prompt."""
    bits = []
    if s.get("id"):
        bits.append("id %s" % clean(str(s["id"]))[:13])
    if s.get("messages"):
        bits.append("%d msgs" % s["messages"])
    if s.get("bytes"):
        bits.append("%.0fKB" % (s["bytes"] / 1024))
    if s.get("model"):
        bits.append(clean(str(s["model"]))[:28])
    if s.get("mid_turn"):
        bits.append("mid-turn")
    last = clean(str(s.get("last_prompt") or ""))[:90]
    if not bits and not last:
        return ""
    head = _c(" | ", "2") + _c("  ".join(bits), "36") if bits else ""
    tail = _c(" | " + last, "2") if last else ""
    return head + tail


def runnable(s):
    """The line to paste to reopen a session by hand, as printed."""
    return clean("cd %s && %s" % (shlex.quote(s["cwd"]), command(s)))


def event_groups(items):
    groups = {}
    for i, s in enumerate(items):
        groups.setdefault(s["group"], []).append(i)
    return list(groups.values())


def old_group(s):
    return (s["event"].get("end") or s["last"]) < time.time() - 7 * 86400


def event_title(s):
    ev = s["event"]
    stamp = lambda t: time.strftime("%Y-%m-%d %H:%M", time.localtime(t)) if t else "still running"
    if ev["kind"] in ("window closed", "killed", "saved"):
        return clean("%s at %s; boot began %s" % (ev["kind"], stamp(ev["end"]), stamp(ev["start"])))
    if ev["kind"] == "unmatched activity":
        return clean("Activity on %s; no boot association" % stamp(ev["end"])[:10])
    return clean("Boot %s to %s; %s" % (stamp(ev["start"]), stamp(ev["end"]), ev["end_kind"]))


def group_label(s, n):
    """Colored group header: title + date/time + session count, provenance color."""
    title = event_title(s)
    stamp = time.strftime("%Y-%m-%d %H:%M", time.localtime(s["event"].get("end") or s["last"]))
    label = "%s  [%s, %d session%s]" % (title, stamp, n, "" if n == 1 else "s")
    return _c(label, "1;" + how_color(s))


def show_recovery(items, expand_old=False, commands=True, preview=False):
    width = shutil.get_terminal_size((120, 20)).columns
    for indexes in event_groups(items):
        s = items[indexes[0]]
        collapsed = old_group(s) and not expand_old
        tail = " [collapsed; --expand-old shows sessions]" if collapsed else ""
        print("%s%s" % (group_label(s, len(indexes)), _c(tail, "2") if tail else ""))
        if not collapsed:
            for i in indexes:
                print("  " + row_colored(items[i])[:width + 30])
                if preview:
                    pv = preview_line(items[i])
                    if pv:
                        print("    " + pv[:width - 3])
                if commands:
                    print("      " + runnable(items[i]))
        print()


def choose(items, expand_old=False, preview=False):
    """Space on a header selects its whole group. Old groups start collapsed and unticked."""
    import termios
    import tty
    fd = sys.stdin.fileno()
    picked, cur = [not old_group(s) for s in items], 0
    show_preview = preview
    groups = event_groups(items)
    expanded = {items[ix[0]]["group"] for ix in groups if expand_old or not old_group(items[ix[0]])}
    width = shutil.get_terminal_size((120, 20)).columns
    help_line = "  up/down move   space group/session   o expand/collapse   a all/none   p preview   enter reopen   q quit"
    drawn = 0

    def entries():
        rows = []
        for indexes in groups:
            rows.append((indexes, True))
            if items[indexes[0]]["group"] in expanded:
                rows.extend(([i], False) for i in indexes)
        return rows

    def draw(first):
        nonlocal drawn
        rows = entries()
        height = shutil.get_terminal_size((120, 24)).lines
        count = max(1, height - 3)
        start = max(0, min(cur - count // 2, len(rows) - count))
        visible = rows[start:start + count]
        out = [] if first else ["\r\x1b[%dA" % drawn]
        for pos, (indexes, header) in enumerate(visible, start):
            state = "x" if all(picked[i] for i in indexes) else "+" if any(picked[i] for i in indexes) else " "
            s = items[indexes[0]]
            if header:
                label = group_label(s, len(indexes)) + (_c(" [collapsed]", "2") if s["group"] not in expanded else "")
            else:
                label = "  " + row_colored(s)
                if show_preview:
                    pv = preview_line(s)
                    if pv:
                        label += "\n      " + pv
            line = ("%s [%s] %s" % (">" if pos == cur else " ", state, label))[:width - 1]
            out.append("\r\x1b[K" + ("\x1b[7m%s\x1b[0m" % line if pos == cur else line) + "\n")
        # Clear leftover rows after collapsing a group, then return to the help line.
        if drawn > len(visible):
            out.extend("\r\x1b[K\n" for _ in range(drawn - len(visible)))
            out.append("\r\x1b[%dA" % (drawn - len(visible)))
        drawn = len(visible)
        out.append("\r\x1b[K" + help_line[:width - 1])
        sys.stdout.write("".join(out))
        sys.stdout.flush()

    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\x1b[?25l")
        draw(True)
        while True:
            k = os.read(fd, 1)
            while k in (b"\x1b", b"\x1b[", b"\x1bO") and select.select([fd], [], [], 0.05)[0]:
                k += os.read(fd, 1)
                if k != b"\x1b" and k not in (b"\x1b[", b"\x1bO"):
                    break
            rows = entries()
            if k in (b"\x1b[A", b"\x1bOA", b"k"):
                cur = (cur - 1) % len(rows)
            elif k in (b"\x1b[B", b"\x1bOB", b"j"):
                cur = (cur + 1) % len(rows)
            elif k == b" ":
                indexes = rows[cur][0]
                value = not all(picked[i] for i in indexes)
                for i in indexes:
                    picked[i] = value
            elif k == b"o":
                gid = items[rows[cur][0][0]]["group"]
                if gid in expanded:
                    expanded.remove(gid)
                else:
                    expanded.add(gid)
                cur = next(i for i, (ix, header) in enumerate(entries())
                           if header and items[ix[0]]["group"] == gid)
            elif k == b"a":
                picked = [not all(picked)] * len(items)
            elif k == b"p":
                show_preview = not show_preview
            elif k in (b"\r", b"\n"):
                return [s for s, p in zip(items, picked) if p]
            elif k in (b"", b"q", b"\x1b", b"\x03", b"\x04"):
                return []
            draw(False)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?25h\n")
        sys.stdout.flush()


# -- reopening ---------------------------------------------------------------

def run_argv(s):
    """cd, run the command through your interactive shell (so aliases work),
    then stay in a shell there. CGR_LAUNCH carries the typed line to the
    watcher, so a reopened session keeps its original launch command."""
    shell = os.environ.get("SHELL") or "/bin/zsh"
    launch = "export CGR_LAUNCH=%s; " % shlex.quote(s.get("typed") or command(s))
    inner = "cd %s && { %s%s; }; exec %s -l" % (shlex.quote(s["cwd"]), launch, command(s),
                                               shlex.quote(shell))
    return [shell, "-lic", inner]


def tab_title(s):
    return clean("%s %s" % (s["harness"], short_path(s["cwd"])))


def wezterm_window(cli):
    """The window to add tabs to. WEZTERM_PANE does not cross into WSL, so ask
    the mux which pane has focus, and fall back to the only window there is."""
    def ask(*args):
        r = subprocess.run([cli, "cli", *args, "--format", "json"],
                           capture_output=True, text=True, timeout=10)
        return json.loads(r.stdout) if r.returncode == 0 else []
    try:
        panes = ask("list")
        pane = os.environ.get("WEZTERM_PANE")
        if pane is None:
            clients = [c for c in ask("list-clients") if c.get("focused_pane_id") is not None]
            clients.sort(key=lambda c: (c.get("idle_time") or {}).get("secs", 1 << 30))
            pane = clients[0]["focused_pane_id"] if clients else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    for p in panes:
        if str(p.get("pane_id")) == str(pane):
            return p.get("window_id")
    windows = {p.get("window_id") for p in panes}
    return windows.pop() if len(windows) == 1 else None


def open_wezterm(cli, items):
    window = wezterm_window(cli)
    distro = os.environ.get("WSL_DISTRO_NAME")
    domain = ["--domain-name", "WSL:" + distro] if distro and cli.endswith(".exe") else []
    place = ["--window-id", str(window)] if window is not None else ["--new-window"]
    for s in items:
        r = subprocess.run([cli, "cli", "spawn", *domain, *place, "--", *run_argv(s)],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            raise RuntimeError("wezterm cli spawn: " + (r.stderr.strip() or "failed"))
        try:
            subprocess.run([cli, "cli", "set-tab-title", "--pane-id", r.stdout.strip(),
                            tab_title(s)], capture_output=True, timeout=10)
        except (OSError, subprocess.SubprocessError) as e:
            print("cgr: tab opened; could not set its title: %s" % e, file=sys.stderr)
        yield s


def open_windows_terminal(items):
    distro = os.environ.get("WSL_DISTRO_NAME", "")
    for s in items:
        # wt.exe splits its own command line on ';', so escape them for the shell.
        argv = [a.replace(";", "\\;") for a in run_argv(s)]
        r = subprocess.run(["wt.exe", "-w", "0", "new-tab", "--title", tab_title(s), "wsl.exe",
                            *(["-d", distro] if distro else []), "--exec", *argv],
                           capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            raise RuntimeError("wt.exe new-tab: " + (r.stderr.strip() or "failed"))
        yield s


def open_tmux(items, inside):
    for i, s in enumerate(items):
        if inside or i or subprocess.run(["tmux", "has-session", "-t", "cgr"],
                                         capture_output=True).returncode == 0:
            target = [] if inside else ["-t", "cgr"]
            argv = ["tmux", "new-window", *target, "-n", tab_title(s), "-c", s["cwd"]]
        else:
            argv = ["tmux", "new-session", "-d", "-s", "cgr", "-n", tab_title(s), "-c", s["cwd"]]
        if subprocess.run(argv + run_argv(s)).returncode != 0:
            raise RuntimeError("tmux could not open a window")
        yield s


def reopen(items):
    """Open each item in a new tab of the terminal cgr was run from."""
    requested = items
    items = []
    for s in requested:
        if Path(s["cwd"]).is_dir():
            items.append(s)
        else:
            print("cgr: working directory is unavailable: %s" % clean(s["cwd"]), file=sys.stderr)
    wez = shutil.which("wezterm") or shutil.which("wezterm.exe")
    if not items:
        how, opener = None, iter(())
    elif os.environ.get("TMUX") and shutil.which("tmux"):
        how, opener = "tmux windows", open_tmux(items, inside=True)
    elif os.environ.get("TERM_PROGRAM") == "WezTerm" and wez:
        how, opener = "WezTerm tabs", open_wezterm(wez, items)
    elif os.environ.get("WT_SESSION") and shutil.which("wt.exe"):
        how, opener = "Windows Terminal tabs", open_windows_terminal(items)
    elif shutil.which("tmux"):
        how, opener = "tmux session 'cgr'", open_tmux(items, inside=False)
    else:
        how, opener = None, iter(())
    done = []
    try:
        for s in opener:
            done.append(s)
    except (OSError, RuntimeError, subprocess.SubprocessError) as e:
        print("cgr: %s" % e, file=sys.stderr)
    if done:
        mark_handled(done)
        print("reopened %d as %s" % (len(done), how))
    left = [s for s in requested if s not in done]
    if left:
        print("run these yourself:" if how is None else "not reopened -- run these yourself:")
        for s in left:
            print("  " + runnable(s))
    if done and how == "tmux session 'cgr'" and sys.stdout.isatty():
        os.execvp("tmux", ["tmux", "attach", "-t", "cgr"])
    return 0 if not left else 1


def reopen_history(rows):
    """Reopen `cgr --history` picks, which name the session but not the window."""
    items = []
    for r in rows:
        if str(r["id"]).startswith("@"):
            print("cgr: %s %s has no session id; reopen it with `cgr` or by hand"
                  % (r["harness"], clean(r["id"])), file=sys.stderr)
            continue
        s = session(r["harness"], r["id"], r.get("cwd"), r.get("last"),
                    r.get("how") or "cut off", r.get("title") or "", r.get("started"))
        s.update(typed=r.get("typed"), path=r.get("path"), source="sessions.db")
        s.update({f: r[f] for f in ("messages", "bytes", "model", "mid_turn", "last_prompt")
                  if r.get(f)})
        try:
            argv = json.loads(r["argv"]) if r.get("argv") else None
        except ValueError:
            argv = None
        if isinstance(argv, list):
            s["argv"] = argv
        items.append(s)
    return reopen(items)


# -- main --------------------------------------------------------------------

def select_groups(items, specs):
    """Filter items to the numbered groups `--list` shows. Numbers are 1-based
    in display order; bad numbers are ignored."""
    groups = event_groups(items)
    want = set()
    for spec in specs or []:
        for part in str(spec).split(","):
            part = part.strip()
            if part.isdigit():
                want.add(int(part) - 1)
    if not want:
        return items
    keep = set()
    for gi, indexes in enumerate(groups):
        if gi in want:
            keep.update(indexes)
    return [s for i, s in enumerate(items) if i in keep]


def main(argv=None):
    ap = argparse.ArgumentParser(prog="cgr", description=__doc__.split("\n\n")[0])
    ap.add_argument("--list", "-l", action="store_true",
                    help="print what died and the command each would run")
    ap.add_argument("--yes", "-y", action="store_true", help="reopen all without asking")
    ap.add_argument("--dry-run", "-n", action="store_true", help="same as --list")
    ap.add_argument("--all", "-a", action="store_true",
                    help="include sessions that died before the last boot that had agents running")
    ap.add_argument("--expand-old", action="store_true",
                    help="show sessions in groups older than seven days (--all includes the groups)")
    ap.add_argument("--preview", "-p", action="store_true",
                    help="show a content-preview line under each session (id, msgs, model, last prompt)")
    ap.add_argument("--group", "-g", action="append", default=None, metavar="N",
                    help="restrict --list/--yes to group number(s) shown by --list (1-based, repeatable)")
    ap.add_argument("--day", action="append", default=None, metavar="YYYY-MM-DD",
                    help="with --history: only this date (repeatable); expands it, and --yes reopens it")
    ap.add_argument("--brief", action="store_true",
                    help="print one colored group-header line per group (no sessions), for startup display")
    ap.add_argument("--forget", action="store_true", help="stop listing the sessions shown now")
    ap.add_argument("--save", action="store_true",
                    help="record every agent running now; the next cgr reopens them")
    ap.add_argument("--history", action="store_true",
                    help="browse every unfinished session grouped by date; --list prints "
                         "the groups, --all shows every date")
    ap.add_argument("--notify", action="store_true", help="one line if anything died")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--watch", action="store_true", help="run the watcher (systemd does this)")
    args = ap.parse_args(argv)

    if args.watch:
        return watch()
    if args.history:
        if args.yes and not (args.group or args.day):
            print("cgr: --yes with --history needs --group N or --day YYYY-MM-DD; "
                  "without one, pick from --history instead")
            return 1
        return show_history(everything=args.all, as_json=args.json,
                            list_only=args.list or args.dry_run, groups=args.group,
                            days=args.day, yes=args.yes, expand_old=args.expand_old,
                            preview=args.preview)
    if args.save:
        items = save()
        if not items:
            print("cgr: no agent is running on a terminal, so there is nothing to save")
            return 0
        print("cgr: saved %d running session%s. After the restart, run cgr to reopen them.\n"
              % (len(items), "" if len(items) == 1 else "s"))
        for s in items:
            print("  " + row(s)[:shutil.get_terminal_size((120, 20)).columns - 3])
            print("      " + runnable(s))
        return 0
    items = collect(everything=args.all)
    for s in items:
        s["command"] = command(s)

    if args.json:
        print(json.dumps(items, indent=1))
        return 0
    if args.notify:
        if items:
            names = ", ".join(tab_title(s) for s in items[:3])
            more = " and %d more" % (len(items) - 3) if len(items) > 3 else ""
            print("\033[33mcgr:\033[0m %d agent session%s died (%s%s) -- run \033[1mcgr\033[0m "
                  "to reopen" % (len(items), "" if len(items) == 1 else "s", names, more))
        return 0
    if args.group:
        items = select_groups(items, args.group)
        if not items:
            print("cgr: no sessions in group(s) %s" % ", ".join(args.group))
            return 0

    if args.brief:
        for indexes in event_groups(items):
            print(group_label(items[indexes[0]], len(indexes)))
        return 0
    if not watcher_running(current_boot()[1]):
        print("cgr: the watcher is not running, so only claude windows that close are caught."
              "\n     start it: systemctl --user enable --now cgr-watch\n")
    if not items:
        print("cgr: nothing died -- no agent session was cut off since the last boot with agents began"
              + ("" if args.all else " (--all looks further back)"))
        return 0
    if args.forget:
        mark_handled(items)
        print("cgr: forgot %d session%s" % (len(items), "" if len(items) == 1 else "s"))
        return 0

    print("These agent sessions were cut off:\n")
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if args.list or args.dry_run or args.yes or not interactive:
        show_recovery(items, expand_old=args.expand_old, preview=args.preview,
                      commands=args.list or args.dry_run or not interactive)
        if args.list or args.dry_run:
            return 0
        if not args.yes:
            print("\nnot a terminal: run `cgr --yes` to reopen all, or the commands above")
            return 0
        print(_c("Reopening %d session%s:" % (len(items), "" if len(items) == 1 else "s"), "1;32"))
        for indexes in event_groups(items):
            print("  " + group_label(items[indexes[0]], len(indexes)))
        chosen = items
    else:
        chosen = choose(items, expand_old=args.expand_old, preview=args.preview)
        if not chosen:
            print("nothing reopened")
            return 0
    return reopen(chosen)


if __name__ == "__main__":
    sys.exit(main())
