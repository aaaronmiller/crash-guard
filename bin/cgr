NO_COLOR = os.environ.get("NO_COLOR")
USE_COLOR = sys.stdout.isatty() and not NO_COLOR and os.environ.get("TERM") != "dumb"


def color(code):
    return "\033[%sm" % code if USE_COLOR else ""


def _c(text, *codes):
    """Wrap text in color codes when the terminal supports them."""
    if not USE_COLOR or not codes:
        return text
    return "".join(color(c) for c in codes) + text + color("0")


