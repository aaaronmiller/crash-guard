#!/usr/bin/env python3
# ---
# date: 2026-09-02 00:00:00 PT
# ---
"""Find the agent sessions that were open when the machine last died, and print
the command to resume each one.

## Why this exists alongside cg-forensic

`cg-forensic` reconstructs a crash from *inferential* signals: startup markers,
file mtimes, SQLite WAL residue, scored for convergence. That was the right
design when nobody knew what the harnesses recorded, and it grades 0.6 recall /
1.0 precision -- it is never wrong about a session it names, but it misses two
in five.

It misses them because it is inferring answers that two harnesses write down
explicitly. The 2026-09-02 handoff established the tells:

- **omp** closes a session with a final `{"type":"custom","customType":
  "session_exit"}` record. Anything else as the last record means the session
  was still open. Verified here: 40 graceful, 27 open across 68 files.
- **hermes** keeps sessions in `~/.hermes/state.db`, not per-file. A clean close
  sets `ended_at` and an `end_reason` (`cli_close`, `agent_close`,
  `cron_complete`, `compression`, ...). `ended_at IS NULL` means it never closed.
  Verified here: 611 sessions, 163 never-ended.

For those two the answer is a fact, not a score. This tool reads the fact where
one exists and falls back to the heuristic only where none does.

## Where no marker exists

**codex** and legacy **pi** write no terminal record of any kind -- a transcript
simply stops, and a clean exit is indistinguishable from a power cut by record
type. For those, two signals must agree:

1. the last write falls in the gap before the current boot, and
2. the final turn is *unfinished* -- an assistant `tool_use` with no matching
   `tool_result`, or a user turn with no reply.

An idle session that was closed cleanly fails (2); a background process touching
a file fails it too. Requiring both is what keeps precision high.

**claude code** starts out in that group and graduates: installing
`bin/cg-session-end` as a `SessionEnd` hook gives it omp's marker. From the
first transcript that carries one, a *missing* marker on a later session is
definitive rather than heuristic -- `marker_epoch()` calibrates that cutoff from
the data instead of trusting a settings-file mtime, because transcripts written
before the hook existed have no marker either and must not be misread as
crashes.

## Reopening them in the right place

Every live harness records its own working directory -- omp as `cwd` on its
`session` record, hermes in `sessions.cwd`, claude on ordinary records -- so
restoring a session to the folder it was running in is a lookup, not a guess.
`--restore` reads that field and opens each chosen session in its own tmux
window, already `cd`'d there.

Usage:
    cg-recover                     sessions open at the last boot
    cg-recover --restore           pick from the list and reopen them in tmux
    cg-recover --restore --yes     reopen all of them, no prompt
    cg-recover --since <iso>       widen the window
    cg-recover --resume            print resume commands only
    cg-recover --json              machine-readable
    cg-recover --all-open          every never-closed session, not just the crash
    cg-recover --history           group every never-closed session by the boot
                                   that ended it, to mine past crashes for
                                   work that was cut off
"""
from __future__ import annotations

import argparse
import datetime as dt
import glob
import json
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys

HOME = os.path.expanduser("~")


def boot_time():
    """Epoch of the current boot. `uptime -s` is local time, no timezone."""
    try:
        out = subprocess.run(["uptime", "-s"], capture_output=True, text=True).stdout.strip()
        return dt.datetime.strptime(out, "%Y-%m-%d %H:%M:%S").timestamp()
    except Exception:
        try:
            with open("/proc/uptime") as fh:
                return dt.datetime.now().timestamp() - float(fh.read().split()[0])
        except Exception:
            return 0.0


def boot_history():
    """Every boot start time `last reboot` knows about, oldest first.

    wtmp survives in WSL, so the boot boundaries are real rather than inferred.
    The oldest entry is where the log begins, not where the machine's history
    begins -- so sessions older than it all appear to have died at that first
    boundary. `--history` labels that bucket rather than ranking it, for that reason.
    """
    try:
        out = subprocess.run(["last", "reboot"], capture_output=True,
                             text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    year = dt.date.today().year
    stamps = []
    for line in out.splitlines():
        m = re.search(r"(\w{3}\s+\w{3}\s+\d+\s+\d+:\d+)", line)
        if not m:
            continue
        for y in (year, year - 1):
            try:
                stamps.append(dt.datetime.strptime(
                    f"{m.group(1)} {y}", "%a %b %d %H:%M %Y").timestamp())
                break
            except ValueError:
                continue
    return sorted(set(stamps))


def tail_json(path, probe=8):
    """Last parseable JSON record, and the last few, without reading the file twice."""
    try:
        with open(path, encoding="utf-8", errors="ignore") as fh:
            lines = [l for l in fh if l.strip()]
    except OSError:
        return None, []
    recs = []
    for l in lines[-probe:]:
        try:
            recs.append(json.loads(l))
        except ValueError:
            pass
    return (recs[-1] if recs else None), recs


def head_json(path, n=6):
    """First few parseable records. Harnesses put session metadata at the top."""
    recs = []
    try:
        with open(path, encoding="utf-8", errors="ignore") as fh:
            for i, line in enumerate(fh):
                if i >= n:
                    break
                try:
                    recs.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        pass
    return recs


def recorded_cwd(path, n=6):
    """The directory the session was actually running in, per its own log.

    Every live harness writes this down, so there is nothing to reconstruct:
    omp emits `{"type":"session", ..., "cwd": ...}` as its second record, and
    claude puts `cwd` on ordinary records. Deriving it from the store's
    `<cwd-slug>` directory name instead would be guesswork -- the slug replaces
    every `/` with `-`, so `-code-crash-guard` is equally `/code/crash/guard`
    and `/code/crash-guard`, and only one of those exists.
    """
    for d in head_json(path, n):
        cwd = d.get("cwd")
        if isinstance(cwd, str) and cwd.startswith("/"):
            return cwd
    return None


def first_last_user_text(path, limit=400):
    """First and last human-authored message, for identifying the window."""
    first = last = None
    try:
        with open(path, encoding="utf-8", errors="ignore") as fh:
            for line in fh:
                if '"user"' not in line and "'user'" not in line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                msg = d.get("message") or d
                if (msg.get("role") or d.get("type")) != "user":
                    continue
                c = msg.get("content")
                if isinstance(c, list):
                    c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                if not isinstance(c, str):
                    continue
                t = " ".join(c.split())
                if len(t) < 8 or t.startswith("<"):
                    continue
                if first is None:
                    first = t[:limit]
                last = t[:limit]
    except OSError:
        pass
    return first, last


def unfinished_turn(recs):
    """True when the transcript stops mid-work.

    A tool_use with no following tool_result, or a user turn with no assistant
    reply. This is the only structural difference between a transcript that
    ended and one that was cut off, for harnesses with no terminal record.
    """
    if not recs:
        return False
    saw_tool_use = False
    for r in recs:
        msg = r.get("message") or {}
        content = msg.get("content")
        if isinstance(content, list):
            for c in content:
                if not isinstance(c, dict):
                    continue
                if c.get("type") == "tool_use":
                    saw_tool_use = True
                elif c.get("type") == "tool_result":
                    saw_tool_use = False
    if saw_tool_use:
        return True
    # Find the last actual conversation turn. Claude Code interleaves records
    # that are not turns at all -- `system`, `attachment`, `last-prompt`,
    # `file-history-snapshot` -- and writes them *after* the final exchange.
    # Reading recs[-1] blindly therefore inspects a `system` record and
    # concludes the session ended cleanly, which is how a genuinely crashed
    # session went unreported.
    for r in reversed(recs):
        role = (r.get("message") or {}).get("role")
        if role in ("user", "assistant"):
            return role == "user"
    return False


def marker_epoch(store, pattern):
    """When a close-marker hook started working for this store, or None.

    `cg-session-end` gives Claude Code the marker it otherwise lacks, but only
    from the moment it was installed -- every transcript written before that
    also has no marker, so absence cannot mean "crashed" for those.

    Rather than trusting a settings-file mtime (which changes on any unrelated
    edit), calibrate from the data: the oldest transcript that *does* carry a
    marker is proof the hook was live by then. After that point, a missing
    marker is evidence; before it, it is silence.
    """
    oldest = None
    base = os.path.expanduser(store)
    if not os.path.isdir(base):
        return None
    for root, _dirs, files in os.walk(base):
        for fn in files:
            if not re.match(pattern, fn):
                continue
            p = os.path.join(root, fn)
            last, _ = tail_json(p, probe=2)
            if last is None or last.get("customType") != "session_exit":
                continue
            try:
                mtime = os.path.getmtime(p)
            except OSError:
                continue
            if oldest is None or mtime < oldest:
                oldest = mtime
    return oldest


# ── harness registry ────────────────────────────────────────────────────
#
# Adding a harness should be a row, not a function. A store that does not exist
# is skipped silently, so a harness can be registered before it is installed --
# `omx` below is listed for exactly that reason and starts working the day its
# directory appears.

# Forks of the pi/omp core: `<store>/<cwd-slug>/<ts>_<uuid>.jsonl`, `cwd` on the
# `session` record, and `custom/session_exit` as the close marker where the fork
# is new enough to write one. Older forks simply never match the marker and fall
# through to the mtime cutoff, which is the same treatment legacy `~/.pi` gets.
PI_FAMILY = (
    ("omp", "~/.omp/agent/sessions", "omp -r {short}"),
    ("ante", "~/.ante/sessions", "ante -r {short}"),
    ("omx", "~/.omx/agent/sessions", "omx -r {short}"),
)

# One JSON document per session rather than a JSONL transcript. These carry no
# close marker at all, so they are judged purely on the mtime cutoff -- the
# unfinished-turn test needs a record stream to look at, and there isn't one.
#   (harness, glob, cwd field, id field, resume template)
JSON_SESSION_STORES = (
    ("jcode", "~/.jcode/sessions/session_*.json",
     "working_dir", "id", "jcode --resume {id}"),
    ("agy", "~/.gemini/tmp/*/chats/session-*.json",
     None, "sessionId", "agy --resume {id}"),
)


# ── per-harness scanners ────────────────────────────────────────────────

def scan_omp(cutoff, store, harness, resume_fmt="omp -r {short}"):
    """Definitive: final record is `custom/session_exit`, or the session was open.

    Only `<cwd-slug>/<ts>_<uuid>.jsonl` is a session. The store also holds
    `<cwd-slug>/<ts>_<uuid>/<AgentName>.jsonl` — transcripts of subagents the
    session spawned. Those never carry a `session_exit` of their own, so counting
    them would report every worker a session ever launched as a window open at
    the crash. They are attributed to the parent instead.
    """
    out = []
    base = os.path.expanduser(store)
    if not os.path.isdir(base):
        return out
    for root, _dirs, files in os.walk(base):
        depth = os.path.relpath(root, base).count(os.sep)
        if depth != 0:
            continue  # deeper than <cwd-slug>/ is a subagent directory
        for fn in files:
            if not fn.endswith(".jsonl"):
                continue
            p = os.path.join(root, fn)
            try:
                mtime = os.path.getmtime(p)
            except OSError:
                continue
            last, _ = tail_json(p, probe=2)
            if last is None:
                continue
            if last.get("customType") == "session_exit" or mtime < cutoff:
                continue
            first_u, last_u = first_last_user_text(p)
            sid = fn.split("_", 1)[-1].replace(".jsonl", "")
            subs = 0
            sub_dir = os.path.join(root, fn[:-6])
            if os.path.isdir(sub_dir):
                subs = len([x for x in os.listdir(sub_dir) if x.endswith(".jsonl")])
            out.append({
                "harness": harness, "session": sid, "path": p,
                "cwd": recorded_cwd(p) or "", "last_write": mtime,
                "evidence": "no session_exit record (definitive)"
                            + (f"; spawned {subs} subagent(s)" if subs else ""),
                "confidence": "definitive",
                "first_user": first_u, "last_user": last_u,
                "resume": resume_fmt.format(short=sid.split("-")[0], id=sid),
            })
    return out


def scan_json_sessions(cutoff, harness, pattern, cwd_field, id_field, resume_fmt):
    """A store that keeps one JSON document per session instead of a transcript.

    There is no close marker and no record stream, so the only evidence is the
    file's mtime against the boot cutoff. That is one signal, not two, so these
    are reported as heuristic and will over-report a session that was closed
    cleanly and simply never touched again.
    """
    out = []
    for p in glob.glob(os.path.expanduser(pattern)):
        try:
            mtime = os.path.getmtime(p)
        except OSError:
            continue
        if mtime < cutoff:
            continue
        try:
            with open(p, encoding="utf-8", errors="ignore") as fh:
                doc = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(doc, dict):
            continue
        sid = str(doc.get(id_field) or os.path.basename(p).rsplit(".", 1)[0])
        cwd = doc.get(cwd_field) if cwd_field else None
        # Messages are stored inline here; take the first and last human turn
        # for the same "which window was this" identification the others get.
        first_u = last_u = None
        msgs = doc.get("messages")
        if isinstance(msgs, list):
            for msg in msgs:
                if not isinstance(msg, dict) or msg.get("role") != "user":
                    continue
                c = msg.get("content")
                if isinstance(c, list):
                    c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                if not isinstance(c, str) or len(c.strip()) < 8:
                    continue
                t = " ".join(c.split())[:400]
                if first_u is None:
                    first_u = t
                last_u = t
        out.append({
            "harness": harness, "session": sid, "path": p,
            "cwd": cwd if isinstance(cwd, str) and cwd.startswith("/") else "",
            "last_write": mtime,
            "evidence": "no close marker in this format; mtime in pre-boot gap",
            "confidence": "heuristic",
            "first_user": first_u, "last_user": last_u,
            "resume": resume_fmt.format(id=sid),
        })
    return out


def scan_pi(cutoff):
    """Legacy store: the marker does not exist here, so heuristic only."""
    out = []
    base = os.path.expanduser("~/.pi/agent/sessions")
    if not os.path.isdir(base):
        return out
    for root, _dirs, files in os.walk(base):
        for fn in files:
            if not fn.endswith(".jsonl"):
                continue
            p = os.path.join(root, fn)
            try:
                mtime = os.path.getmtime(p)
            except OSError:
                continue
            if mtime < cutoff:
                continue
            _, recs = tail_json(p)
            first_u, last_u = first_last_user_text(p)
            out.append({
                "harness": "pi (legacy)", "session": fn.replace(".jsonl", ""),
                "path": p, "cwd": os.path.basename(root), "last_write": mtime,
                "evidence": "store predates session_exit; mtime in pre-boot gap",
                "confidence": "heuristic",
                "first_user": first_u, "last_user": last_u,
                "resume": f"pi -r {fn.split('_', 1)[-1].replace('.jsonl','').split('-')[0]}",
            })
    return out


def scan_hermes(cutoff, all_open=False):
    """Definitive: `ended_at IS NULL` means the session never closed."""
    out = []
    p = os.path.expanduser("~/.hermes/state.db")
    if not os.path.exists(p):
        return out
    # `cwd` and `last_activity_at` are later additions to this table; a column
    # this tool wants but an older db lacks should degrade the output, not
    # empty it, so fall back to the columns that have always been there.
    cols = "id, model, started_at, message_count, cwd, last_activity_at"
    try:
        db = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
        try:
            rows = db.execute(
                f"SELECT {cols} FROM sessions "
                "WHERE ended_at IS NULL AND id NOT LIKE 'cron_%' ORDER BY started_at DESC"
            ).fetchall()
        except sqlite3.OperationalError:
            rows = [r + (None, None) for r in db.execute(
                "SELECT id, model, started_at, message_count FROM sessions "
                "WHERE ended_at IS NULL AND id NOT LIKE 'cron_%' ORDER BY started_at DESC"
            ).fetchall()]
    except sqlite3.Error:
        return out
    for sid, model, started, count, cwd, last_act in rows:
        # A session cannot have been open at a boot it began after. `ended_at`
        # is null by definition here, so last_activity_at is the closest thing
        # to a last-write time; started_at is the floor when even that is unset.
        when = last_act or started or 0
        if not all_open and when < cutoff - 30 * 86400:
            continue
        out.append({
            "harness": "hermes", "session": sid, "path": p,
            "cwd": cwd or "", "last_write": when,
            "evidence": "ended_at IS NULL, no end_reason (definitive)",
            "confidence": "definitive",
            "first_user": f"model={model} messages={count}", "last_user": None,
            "resume": f"hermes --resume {sid}",
        })
    return out


def scan_transcript_only(cutoff, store, harness, pattern, resume_fmt):
    """claude / codex: no terminal record, so require two agreeing signals
    -- unless a close-marker hook is live, in which case absence is proof."""
    out = []
    marker_since = marker_epoch(store, pattern)
    base = os.path.expanduser(store)
    if not os.path.isdir(base):
        return out
    for root, _dirs, files in os.walk(base):
        for fn in files:
            if not re.match(pattern, fn):
                continue
            p = os.path.join(root, fn)
            try:
                mtime = os.path.getmtime(p)
            except OSError:
                continue
            if mtime < cutoff:
                continue
            last, recs = tail_json(p)
            # `cg-session-end` (installed as a Claude SessionEnd hook) appends
            # omp's marker on clean exit. Its presence is definitive; its
            # absence is not, because every transcript written before the hook
            # existed also lacks it. So the marker can only ever rule a session
            # out, never in -- absence still has to earn its verdict below.
            if last is not None and last.get("customType") == "session_exit":
                continue
            # Once a close-marker hook is live for this store, a session
            # written after it with no marker did not close cleanly -- that is
            # a fact, not a heuristic, and it does not depend on guessing
            # whether the final turn looks finished.
            definitive = marker_since is not None and mtime > marker_since
            if not definitive and not unfinished_turn(recs):
                continue  # stopped cleanly between turns — not evidence of a crash
            first_u, last_u = first_last_user_text(p)
            sid = re.sub(r"\.jsonl$", "", fn)
            out.append({
                "harness": harness, "session": sid, "path": p,
                "cwd": recorded_cwd(p, n=40) or "", "last_write": mtime,
                "evidence": ("no session_exit since the hook went live (definitive)"
                             if definitive else
                             "unfinished turn + write in pre-boot gap (2 signals)"),
                "confidence": "definitive" if definitive else "heuristic",
                "first_user": first_u, "last_user": last_u,
                "resume": resume_fmt.format(id=sid, path=p),
            })
    return out


def collect(cutoff, all_open=False):
    found = []
    for harness, store, resume in PI_FAMILY:
        found += scan_omp(cutoff, store, harness, resume)
    for harness, pattern, cwd_f, id_f, resume in JSON_SESSION_STORES:
        found += scan_json_sessions(cutoff, harness, pattern, cwd_f, id_f, resume)
    found += scan_pi(cutoff)
    found += scan_hermes(cutoff, all_open)
    found += scan_transcript_only(
        cutoff, "~/.claude/projects", "claude code", r"^[0-9a-f-]{36}\.jsonl$",
        "claude --resume {id}")
    found += scan_transcript_only(
        cutoff, "~/.codex/sessions", "codex", r"^rollout-.*\.jsonl$",
        "codex resume {id}")
    # qwen writes claude's schema exactly -- uuid/parentUuid/sessionId/cwd/message
    # per record -- so the same scanner reads it with no format work at all.
    found += scan_transcript_only(
        cutoff, "~/.qwen/projects", "qwen", r"^[0-9a-f-]{36}\.jsonl$",
        "qwen --resume {id}")
    found.sort(key=lambda r: -(r["last_write"] or 0))
    attach_sentinels(found, load_sentinels())
    return found


# ── sentinels ───────────────────────────────────────────────────────────

SENTINEL_DIRS = ("~/.local/share/crash-guard/live",
                 "~/.local/share/crash-guard/archive")


def load_sentinels():
    """Launch records written by `cg_run`, indexed by working directory.

    Markers and sentinels answer different questions, which is why both exist.
    A marker says *which* sessions were open -- completely, for anything the
    harness wrote, with no instrumentation. A sentinel says *how* one was
    launched: the argv including any wrapper (`rtk hermes`), and the
    proxy-routing env the alias injected (`OPENAI_BASE_URL=...`).

    Neither substitutes for the other. Resuming `hermes --resume <id>` without
    that env reconnects to a different backend than the session was talking to,
    and drops the wrapper's output filtering -- so the session comes back, but
    not the session you had.
    """
    out = {}
    for d in SENTINEL_DIRS:
        base = os.path.expanduser(d)
        if not os.path.isdir(base):
            continue
        for fn in os.listdir(base):
            if not fn.endswith(".json"):
                continue
            try:
                with open(os.path.join(base, fn), encoding="utf-8") as fh:
                    rec = json.load(fh)
            except (OSError, ValueError):
                continue
            cwd = rec.get("cwd")
            if cwd:
                out.setdefault(cwd, []).append(rec)
    return out


def attach_sentinels(found, sentinels):
    """Enrich each detected session with its launch record, where one exists.

    Matched on working directory, then on the harness name appearing in the
    sentinel's argv or wrapper key -- a directory can hold sessions from
    several harnesses, and relaunching one with another's command line would
    be worse than having no sentinel at all.
    """
    for r in found:
        cwd = r.get("cwd")
        if not cwd:
            continue
        harness = (r.get("harness") or "").split()[0].lower()
        for rec in sentinels.get(cwd, []):
            hay = " ".join(rec.get("argv") or []) + " " + str(rec.get("key") or "")
            if harness and harness not in hay.lower():
                continue
            r["launch_argv"] = rec.get("argv")
            r["launch_env"] = rec.get("env") or {}
            r["launch_key"] = rec.get("key")
            break
    return found


# ── restoring ───────────────────────────────────────────────────────────

TMUX_SESSION = "recovered"


def launch_command(r):
    """The shell line that reopens one session where it was running.

    When a sentinel matched, its env prefix is replayed so the session
    reconnects through the same proxy chain it was using; without it the
    harness would come back pointed at its default backend.

    `exec $SHELL` keeps the pane alive after the harness exits, so a session
    that fails to resume leaves its error on screen instead of closing the
    window before it can be read.
    """
    cwd = r.get("cwd") or HOME
    prefix = ""
    env = r.get("launch_env") or {}
    if env:
        # The proxy stack may not be running yet after a reboot; the shell
        # function is defined by the user's rc file and is a no-op elsewhere.
        prefix = ("command -v _proxy_stack_auto_start >/dev/null 2>&1 && "
                  "_proxy_stack_auto_start; ")
        prefix += " ".join(f"{k}={shlex.quote(str(v))}" for k, v in env.items()) + " "
    return f"cd {shlex.quote(cwd)} && {prefix}{r['resume']}; exec $SHELL"


def restore(found, assume_yes=False):
    """Reopen chosen sessions, each in its own tmux window in its own directory.

    tmux rather than terminal windows: it works the same over SSH and inside
    WSL where there may be no usable X display, it survives the terminal that
    launched it, and it puts every recovered session in one place to attach to.
    """
    if not found:
        print("nothing to restore")
        return 0
    if not shutil.which("tmux"):
        print("tmux is not installed; run these by hand:\n")
        for r in found:
            print(f"  ({r['harness']})  {launch_command(r).rsplit(';', 1)[0]}")
        return 1

    chosen = found
    if not assume_yes:
        ts = lambda e: dt.datetime.fromtimestamp(e).strftime("%m-%d %H:%M") if e else "?"
        print(f"\n  {len(found)} session(s) open at shutdown\n")
        for i, r in enumerate(found, 1):
            print(f"  [{i}] {r['harness']:11s} {ts(r['last_write'])}  {r.get('cwd') or '?'}")
            hint = r.get("last_user") or r.get("first_user") or ""
            if hint:
                print(f"      {hint[:88]}")
        print()
        try:
            sel = input("  restore which? (1-%d, a=all, q=quit) " % len(found)).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 1
        if not sel or sel.lower().startswith("q"):
            return 1
        if not sel.lower().startswith("a"):
            picked = []
            for tok in re.split(r"[,\s]+", sel):
                if tok.isdigit() and 1 <= int(tok) <= len(found):
                    picked.append(found[int(tok) - 1])
            if not picked:
                print("  nothing selected")
                return 1
            chosen = picked

    existing = subprocess.run(["tmux", "has-session", "-t", TMUX_SESSION],
                              capture_output=True).returncode == 0
    for r in chosen:
        cwd = r.get("cwd") or HOME
        if not os.path.isdir(cwd):
            print(f"  !! {r['harness']} {r['session'][:12]}: {cwd} no longer exists, "
                  f"opening in $HOME")
            cwd = HOME
        name = f"{r['harness'].split()[0]}-{r['session'][:8]}"
        cmd = launch_command({**r, "cwd": cwd})
        if not existing:
            subprocess.run(["tmux", "new-session", "-d", "-s", TMUX_SESSION,
                            "-n", name, "-c", cwd, cmd])
            existing = True
        else:
            subprocess.run(["tmux", "new-window", "-t", TMUX_SESSION,
                            "-n", name, "-c", cwd, cmd])
        print(f"  -> {r['harness']:11s} {r['session'][:12]}  in {cwd}")

    # Attach, rather than printing a third command to type. Restoring sessions
    # and then leaving the user outside the tmux session holding them is the
    # same mistake as printing a list and naming another command to act on it.
    if os.environ.get("TMUX"):
        # Already inside tmux -- attaching would nest. Switch instead.
        print(f"\n  restored into tmux session '{TMUX_SESSION}'")
        subprocess.call(["tmux", "switch-client", "-t", TMUX_SESSION])
        return 0
    if not sys.stdout.isatty():
        print(f"\n  attach with:  tmux attach -t {TMUX_SESSION}")
        return 0
    print(f"\n  attaching to '{TMUX_SESSION}' -- detach with ctrl-b d")
    os.execvp("tmux", ["tmux", "attach", "-t", TMUX_SESSION])
    return 0


def render_history(found, boots, top=12):
    """Group never-closed sessions by the boot boundary that ended them.

    A session that was never closed died at the first boot *after* its last
    write. Sessions older than the wtmp window all attribute to its earliest
    entry, which is an artefact of where the log starts rather than a single
    catastrophic crash, so that bucket is labelled instead of ranked.
    """
    if not boots:
        print("cg-recover: no boot history available (`last reboot` returned nothing)")
        return
    ts = lambda e: dt.datetime.fromtimestamp(e).strftime("%Y-%m-%d %H:%M")
    buckets, undated = {}, []
    for r in found:
        w = r.get("last_write") or 0
        after = [b for b in boots if b > w]
        (buckets.setdefault(after[0], []).append(r) if after else undated.append(r))

    print(f"{len(boots)} boot boundaries, {ts(boots[0])} -> {ts(boots[-1])}")
    print(f"{len(found)} never-closed session(s); "
          f"{sum(len(v) for v in buckets.values())} attributable, "
          f"{len(undated)} still open since the last boot\n")

    ordered = sorted(buckets.items(), key=lambda kv: -len(kv[1]))
    for b, rs in ordered[:top]:
        tag = "  (everything older than the log -- not one crash)" if b == boots[0] else ""
        print(f"  {ts(b)}  {len(rs):>3} session(s){tag}")
        if b == boots[0]:
            continue
        for r in sorted(rs, key=lambda r: -(r.get("last_write") or 0))[:6]:
            print(f"      {r['harness']:<12} {r.get('cwd') or '?'}")
            hint = r.get("last_user") or r.get("first_user")
            if hint:
                print(f"        last: {hint[:88]}")
        print()


def render(found, boot, cutoff, show_resume):
    ts = lambda e: dt.datetime.fromtimestamp(e).strftime("%Y-%m-%d %H:%M") if e else "?"
    print(f"boot {ts(boot)} · looking for sessions last written before it\n")
    if not found:
        print("  no sessions appear to have been open at the last shutdown")
        return
    definitive = [r for r in found if r["confidence"] == "definitive"]
    print(f"  {len(found)} session(s) open at shutdown "
          f"({len(definitive)} definitive, {len(found)-len(definitive)} heuristic)\n")
    for r in found:
        mark = "!!" if r["confidence"] == "definitive" else " ?"
        print(f"  {mark} {r['harness']:12s} {ts(r['last_write'])}  {r['session'][:38]}")
        if r["cwd"]:
            print(f"       cwd     {r['cwd']}")
        print(f"       why     {r['evidence']}")
        if r.get("first_user"):
            print(f"       opened  {r['first_user'][:96]}")
        if r.get("last_user"):
            print(f"       last    {r['last_user'][:96]}")
        if r.get("launch_env") or r.get("launch_argv"):
            env = r.get("launch_env") or {}
            detail = ", ".join(sorted(env)) if env else (r.get("launch_key") or "")
            print(f"       launch  sentinel matched -- will replay {detail}")
        if show_resume:
            print(f"       resume  {r['resume']}")
        print()


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--since", help="ISO timestamp; default is the current boot")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--resume", action="store_true", help="print resume commands only")
    ap.add_argument("--restore", action="store_true",
                    help="reopen sessions in tmux, each in its recorded directory")
    ap.add_argument("--yes", action="store_true",
                    help="with --restore, reopen everything without asking")
    ap.add_argument("--all-open", action="store_true",
                    help="every never-closed session, not just the last crash")
    ap.add_argument("--history", action="store_true",
                    help="group every never-closed session by the boot that ended it")
    args = ap.parse_args()

    boot = boot_time()
    if args.since:
        try:
            cutoff = dt.datetime.fromisoformat(args.since).timestamp()
        except ValueError:
            sys.stderr.write(f"cg-recover: cannot parse --since {args.since!r}\n")
            return 2
    else:
        cutoff = 0 if args.all_open else boot - 7 * 86400

    found = collect(cutoff if not args.all_open else 0, args.all_open)
    if not args.all_open:
        found = [r for r in found if (r["last_write"] or 0) < boot]

    if args.history:
        render_history(collect(0, all_open=True), boot_history())
        return 0
    if args.restore:
        return restore(found, assume_yes=args.yes)
    if args.json:
        print(json.dumps(found, indent=1))
    elif args.resume:
        for r in found:
            print(r["resume"])
    else:
        render(found, boot, cutoff, show_resume=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
